/* FOPEN */
pf142: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return mkint(-1)
  fname = cstr[fv[base + 1]]
  if fileexists(fname) = 0 then return mkint(-1)
  md = 0
  if n >= 2 then md = iarg(fv[base + 2], 0) % 4
  return mkint(newhandle(fname, bytesof(fname), md))
  return 0

/* FCREATE */
pf143: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return mkint(-1)
  h = newhandle(cstr[fv[base + 1]], '', 1)
  fhdirty[h - 2] = 1
  junk = putbytes(cstr[fv[base + 1]], '')
  return mkint(h)
  return 0

/* FCLOSE */
pf144: procedure = .int
  arg base = .int, n = .int
  return mklog(fclosehandle(iarg(fv[base + 1], 0)))
  return 0

/* FWRITE */
pf145: procedure = .int
  arg base = .int, n = .int
  i = iarg(fv[base + 1], 0) - 2
  if i < 1 | i > nfh then return mkint(-1)
  if isstr(fv[base + 2]) = 0 then return mkint(0)
  s = cstr[fv[base + 2]]
  if n >= 3 then do
    k = iarg(fv[base + 3], length(s))
    if k < length(s) then s = left(s, k)
  end
  p = fhpos[i]
  d = fhdata[i]
  if p > length(d) then d = d || copies('00'x, p - length(d))
  fhdata[i] = left(d, p) || s || substr(d, p + length(s) + 1)
  fhpos[i] = p + length(s)
  fhdirty[i] = 1
  return mkint(length(s))
  return 0

/* FREAD */
pf146: procedure = .int
  arg base = .int, n = .int
  i = iarg(fv[base + 1], 0) - 2
  if i < 1 | i > nfh then return mkint(0)
  k = iarg(fv[base + 3], 0)
  p = fhpos[i]
  s = substr(fhdata[i], p + 1, k)
  fhpos[i] = p + length(s)
  r = fv[base + 2]
  if r > 2 then do
    if ctag[r] = 9 then ca1[r] = mkstr(s)
  end
  return mkint(length(s))
  return 0

/* FREADSTR */
pf147: procedure = .int
  arg base = .int, n = .int
  i = iarg(fv[base + 1], 0) - 2
  if i < 1 | i > nfh then return mkstr('')
  k = iarg(fv[base + 2], 0)
  p = fhpos[i]
  s = substr(fhdata[i], p + 1, k)
  fhpos[i] = p + length(s)
  return mkstr(s)
  return 0

/* FSEEK */
pf148: procedure = .int
  arg base = .int, n = .int
  i = iarg(fv[base + 1], 0) - 2
  if i < 1 | i > nfh then return mkint(-1)
  off = iarg(fv[base + 2], 0)
  org = 0
  if n >= 3 then org = iarg(fv[base + 3], 0)
  if org = 0 then p = off
  else if org = 1 then p = fhpos[i] + off
  else p = length(fhdata[i]) + off
  if p < 0 then p = 0
  fhpos[i] = p
  return mkint(p)
  return 0

/* HB_FEOF */
pf149: procedure = .int
  arg base = .int, n = .int
  i = iarg(fv[base + 1], 0) - 2
  if i < 1 | i > nfh then return 2
  if fhpos[i] >= length(fhdata[i]) then return 2
  return 1
  return 0

