  return 0
  return 0

/* DBUSEAREA */
pf179: procedure = .int
  arg base = .int, n = .int
  /* DbUseArea( [lNew], [cDriver], cFile, [cAlias], [lShared], [lReadOnly] ) */
  newf = 0
  if n >= 1 then do
    if islog(fv[base + 1]) = 1 then newf = fv[base + 1] - 1
  end
  if n < 3 then do
    if curarea > 0 then call closearea curarea
    return 0
  end
  f = sarg(fv[base + 3])
  if newf = 1 | curarea < 1 then a = findfreearea()
  else a = curarea
  if a = 0 then return rterr('DBFNTX', 1001, 'No free work area', f)
  if wa_used[a] = 1 then call closearea a
  al = ''
  if n >= 4 then do
    if isstr(fv[base + 4]) = 1 then al = upper(strip(cstr[fv[base + 4]]))
  end
  if al == '' then al = dbfstem(f)
  ro = 0
  if n >= 6 then do
    if fv[base + 6] = 2 then ro = 1
  end
  if openarea(a, f, al, ro) = 0 then return 0
  curarea = a
  return 0
  return 0

/* DBCLOSEAREA */
pf180: procedure = .int
  arg base = .int, n = .int
  if curarea > 0 then call closearea curarea
  return 0
  return 0

/* DBCLOSEALL */
pf181: procedure = .int
  arg base = .int, n = .int
  call closeallareas
  curarea = 0
  return 0
  return 0

/* DBCREATE */
pf182: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 2]) = 0 then return argerr('DBCREATE')
  junk = createdbf(sarg(fv[base + 1]), fv[base + 2])
  return 0
  return 0

/* DBSTRUCT */
pf183: procedure = .int
  arg base = .int, n = .int
  a = curarea
  if a < 1 then return mkarray(0)
  r = mkarray(0)
  do i = 1 to wa_nfld[a]
    e = mkarray(0)
    call arrpush e, mkstr(fnam[(a - 1) * 256 + i])
    call arrpush e, mkstr(ftyp[(a - 1) * 256 + i])
    call arrpush e, mkint(flen[(a - 1) * 256 + i])
    call arrpush e, mkint(fdec[(a - 1) * 256 + i])
    call arrpush r, e
  end
  return r
  return 0

/* DBAPPEND */
pf184: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbappend curarea
  return 0
  return 0

/* DBDELETE */
pf185: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbdelete curarea, 1
  return 0
  return 0

/* DBRECALL */
pf186: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbdelete curarea, 0
  return 0
  return 0

/* DBSKIP */
pf187: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbskip curarea, iarg(fv[base + 1], 1)
  return 0
  return 0

/* DBGOTO */
pf188: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbgoto curarea, iarg(fv[base + 1], 0)
  return 0
  return 0

/* DBGOTOP */
pf189: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbgotop curarea
  return 0
  return 0

/* DBGOBOTTOM */
pf190: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbgobottom curarea
  return 0
  return 0

/* DBSEEK */
pf191: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  soft = 0
  if n >= 2 then do
    if fv[base + 2] = 2 then soft = 1
  end
  return mklog(dbseek(curarea, fv[base + 1], soft))
  return 0

/* DBPACK */
pf192: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbpack curarea
  return 0
  return 0

/* DBZAP */
pf193: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call dbzap curarea
  return 0
  return 0

/* DBSETFILTER */
pf194: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  wa_filter[curarea] = 0
  if n = 2 then do
    if isstr(fv[base + 2]) = 1 then wa_filter[curarea] = compileexpr(cstr[fv[base + 2]])
  end
  return 0
  return 0

/* DBCLEARFILTER */
pf195: procedure = .int
  arg base = .int, n = .int
  if curarea > 0 then wa_filter[curarea] = 0
  return 0
  return 0

/* DBFILTER */
pf196: procedure = .int
  arg base = .int, n = .int
  return mkstr('')
  return 0

/* DBCREATEINDEX ORDCREATE */
pf197: procedure = .int
  arg base = .int, n = .int
  /* DbCreateIndex( cFile, cKey, [bKey], [lUnique] ) : cKey is compiled from text */
  if curarea < 1 then return noarea()
  kt = sarg(fv[base + 2])
  if n = 5 then kt = sarg(fv[base + 2])
  nd2 = compileexpr(kt)
  if nd2 = 0 then return rterr('DBFNTX', 1004, 'Index key error', kt)
  fl = 0
  if n >= 4 then do
    if fv[base + 4] = 2 then fl = 1
  end
  junk = createindex(curarea, nd2, sarg(fv[base + 1]), 0, fl, kt, '')
  return 0
  return 0

/* DBSETINDEX ORDLISTADD */
pf198: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  junk = openindex(curarea, sarg(fv[base + 1]))
  return 0
  return 0

/* DBREINDEX ORDLISTREBUILD */
pf199: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  call reindexall curarea
  return 0
  return 0

/* ORDLISTCLEAR DBCLEARINDEX */
pf200: procedure = .int
  arg base = .int, n = .int
  if curarea > 0 then do
    wa_nix[curarea] = 0
    wa_order[curarea] = 0
  end
  return 0
  return 0

/* DBSETORDER ORDSETFOCUS */
pf201: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return mkint(0)
  a = curarea
  old = 0
  do j = 1 to wa_nix[a]
    if waix[(a - 1) * 8 + j] = wa_order[a] then old = j
  end
  if n >= 1 then do
    k = -1
    if isnum(fv[base + 1]) = 1 then k = iarg(fv[base + 1], 0)
    else if isstr(fv[base + 1]) = 1 then do
      u = upper(strip(cstr[fv[base + 1]]))
      k = 0
      do j = 1 to wa_nix[a]
        if ix_name[waix[(a - 1) * 8 + j]] == u then k = j
      end
    end
    if k >= 0 & k <= wa_nix[a] then do
      if k = 0 then wa_order[a] = 0
      else wa_order[a] = waix[(a - 1) * 8 + k]
      call dbgotop a
    end
  end
  return mkint(old)
  return 0

/* INDEXORD */
pf202: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return mkint(0)
  a = curarea
  do j = 1 to wa_nix[a]
    if waix[(a - 1) * 8 + j] = wa_order[a] then return mkint(j)
  end
  return mkint(0)
  return 0

/* INDEXKEY ORDKEY */
pf203: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return mkstr('')
  a = curarea
  if wa_order[a] = 0 then return mkstr('')
  return mkstr(ix_text[wa_order[a]])
  return 0

/* ORDNAME */
pf204: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return mkstr('')
  a = curarea
  k = iarg(fv[base + 1], 0)
  if n = 0 then do
    if wa_order[a] = 0 then return mkstr('')
    return mkstr(ix_name[wa_order[a]])
  end
  if k < 1 | k > wa_nix[a] then return mkstr('')
  return mkstr(ix_name[waix[(a - 1) * 8 + k]])
  return 0

/* ORDCOUNT */
pf205: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return mkint(0)
  return mkint(wa_nix[curarea])
  return 0

/* DBEVAL */
pf206: procedure = .int
  arg base = .int, n = .int
  /* DbEval( bBlock, [bFor], [bWhile], [nNext], [nRecord], [lRest] ) */
  if curarea < 1 then return noarea()
  a = curarea
  nxt = -1
  if n >= 4 then do
    if isnum(fv[base + 4]) = 1 then nxt = iarg(fv[base + 4], -1)
  end
  if n >= 5 then do
    if isnum(fv[base + 5]) = 1 then do
      call dbgoto a, iarg(fv[base + 5], 0)
      nxt = 1
    end
  end
  rest = 0
  if n >= 6 then do
    if fv[base + 6] = 2 then rest = 1
  end
  if nxt = -1 & rest = 0 & n < 5 then call dbgotop a
  do while wa_eof[a] = 0 & nxt <> 0
    if n >= 3 then do
      if fv[base + 3] > 2 then do
        if evalblock0(fv[base + 3]) <> 2 then leave
      end
    end
    ok = 1
    if n >= 2 then do
      if fv[base + 2] > 2 then do
        if evalblock0(fv[base + 2]) <> 2 then ok = 0
      end
    end
    if ok = 1 then junk = evalblock0(fv[base + 1])
    if ctl <> 0 then return 0
    if nxt > 0 then nxt = nxt - 1
    if n >= 5 then leave
    call dbskip a, 1
  end
  return 0
  return 0

/* HB_DBPACK */
pf207: procedure = .int
  arg base = .int, n = .int
  if curarea > 0 then call dbpack curarea
  return 0
  return 0

/* LUPDATE */
pf208: procedure = .int
  arg base = .int, n = .int
  return mkdate(ymd2jdn(substr(date('S'), 1, 4) as .int, substr(date('S'), 5, 2) as .int, substr(date('S'), 7, 2) as .int))
  return 0

/* HEADER */
pf209: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return mkint(0)
  return mkint(wa_hdr[curarea])
  return 0

/* RECSIZE */
pf210: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return mkint(0)
  return mkint(wa_reclen[curarea])
  return 0

/* DBINFO DBORDERINFO DBRECORDINFO DBFIELDINFO */
pf211: procedure = .int
  arg base = .int, n = .int
  return 0
  return 0

/* DBRELATION DBRSELECT */
pf212: procedure = .int
  arg base = .int, n = .int
  return mkstr('')
  return 0

/* DBSETRELATION */
pf213: procedure = .int
  arg base = .int, n = .int
  if curarea < 1 then return noarea()
  a = curarea
  k = areaarg(fv[base + 1])
  if k < 1 then return 0
  if isstr(fv[base + 2]) = 0 then return 0
  nd2 = compileexpr(cstr[fv[base + 2]])
  wa_nrel[a] = wa_nrel[a] + 1
  wa_relchild[(a - 1) * 8 + wa_nrel[a]] = k
  wa_relkey[(a - 1) * 8 + wa_nrel[a]] = nd2
  call relsync a
  return 0
  return 0

/* DBCLEARRELATION */
pf214: procedure = .int
  arg base = .int, n = .int
  if curarea > 0 then wa_nrel[curarea] = 0
  return 0
  return 0

