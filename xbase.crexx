callprim: procedure = .int
  arg id = .int, base = .int, n = .int
  g = (id - 1) / 30
  if g = 0 then return primg0(id, base, n)
  if g = 1 then return primg1(id, base, n)
  if g = 2 then return primg2(id, base, n)
  if g = 3 then return primg3(id, base, n)
  if g = 4 then return primg4(id, base, n)
  if g = 5 then return primg5(id, base, n)
  if g = 6 then return primg6(id, base, n)
  if g = 7 then return primg7(id, base, n)
  return 0

initprims: procedure = .void
  call registerprim 'LEN', 1, 1, 1
  call registerprim 'EMPTY', 2, 1, 1
  call registerprim 'VALTYPE', 3, 1, 1
  call registerprim 'STR', 4, 1, 3
  call registerprim 'STRZERO', 5, 1, 3
