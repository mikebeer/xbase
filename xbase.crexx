/* CDOW */
pf68: procedure = .int
  arg base = .int, n = .int
  if isdate(fv[base + 1]) = 0 then return argerr('CDOW')
  if cint[fv[base + 1]] = 0 then return mkstr('')
  k = (cint[fv[base + 1]] + 1) % 7 + 1
  return mkstr(word('Sunday Monday Tuesday Wednesday Thursday Friday Saturday', k))
  return 0

