/* ALERT */
pf139: procedure = .int
  arg base = .int, n = .int
  msg = vtostr(fv[base + 1])
  call flushout
  if outcol > 0 then call emitnl
  call emit msg
  call emitnl
  opts = ''
  if n >= 2 then do
    if isarr(fv[base + 2]) = 1 then do
      do i = 1 to arrlen(fv[base + 2])
        if i > 1 then opts = opts || '  '
        opts = opts || '[' || i || '] ' || vtostr(arrget(fv[base + 2], i))
      end
    end
  end
  if opts <> '' then do
    call emit opts
    call emitnl
    s = readcon()
    k = 1
    if ineof = 0 & strip(s) <> '' then do
      if isdigitc(left(strip(s), 1)) = 1 then k = strip(s) as .int
      else do
        u = upper(left(strip(s), 1))
        do i = 1 to arrlen(fv[base + 2])
          if upper(left(vtostr(arrget(fv[base + 2], i)), 1)) == u then do
            k = i
            leave
          end
        end
      end
    end
    return mkint(k)
  end
  return mkint(1)
  return 0

/* SET */
pf140: procedure = .int
  arg base = .int, n = .int
  k = iarg(fv[base + 1], 0)
  old = 0
  if k = 1 then do
    old = mklog(setexact)
    if n >= 2 then setexact = truthy(fv[base + 2])
  end
  else if k = 2 then do
    old = mklog(setfixed)
    if n >= 2 then setfixed = truthy(fv[base + 2])
  end
  else if k = 3 then do
    old = mkint(setdec)
    if n >= 2 then setdec = iarg(fv[base + 2], 2)
  end
  else if k = 4 then do
    old = mkstr(setdatefmt)
    if n >= 2 then call setdate cstr[fv[base + 2]]
  end
  else if k = 5 then do
    old = mkint(setepoch)
    if n >= 2 then setepoch = iarg(fv[base + 2], 1900)
  end
  else if k = 9 then do
    old = mklog(setsoft)
    if n >= 2 then setsoft = truthy(fv[base + 2])
  end
  else if k = 11 then do
    old = mklog(setdeleted)
    if n >= 2 then setdeleted = truthy(fv[base + 2])
  end
  else if k = 17 then do
    old = mklog(setconsole)
    if n >= 2 then setconsole = truthy(fv[base + 2])
  end
  return old
  return 0

