/* HB_STRREPLACE */
pf120: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('HB_STRREPLACE')
  t = cstr[fv[base + 1]]
  if n >= 3 & isstr(fv[base + 2]) = 1 & isstr(fv[base + 3]) = 1 then do
    r = ''
    do i = 1 to length(t)
      ch = substr(t, i, 1)
      k = pos(ch, cstr[fv[base + 2]])
      if k > 0 & k <= length(cstr[fv[base + 3]]) then ch = substr(cstr[fv[base + 3]], k, 1)
      r = r || ch
    end
    return mkstr(r)
  end
  if isarr(fv[base + 2]) = 1 then do
    do k = 1 to arrlen(fv[base + 2])
      f = arrget(fv[base + 2], k)
      if isstr(f) = 1 then do
        rep = ''
        if n >= 3 then do
          if isarr(fv[base + 3]) = 1 then do
            if k <= arrlen(fv[base + 3]) then rep = sarg(arrget(fv[base + 3], k))
          end
          else if isstr(fv[base + 3]) = 1 then rep = cstr[fv[base + 3]]
        end
        if cstr[f] <> '' then t = changestr(cstr[f], t, rep)
      end
    end
  end
  return mkstr(t)
  return 0

/* HB_STRFORMAT */
pf121: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('HB_STRFORMAT')
  return mkstr(strformat(base, n))
  return 0

/* DESCEND */
pf122: procedure = .int
  arg base = .int, n = .int
  v = fv[base + 1]
  if isstr(v) = 1 then do
    s = cstr[v]
    r = ''
    do i = 1 to length(s)
      r = r || d2c(255 - c2d(substr(s, i, 1)))
    end
    return mkstr(r)
  end
  if isnum(v) = 1 then return numneg(v)
  return v
  return 0

/* SOUNDEX */
pf123: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('SOUNDEX')
  u = upper(strip(cstr[fv[base + 1]]))
  if u == '' then return mkstr('0000')
  codes = '01230120022455012623010202'
  r = left(u, 1)
  last = 0
  p0 = c2d(r) - 64
  if p0 >= 1 & p0 <= 26 then last = substr(codes, p0, 1) as .int
  do i = 2 to length(u)
    ch = substr(u, i, 1)
    q = c2d(ch) - 64
    if q < 1 | q > 26 then iterate
    cd = substr(codes, q, 1) as .int
    if cd > 0 & cd <> last then r = r || cd
    if ch <> 'H' & ch <> 'W' then last = cd
    if length(r) = 4 then leave
  end
  return mkstr(left(r || '000', 4))
  return 0

