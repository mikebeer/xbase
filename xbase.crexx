pf73: procedure = .int
  arg base = .int, n = .int
  if n < 1 then return mkdate(0)
  if isstr(fv[base + 1]) = 0 then return argerr('STOD')
  return datelit(strip(cstr[fv[base + 1]]))
  return 0

/* HB_DATE */
pf74: procedure = .int
  arg base = .int, n = .int
  return mkdate(ymd2jdn(iarg(fv[base + 1], 1900), iarg(fv[base + 2], 1), iarg(fv[base + 3], 1)))
  return 0

/* ARRAY */
pf75: procedure = .int
  arg base = .int, n = .int
  dims = n
  if dims = 0 then return mkarray(0)
  return mkmulti(base, 1, n)
  return 0

/* AADD */
pf76: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 then return argerr('AADD')
  call arrpush fv[base + 1], fv[base + 2]
  return fv[base + 2]
  return 0

/* ADEL */
pf77: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('ADEL')
  p = toint(numval(fv[base + 2]))
  len = arrlen(fv[base + 1])
  if p < 1 | p > len then return fv[base + 1]
  do i = p to len - 1
    call arrset fv[base + 1], i, arrget(fv[base + 1], i + 1)
  end
  call arrset fv[base + 1], len, 0
  return fv[base + 1]
  return 0

/* AINS */
pf78: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('AINS')
  p = toint(numval(fv[base + 2]))
  len = arrlen(fv[base + 1])
  if p < 1 | p > len then return fv[base + 1]
  do i = len to p + 1 by -1
    call arrset fv[base + 1], i, arrget(fv[base + 1], i - 1)
  end
  call arrset fv[base + 1], p, 0
  return fv[base + 1]
  return 0

/* HB_AINS */
pf79: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('HB_AINS')
  p = toint(numval(fv[base + 2]))
  len = arrlen(fv[base + 1])
  if n >= 4 then do
    if fv[base + 4] = 2 then do
      call arrresize fv[base + 1], len + 1
      len = len + 1
    end
  end
  if p < 1 | p > len then return fv[base + 1]
  do i = len to p + 1 by -1
    call arrset fv[base + 1], i, arrget(fv[base + 1], i - 1)
  end
  call arrset fv[base + 1], p, fv[base + 3]
  return fv[base + 1]
  return 0

/* HB_ADEL */
pf80: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('HB_ADEL')
  p = toint(numval(fv[base + 2]))
  len = arrlen(fv[base + 1])
  if p < 1 | p > len then return fv[base + 1]
  do i = p to len - 1
    call arrset fv[base + 1], i, arrget(fv[base + 1], i + 1)
  end
  if n >= 3 then do
    if fv[base + 3] = 2 then do
      call arrresize fv[base + 1], len - 1
      return fv[base + 1]
    end
  end
  call arrset fv[base + 1], len, 0
  return fv[base + 1]
  return 0

/* ASIZE */
pf81: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('ASIZE')
  k = toint(numval(fv[base + 2]))
  if k < 0 then k = 0
  call arrresize fv[base + 1], k
  return fv[base + 1]
  return 0

/* ATAIL */
pf82: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 then return argerr('ATAIL')
  if arrlen(fv[base + 1]) = 0 then return 0
  return arrget(fv[base + 1], arrlen(fv[base + 1]))
  return 0

/* ASCAN HB_ASCAN */
pf83: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 then return argerr('ASCAN')
  st = 1
  if n >= 3 then st = iarg(fv[base + 3], 1)
  len = arrlen(fv[base + 1])
  cnt = len - st + 1
  if n >= 4 then cnt = iarg(fv[base + 4], cnt)
  if st < 1 then st = 1
  en = st + cnt - 1
  if en > len then en = len
  do i = st to en
    el = arrget(fv[base + 1], i)
    if isblk(fv[base + 2]) = 1 then do
      r = evalblock1(fv[base + 2], el)
      if ctl <> 0 then return 0
      if r = 2 then return mkint(i)
    end
    else do
      if isstr(fv[base + 2]) = 1 & isstr(el) = 1 then do
        if cstr[fv[base + 2]] == cstr[el] then return mkint(i)
      end
      else do
        if keyeq(el, fv[base + 2]) = 1 then return mkint(i)
        if isnum(el) = 1 & isnum(fv[base + 2]) = 1 then do
          if numval(el) = numval(fv[base + 2]) then return mkint(i)
        end
      end
    end
  end
  return mkint(0)
  return 0

/* AEVAL */
pf84: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 | isblk(fv[base + 2]) = 0 then return argerr('AEVAL')
  st = 1
  if n >= 3 then st = iarg(fv[base + 3], 1)
  len = arrlen(fv[base + 1])
  cnt = len - st + 1
  if n >= 4 then cnt = iarg(fv[base + 4], cnt)
  if st < 1 then st = 1
  en = st + cnt - 1
  if en > len then en = len
  do i = st to en
    junk = evalblock2(fv[base + 2], arrget(fv[base + 1], i), mkint(i))
    if ctl <> 0 then return 0
  end
  return fv[base + 1]
  return 0

/* ASORT */
pf85: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 then return argerr('ASORT')
  st = 1
  if n >= 2 then st = iarg(fv[base + 2], 1)
  len = arrlen(fv[base + 1])
  cnt = len - st + 1
  if n >= 3 then cnt = iarg(fv[base + 3], cnt)
  blk = 0
  if n >= 4 then do
    if isblk(fv[base + 4]) = 1 then blk = fv[base + 4]
  end
  if st < 1 then st = 1
  if st + cnt - 1 > len then cnt = len - st + 1
  if cnt > 1 then call msort cint[fv[base + 1]] + st - 1, cnt, blk
  return fv[base + 1]
  return 0

/* ACLONE */
pf86: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 then return argerr('ACLONE')
  return cloneval(fv[base + 1])
  return 0

/* ACOPY */
pf87: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 | isarr(fv[base + 2]) = 0 then return argerr('ACOPY')
  st = 1
  if n >= 3 then st = iarg(fv[base + 3], 1)
  len = arrlen(fv[base + 1])
  cnt = len - st + 1
  if n >= 4 then cnt = iarg(fv[base + 4], cnt)
  dp = 1
  if n >= 5 then dp = iarg(fv[base + 5], 1)
  do i = 0 to cnt - 1
    if st + i <= len & dp + i <= arrlen(fv[base + 2]) then call arrset fv[base + 2], dp + i, arrget(fv[base + 1], st + i)
  end
  return fv[base + 2]
  return 0

/* AFILL */
pf88: procedure = .int
  arg base = .int, n = .int
  if isarr(fv[base + 1]) = 0 then return argerr('AFILL')
  st = 1
  if n >= 3 then st = iarg(fv[base + 3], 1)
  len = arrlen(fv[base + 1])
  cnt = len - st + 1
  if n >= 4 then cnt = iarg(fv[base + 4], cnt)
  do i = st to st + cnt - 1
    if i >= 1 & i <= len then call arrset fv[base + 1], i, fv[base + 2]
  end
  return fv[base + 1]
  return 0

/* HB_ATOKENS */
pf89: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('HB_ATOKENS')
  d = ' '
  if n >= 2 then do
    if isstr(fv[base + 2]) = 1 then d = cstr[fv[base + 2]]
  end
  r = mkarray(0)
  s = cstr[fv[base + 1]]
  if d == '' then d = ' '
  do forever
    p = pos(d, s)
    if p = 0 then do
      call arrpush r, mkstr(s)
      leave
    end
    call arrpush r, mkstr(substr(s, 1, p - 1))
    s = substr(s, p + length(d))
  end
  return r
  return 0

/* HB_HASH */
pf90: procedure = .int
  arg base = .int, n = .int
  h = mkhash()
  i = 1
  do while i < n
    call hset h, fv[base + 1], fv[base + 2]
    i = i + 2
  end
  return h
  return 0

/* HB_HSET */
pf91: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HSET')
  call hset fv[base + 1], fv[base + 2], fv[base + 3]
  return fv[base + 1]
  return 0

/* HB_HGET */
pf92: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HGET')
  p = hfind(fv[base + 1], fv[base + 2])
  if p = 0 then return rterr('BASE', 1132, 'Bound error', 'hash access')
  return arrget(ca2[fv[base + 1]], p)
  return 0

/* HB_HGETDEF */
pf93: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HGETDEF')
  p = hfind(fv[base + 1], fv[base + 2])
  if p = 0 then return fv[base + 3]
  return arrget(ca2[fv[base + 1]], p)
  return 0

/* HB_HHASKEY */
pf94: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HHASKEY')
  return mklog(hfind(fv[base + 1], fv[base + 2]) > 0)
  return 0

/* HB_HDEL */
pf95: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HDEL')
  p = hfind(fv[base + 1], fv[base + 2])
  if p > 0 then call hdel fv[base + 1], p
  return fv[base + 1]
  return 0

/* HB_HKEYS */
pf96: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HKEYS')
  r = mkarray(0)
  do i = 1 to hashlen(fv[base + 1])
    call arrpush r, arrget(ca1[fv[base + 1]], i)
  end
  return r
  return 0

/* HB_HVALUES */
pf97: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HVALUES')
  r = mkarray(0)
  do i = 1 to hashlen(fv[base + 1])
    call arrpush r, arrget(ca2[fv[base + 1]], i)
  end
  return r
  return 0

/* HB_HPOS */
pf98: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HPOS')
  return mkint(hfind(fv[base + 1], fv[base + 2]))
  return 0

/* HB_HKEYAT */
pf99: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('HB_HKEYAT')
  p = toint(numval(fv[base + 2]))
  if p < 1 | p > hashlen(fv[base + 1]) then return rterr('BASE', 1187, 'Bound error', 'hash access')
  return arrget(ca1[fv[base + 1]], p)
  return 0

/* HB_HVALUEAT */
pf100: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('HB_HVALUEAT')
  p = toint(numval(fv[base + 2]))
  if p < 1 | p > hashlen(fv[base + 1]) then return rterr('BASE', 1187, 'Bound error', 'hash access')
  if n >= 3 then call arrset ca2[fv[base + 1]], p, fv[base + 3]
  return arrget(ca2[fv[base + 1]], p)
  return 0

/* HB_HCLONE */
pf101: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 then return argerr('HB_HCLONE')
  return cloneval(fv[base + 1])
  return 0

/* HB_HMERGE */
pf102: procedure = .int
  arg base = .int, n = .int
  if ishash(fv[base + 1]) = 0 | ishash(fv[base + 2]) = 0 then return argerr('HB_HMERGE')
  do i = 1 to hashlen(fv[base + 2])
    call hset fv[base + 1], arrget(ca1[fv[base + 2]], i), arrget(ca2[fv[base + 2]], i)
  end
  return fv[base + 1]
  return 0

/* EVAL */
pf103: procedure = .int
  arg base = .int, n = .int
  if isblk(fv[base + 1]) = 0 then return rterr('BASE', 1004, 'Argument error', 'EVAL')
  b = ftop
  k = n - 1
  do i = 1 to k
    fv[b + i] = fv[base + i + 1]
  end
  ftop = b + k
  return callblock(fv[base + 1], b, k)
  return 0

/* DO */
pf104: procedure = .int
  arg base = .int, n = .int
  nm = fv[base + 1]
  k = n - 1
  a = mkarray(k)
  do i = 1 to k
    call arrset a, i, fv[base + i + 1]
  end
  if isblk(nm) = 1 then do
    b = ftop
    do i = 1 to k
      fv[b + i] = arrget(a, i)
    end
    ftop = b + k
    return callblock(nm, b, k)
  end
  if isstr(nm) = 0 then return argerr('DO')
  return callsym(intern(upper(strip(cstr[nm]))), a)
  return 0

