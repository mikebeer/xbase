/* CTOD */
pf72: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('CTOD')
  fmt = setdatefmt
  if setcentury = 1 & pos('YYYY', upper(fmt)) = 0 then fmt = changestr('yy', fmt, 'yyyy')
  return mkdate(parsedate(cstr[fv[base + 1]], fmt))
  return 0

