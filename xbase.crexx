/*
 * xbase.crexx - an xBase (Harbour / Clipper) interpreter written in CREXX Level B
 *
 * Usage:   rxvm xbase.rxbin -a program.prg [arguments ...]
 *
 * The program is tokenized, parsed into a tree and interpreted. DBF tables,
 * indexes and a line-oriented console are built in.
 *
 * Data model: every xBase value is an integer "reference".
 *   reference < 0   a whole number n (width 10): n >= 0 is -(2n+1), n < 0 is 2n
 *   reference 0     NIL         1  .F.        2  .T.
 *   reference > 2   a cell in the heap arrays ctag cint ca1 ca2 cnum cstr
 * Cell tags: 1 number, 2 string, 3 logical, 4 date, 5 array, 6 hash,
 *   7 code block, 8 object, 9 variable reference.
 */
options levelb
namespace xbase expose ctag cint ca1 ca2 cnum cstr ncell vdat nv snm shn sbk nsym sfn sbi smv smvd sdef pmin pmax tk ts tl tsp tv tor ntok tp inblk srcname curline ifdepth ifskip ifstate dname dval dpar ndef incpath nt na nb nc nd ne nf nx nl ns nn cxkind cxpar cxnslot cxncap ncx curcx vname vctx vkind vidx vsrck vsrci nvar mstname mstidx nmst nstatic curfn infunc curclass fieldnames fnname fnpar fnslots fnbody fnclass nfn sv svinit svslot nsvinit mainfn firstfn fv ftop fbase fpc curself curcap calldepth pvs pvv pvd pvtop pcln pcname pctop ctl retv brkval errblk errdepth seqdepth exitcode setdec setexact setfixed setcentury setdatefmt setdeleted setsoft setepoch setconsole setprint setbell setescape setunique setdefault outcol outrow scrrow scrcol outbuf seed inbuf inhave ineof argvs nargvs progname progdir clname clpar clnslot ncls scls cinitcls cinitslot cinitnode ncinit pmk1 pmk2 pmk3 pmv pmn pmb npm curmcls initfns ninit exitfns nexitp outstarted smacro errcls curarea curl wa_used wa_alias wa_file wa_nrec wa_recno wa_eof wa_bof wa_found wa_nfld wa_hdr wa_reclen wa_dirty wa_order wa_ipos wa_filter wa_filtertxt wa_locfor wa_locwhile wa_ro wa_nix wa_relchild wa_relkey wa_nrel wa_memo wa_hasmemo wa_blank fsym fnam ftyp flen fdec foff recs ix_area ix_node ix_text ix_for ix_fortext ix_desc ix_uniq ix_file ix_start ix_len ix_cap ix_dirty ix_name nix ixk ixr nixpool waix gt_node gt_pic gt_valid gt_when gt_row gt_col ngets altfile rc junk lexpos srcdir perrflag perrmsg macrodepth perrline rk ri argcount listcount savenvar gy gm gd fhname fhdata fhpos fhopen fhdirty fhmode nfh okeys sc_a sc_lim sc_single sc_done sc_for sc_while atrow

import rxfnsb

arg argv = .string[]

/* ------------------------------------------------------------------ heap */
ctag = .int[]        /* cell type                                    */
cint = .int[]        /* date number / array start / block node / class id / number picture */
ca1 = .int[]          /* array length / hash keys / block captures / object slots */
ca2 = .int[]          /* array capacity / hash values / block Self */
cnum = .float[]      /* number value                                 */
cstr = .string[]     /* string value                                 */
ncell = 2
vdat = .int[]        /* array element storage                        */
nv = 0

/* --------------------------------------------------------------- symbols */
snm = .string[]      /* symbol name (upper case)        */
shn = .int[]         /* hash chain                      */
sbk = .int[]         /* hash buckets                    */
nsym = 0
sfn = .int[]         /* user function id                */
sbi = .int[]         /* builtin id                      */
smv = .int[]         /* memvar value                    */
smvd = .int[]        /* memvar visible: 0 no, 1 yes     */
sdef = .int[]        /* #define index                   */
pmin = .int[]
pmax = .int[]

/* ---------------------------------------------------------------- tokens */
tk = .int[]          /* token kind                      */
ts = .string[]       /* token text                      */
tl = .int[]          /* line number                     */
tsp = .int[]         /* 1 = preceded by blank           */
tv = .int[]          /* identifier symbol id            */
tor = .string[]      /* original text of the token      */
ntok = 0
tp = 1
inblk = 0
srcname = ''
curline = 0
ifdepth = 0
ifskip = 0
ifstate = .int[]     /* per nesting: 1 taking, 2 skipping-but-may-take, 3 done, 4 dead */
dname = .string[]    /* #define names */
dval = .string[]     /* #define values */
dpar = .string[]     /* #define parameters, '' for none */
ndef = 0
incpath = '.'

/* ----------------------------------------------------------------- nodes */
nt = .int[]
na = .int[]
nb = .int[]
nc = .int[]
nd = .int[]
ne = .int[]
nf = .int[]
nx = .int[]          /* next sibling */
nl = .int[]          /* source line */
ns = .string[]
nn = 0

/* ------------------------------------------------------- parse-time scope */
cxkind = .int[]      /* context: 0 function, 1 block   */
cxpar = .int[]       /* parent context                 */
cxnslot = .int[]     /* slots in use                   */
cxncap = .int[]      /* number of captures             */
ncx = 0
curcx = 0
vname = .int[]       /* declared name symbol id        */
vctx = .int[]        /* context of the declaration     */
vkind = .int[]       /* 1 local/parameter slot, 2 static, 3 capture */
vidx = .int[]        /* slot / static index / capture index */
vsrck = .int[]       /* capture: source kind 1 slot of parent, 2 capture of parent */
vsrci = .int[]       /* capture: source index          */
nvar = 0
mstname = .int[]     /* module-level statics */
mstidx = .int[]
nmst = 0
nstatic = 0
curfn = 0
infunc = 0
curclass = 0
fieldnames = 0

/* ------------------------------------------------------------- functions */
fnname = .string[]
fnpar = .int[]        /* parameter count */
fnslots = .int[]      /* frame size      */
fnbody = .int[]       /* body node       */
fnclass = .int[]      /* class id for methods, else 0 */
nfn = 0
sv = .int[]          /* static variables */
svinit = .int[]      /* static initialiser nodes, in order: node, slot */
svslot = .int[]
nsvinit = 0
mainfn = 0
firstfn = 0

/* ---------------------------------------------------------------- frames */
fv = .int[]
ftop = 0
fbase = 0
fpc = 0              /* PCount of current call */
curself = 0
curcap = 0           /* capture array start of running block */
calldepth = 0
pvs = .int[]         /* private save stack: symbol */
pvv = .int[]         /* private save stack: old value */
pvd = .int[]         /* private save stack: old visibility */
pvtop = 0
pcln = .int[]      /* call stack: line */
pcname = .string[]
pctop = 0

/* --------------------------------------------------------------- control */
ctl = 0
retv = 0
brkval = 0
errblk = 0
errdepth = 0
seqdepth = 0
exitcode = 0

/* ----------------------------------------------------------------- misc */
setdec = 2
setexact = 0
setfixed = 0
setcentury = 0
setdatefmt = 'mm/dd/yy'
setdeleted = 0
setsoft = 0
setepoch = 1900
setconsole = 1
setprint = 0
setbell = 0
setescape = 1
setunique = 0
setdefault = ''
outcol = 0
outrow = 0
scrrow = 0
scrcol = 0
outbuf = ''
seed = 12345
inbuf = ''
inhave = 0
ineof = 0
argvs = .string[]
nargvs = 0
progname = ''
progdir = '.'

/* --------------------------------------------------------------- classes */
clname = .string[]
clpar = .int[]
clnslot = .int[]
ncls = 0
scls = .int[]        /* symbol -> class id */
cinitcls = .int[]
cinitslot = .int[]
cinitnode = .int[]
ncinit = 0
pmk1 = .int[]
pmk2 = .int[]
pmk3 = .int[]
pmv = .int[]
pmn = .int[]
pmb = .int[]
npm = 0
curmcls = 0          /* class of the running method */
initfns = .int[]
ninit = 0
exitfns = .int[]
nexitp = 0
outstarted = 0
smacro = .int[]
errcls = 0
curarea = 0
curl = 0

/* ------------------------------------------------------------ work areas */
wa_used = .int[]
wa_alias = .string[]
wa_file = .string[]
wa_nrec = .int[]
wa_recno = .int[]
wa_eof = .int[]
wa_bof = .int[]
wa_found = .int[]
wa_nfld = .int[]
wa_hdr = .int[]
wa_reclen = .int[]
wa_dirty = .int[]
wa_order = .int[]
wa_ipos = .int[]
wa_filter = .int[]
wa_filtertxt = .string[]
wa_locfor = .int[]
wa_locwhile = .int[]
wa_ro = .int[]
wa_nix = .int[]
wa_relchild = .int[]
wa_relkey = .int[]
wa_nrel = .int[]
wa_memo = .string[]
wa_hasmemo = .int[]
wa_blank = .string[]
fsym = .int[]
fnam = .string[]
ftyp = .string[]
flen = .int[]
fdec = .int[]
foff = .int[]
recs = .string[]
ix_area = .int[]
ix_node = .int[]
ix_text = .string[]
ix_for = .int[]
ix_fortext = .string[]
ix_desc = .int[]
ix_uniq = .int[]
ix_file = .string[]
ix_start = .int[]
ix_len = .int[]
ix_cap = .int[]
ix_dirty = .int[]
ix_name = .string[]
nix = 0
ixk = .int[]
ixr = .int[]
nixpool = 0
waix = .int[]
gt_node = .int[]
gt_pic = .int[]
gt_valid = .int[]
gt_when = .int[]
gt_row = .int[]
gt_col = .int[]
ngets = 0
altfile = ''

/* ---------------------------------------------------------------- driver */
call initall
if argv.0 < 1 then do
  say 'usage: rxvm xbase.rxbin -a program.prg [arguments]'
  exit 2
end
progname = argv[1]
progdir = dirof(progname)
incpath = progdir
nargvs = argv.0 - 1
do ai = 2 to argv.0
  argvs[ai - 1] = argv[ai]
end
rc = lexfile(progname)
if rc <> 0 then do
  say 'Error: cannot open file ' || progname
  exit 1
end
call addtok 5, '', 0
call addtok 8, '', 0
tp = 1
junk = parseprogram()
if perrflag = 1 then do
  call errout progname || '(' || perrline || ') Error: ' || perrmsg
  exit 1
end
call runprogram
call shutdown
exit exitcode

/* ===================================================================== */
/*                           VALUES AND HEAP                             */
/* ===================================================================== */
newcell: procedure = .int
  arg tag = .int
  ncell = ncell + 1
  ctag[ncell] = tag
  cint[ncell] = 0
  ca1[ncell] = 0
  ca2[ncell] = 0
  return ncell

mkint: procedure = .int
  arg n = .int
  if n >= 0 then return 0 - (2 * n + 1)
  return 2 * n

toint: procedure = .int
  arg x = .float
  return trunc(x) as .int

isint: procedure = .int
  arg r = .int
  if r < 0 then return 1
  return 0

intval: procedure = .int
  arg r = .int
  if r % 2 = 0 then return r / 2
  return (0 - r - 1) / 2

/* a number with width w and d decimals */
mknum: procedure = .int
  arg x = .float, w = .int, d = .int
  if d = 0 then do
    if x < 9.0e15 & x > -9.0e15 then do
      q = trunc(x) as .int
      if q * 1.0 = x then return mkint(q)
    end
  end
  c = newcell(1)
  cnum[c] = x
  cint[c] = w * 256 + d
  return c

mkfloat: procedure = .int
  arg x = .float
  return mknum(x, 10, 0)

isnum: procedure = .int
  arg r = .int
  if r < 0 then return 1
  if r > 2 then do
    if ctag[r] = 1 then return 1
  end
  return 0

isstr: procedure = .int
  arg r = .int
  if r > 2 then do
    if ctag[r] = 2 then return 1
  end
  return 0

islog: procedure = .int
  arg r = .int
  if r = 1 | r = 2 then return 1
  return 0

isdate: procedure = .int
  arg r = .int
  if r > 2 then do
    if ctag[r] = 4 then return 1
  end
  return 0

isarr: procedure = .int
  arg r = .int
  if r > 2 then do
    if ctag[r] = 5 then return 1
  end
  return 0

ishash: procedure = .int
  arg r = .int
  if r > 2 then do
    if ctag[r] = 6 then return 1
  end
  return 0

isblk: procedure = .int
  arg r = .int
  if r > 2 then do
    if ctag[r] = 7 then return 1
  end
  return 0

isobj: procedure = .int
  arg r = .int
  if r > 2 then do
    if ctag[r] = 8 then return 1
  end
  return 0

/* numeric value as a float */
numval: procedure = .float
  arg r = .int
  if r < 0 then return intval(r) * 1.0
  if r > 2 then do
    if ctag[r] = 1 then return cnum[r]
  end
  return 0.0

/* decimals of a number */
numdec: procedure = .int
  arg r = .int
  if r < 0 then return 0
  return cint[r] % 256

numwid: procedure = .int
  arg r = .int
  if r < 0 then return 10
  return cint[r] / 256

mkstr: procedure = .int
  arg s = .string
  c = newcell(2)
  cstr[c] = s
  return c

mklog: procedure = .int
  arg b = .int
  if b <> 0 then return 2
  return 1

mkdate: procedure = .int
  arg j = .int
  c = newcell(4)
  cint[c] = j
  return c

/* is the value true? */
truthy: procedure = .int
  arg r = .int
  if r = 2 then return 1
  return 0

/* ---------------------------------------------------------------- arrays */
mkarray: procedure = .int
  arg n = .int
  c = newcell(5)
  cap = n
  if cap < 4 then cap = 4
  cint[c] = nv + 1
  ca1[c] = n
  ca2[c] = cap
  do i = 1 to cap
    vdat[nv + i] = 0
  end
  nv = nv + cap
  return c

arrlen: procedure = .int
  arg a = .int
  return ca1[a]

arrget: procedure = .int
  arg a = .int, i = .int
  return vdat[cint[a] + i - 1]

arrset: procedure = .void
  arg a = .int, i = .int, v = .int
  vdat[cint[a] + i - 1] = v
  return

arrgrow: procedure = .void
  arg a = .int, cap = .int
  s = cint[a]
  n = ca1[a]
  do i = 1 to n
    vdat[nv + i] = vdat[s + i - 1]
  end
  do i = n + 1 to cap
    vdat[nv + i] = 0
  end
  cint[a] = nv + 1
  ca2[a] = cap
  nv = nv + cap
  return

arrpush: procedure = .void
  arg a = .int, v = .int
  n = ca1[a]
  if n >= ca2[a] then call arrgrow a, n * 2 + 4
  n = n + 1
  ca1[a] = n
  vdat[cint[a] + n - 1] = v
  return

arrresize: procedure = .void
  arg a = .int, n = .int
  if n > ca2[a] then call arrgrow a, n + 4
  old = ca1[a]
  s = cint[a]
  if n > old then do
    do i = old + 1 to n
      vdat[s + i - 1] = 0
    end
  end
  ca1[a] = n
  return

/* ---------------------------------------------------------------- hashes */
mkhash: procedure = .int
  c = newcell(6)
  k = mkarray(0)
  v = mkarray(0)
  ca1[c] = k
  ca2[c] = v
  return c

hashlen: procedure = .int
  arg h = .int
  return ca1[ca1[h]]

/* key equality: strings exact, numbers by value, dates by number */
keyeq: procedure = .int
  arg a = .int, b = .int
  if a = b then return 1
  if a <= 2 | b <= 2 then do
    if a < 0 & b < 0 then return 0
    return 0
  end
  ta = ctag[a]
  if ta <> ctag[b] then return 0
  if ta = 2 then do
    if cstr[a] == cstr[b] then return 1
    return 0
  end
  if ta = 1 then do
    if cnum[a] = cnum[b] then return 1
    return 0
  end
  if ta = 4 then do
    if cint[a] = cint[b] then return 1
    return 0
  end
  return 0

/* find key; returns position or 0 */
hfind: procedure = .int
  arg h = .int, key = .int
  ks = ca1[h]
  n = ca1[ks]
  s = cint[ks]
  if key < 0 then do
    do i = 1 to n
      if vdat[s + i - 1] = key then return i
    end
    kf = intval(key) * 1.0
    do i = 1 to n
      k2 = vdat[s + i - 1]
      if k2 > 2 then do
        if ctag[k2] = 1 then do
          if cnum[k2] = kf then return i
        end
      end
    end
    return 0
  end
  do i = 1 to n
    k2 = vdat[s + i - 1]
    if k2 < 0 & key > 2 then do
      if ctag[key] = 1 then do
        if cnum[key] = intval(k2) * 1.0 then return i
      end
    end
    else if keyeq(k2, key) = 1 then return i
  end
  return 0

hset: procedure = .void
  arg h = .int, key = .int, v = .int
  p = hfind(h, key)
  if p > 0 then do
    call arrset ca2[h], p, v
    return
  end
  call arrpush ca1[h], key
  call arrpush ca2[h], v
  return

hdel: procedure = .void
  arg h = .int, p = .int
  ks = ca1[h]
  vs = ca2[h]
  n = ca1[ks]
  do i = p to n - 1
    call arrset ks, i, arrget(ks, i + 1)
    call arrset vs, i, arrget(vs, i + 1)
  end
  ca1[ks] = n - 1
  ca1[vs] = n - 1
  return

/* ---------------------------------------------------------------- symbols */
symhash: procedure = .int
  arg s = .string
  h = 7
  n = length(s)
  do i = 1 to n
    h = (h * 31 + c2d(substr(s, i, 1))) % 100003
  end
  return h % 2048 + 1

intern: procedure = .int
  arg name = .string
  b = symhash(name)
  s = sbk[b]
  do while s > 0
    if snm[s] == name then return s
    s = shn[s]
  end
  nsym = nsym + 1
  snm[nsym] = name
  shn[nsym] = sbk[b]
  sbk[b] = nsym
  sfn[nsym] = 0
  sbi[nsym] = 0
  smv[nsym] = 0
  smvd[nsym] = 0
  sdef[nsym] = 0
  scls[nsym] = 0
  return nsym

registerprim: procedure = .void
  arg name = .string, id = .int, mn = .int, mx = .int
  s = intern(name)
  sbi[s] = id
  pmin[id] = mn
  pmax[id] = mx
  return

/* ------------------------------------------------------------------ nodes */
mknode: procedure = .int
  arg kind = .int, a = .int, b = .int, c = .int
  nn = nn + 1
  nt[nn] = kind
  na[nn] = a
  nb[nn] = b
  nc[nn] = c
  nd[nn] = 0
  ne[nn] = 0
  nf[nn] = 0
  nx[nn] = 0
  nl[nn] = curline
  ns[nn] = ''
  return nn

/* ----------------------------------------------------------------- output */
emit: procedure = .void
  arg s = .string
  if s = '' then return
  k = lastpos('0a'x, s)
  if k > 0 then outcol = length(s) - k
  else outcol = outcol + length(s)
  outstarted = 1
  outbuf = outbuf || s
  if length(outbuf) > 2000 then call flushout
  return

flushout: procedure = .void
  if outbuf <> '' then do
    call charout 'stdout', outbuf
    outbuf = ''
  end
  return

emitnl: procedure = .void
  call emit '0a'x
  outcol = 0
  scrrow = scrrow + 1
  scrcol = 0
  return

errout: procedure = .void
  arg s = .string
  call flushout
  call lineout 'stderr', s
  return

/* ------------------------------------------------------- pair hash table */
pmhash: procedure = .int
  arg kind = .int, a = .int, b = .int
  return (kind * 7919 + a * 131 + b * 31) % 4093 + 1

pm_get: procedure = .int
  arg kind = .int, a = .int, b = .int
  i = pmb[pmhash(kind, a, b)]
  do while i > 0
    if pmk1[i] = kind & pmk2[i] = a & pmk3[i] = b then return pmv[i]
    i = pmn[i]
  end
  return 0

pm_put: procedure = .void
  arg kind = .int, a = .int, b = .int, v = .int
  h = pmhash(kind, a, b)
  i = pmb[h]
  do while i > 0
    if pmk1[i] = kind & pmk2[i] = a & pmk3[i] = b then do
      pmv[i] = v
      return
    end
    i = pmn[i]
  end
  npm = npm + 1
  pmk1[npm] = kind
  pmk2[npm] = a
  pmk3[npm] = b
  pmv[npm] = v
  pmn[npm] = pmb[h]
  pmb[h] = npm
  return

/* ===================================================================== */
/*                       TOKENIZER AND PREPROCESSOR                      */
/* ===================================================================== */
isidstart: procedure = .int
  arg c = .string
  k = c2d(c)
  if k >= 65 & k <= 90 then return 1
  if k >= 97 & k <= 122 then return 1
  if k = 95 then return 1
  if k >= 192 then return 1
  return 0

isidchar: procedure = .int
  arg c = .string
  k = c2d(c)
  if k >= 65 & k <= 90 then return 1
  if k >= 97 & k <= 122 then return 1
  if k >= 48 & k <= 57 then return 1
  if k = 95 then return 1
  if k >= 192 then return 1
  return 0

isdigitc: procedure = .int
  arg c = .string
  k = c2d(c)
  if k >= 48 & k <= 57 then return 1
  return 0

addtok: procedure = .void
  arg kind = .int, text = .string, sp = .int
  ntok = ntok + 1
  tk[ntok] = kind
  ts[ntok] = text
  tl[ntok] = curline
  tsp[ntok] = sp
  tv[ntok] = 0
  tor[ntok] = text
  return

/* replace whole-word occurrences of name by repl */
replword: procedure = .string
  arg body = .string, name = .string, repl = .string
  res = ''
  i = 1
  n = length(body)
  nl2 = length(name)
  do while i <= n
    c = substr(body, i, 1)
    if isidstart(c) = 1 then do
      j = i
      do while j <= n
        if isidchar(substr(body, j, 1)) = 0 then leave
        j = j + 1
      end
      w = substr(body, i, j - i)
      if upper(w) == name then res = res || repl
      else res = res || w
      i = j
    end
    else do
      res = res || c
      i = i + 1
    end
  end
  return res

/* expand a function-like #define; ln(p) is just after the name. Returns text, sets lexpos */
lexpos = 0
expandfn: procedure = .string
  arg di = .int, ln = .string, p = .int
  /* skip blanks, expect ( */
  q = p
  do while substr(ln, q, 1) = ' '
    q = q + 1
  end
  if substr(ln, q, 1) <> '(' then do
    lexpos = 0
    return ''
  end
  q = q + 1
  dep = 1
  arg1 = ''
  nargs = 0
  actual = .string[]
  inq = ''
  n = length(ln)
  do while q <= n
    c = substr(ln, q, 1)
    if inq <> '' then do
      arg1 = arg1 || c
      if c == inq then inq = ''
    end
    else if c = '"' | c = "'" then do
      inq = c
      arg1 = arg1 || c
    end
    else if c = '(' | c = '{' | c = '[' then do
      dep = dep + 1
      arg1 = arg1 || c
    end
    else if c = ')' | c = '}' | c = ']' then do
      dep = dep - 1
      if dep = 0 then do
        nargs = nargs + 1
        actual[nargs] = strip(arg1)
        q = q + 1
        leave
      end
      arg1 = arg1 || c
    end
    else if c = ',' & dep = 1 then do
      nargs = nargs + 1
      actual[nargs] = strip(arg1)
      arg1 = ''
    end
    else arg1 = arg1 || c
    q = q + 1
  end
  body = dval[di]
  pl = dpar[di]
  k = 0
  do while pl <> ''
    pp = pos(',', pl)
    if pp = 0 then do
      pn = strip(pl)
      pl = ''
    end
    else do
      pn = strip(substr(pl, 1, pp - 1))
      pl = substr(pl, pp + 1)
    end
    k = k + 1
    rep = ''
    if k <= nargs then rep = actual[k]
    body = replword(body, upper(pn), rep)
  end
  lexpos = q
  return body

/* tokenize one chunk of text */
lexchunk: procedure = .void
  arg ln = .string, depth = .int
  n = length(ln)
  p = 1
  sp = 0
  do while p <= n
    c = substr(ln, p, 1)
    if inblk = 1 then do
      q = pos('*/', ln, p)
      if q = 0 then return
      inblk = 0
      p = q + 2
      sp = 1
      iterate
    end
    if c = ' ' | c = '09'x | c = '0d'x then do
      sp = 1
      p = p + 1
      iterate
    end
    c2 = substr(ln, p + 1, 1)
    if c = '/' & c2 = '/' then return
    if c = '&' & c2 = '&' then return
    if c = '/' & c2 = '*' then do
      q = pos('*/', ln, p + 2)
      if q = 0 then do
        inblk = 1
        return
      end
      p = q + 2
      sp = 1
      iterate
    end
    if isidstart(c) = 1 then do
      j = p
      do while j <= n
        if isidchar(substr(ln, j, 1)) = 0 then leave
        j = j + 1
      end
      orig = substr(ln, p, j - p)
      w = upper(orig)
      p = j
      s = intern(w)
      di = sdef[s]
      if di > 0 & depth < 8 then do
        if dpar[di] == '' then do
          call lexchunk dval[di], depth + 1
        end
        else do
          ex = expandfn(di, ln, p)
          if lexpos > 0 then do
            p = lexpos
            call lexchunk ex, depth + 1
          end
          else do
            call addtok 1, w, sp
            tv[ntok] = s
            tor[ntok] = orig
          end
        end
        sp = 0
        iterate
      end
      call addtok 1, w, sp
      tv[ntok] = s
      tor[ntok] = orig
      sp = 0
      iterate
    end
    if isdigitc(c) = 1 | (c = '.' & isdigitc(c2) = 1) then do
      if c = '0' & (c2 = 'x' | c2 = 'X') then do
        j = p + 2
        do while j <= n
          if pos(upper(substr(ln, j, 1)), '0123456789ABCDEF') = 0 then leave
          j = j + 1
        end
        call addtok 2, x2d(substr(ln, p + 2, j - p - 2)) || '', sp
        p = j
        sp = 0
        iterate
      end
      if c = '0' & (c2 = 'd' | c2 = 'D') & isdigitc(substr(ln, p + 2, 1)) = 1 then do
        call addtok 6, substr(ln, p + 2, 8), sp
        p = p + 10
        sp = 0
        iterate
      end
      j = p
      do while j <= n
        if isdigitc(substr(ln, j, 1)) = 0 then leave
        j = j + 1
      end
      if substr(ln, j, 1) = '.' & isdigitc(substr(ln, j + 1, 1)) = 1 then do
        j = j + 1
        do while j <= n
          if isdigitc(substr(ln, j, 1)) = 0 then leave
          j = j + 1
        end
      end
      else if substr(ln, j, 1) = '.' & j > p then do
        /* "5." is a number unless it starts .AND. .OR. .NOT. */
        c3 = upper(substr(ln, j + 1, 1))
        if pos(c3, 'AONTF') = 0 then j = j + 1
      end
      ec = substr(ln, j, 1)
      if (ec = 'e' | ec = 'E') & j > p then do
        k = j + 1
        if substr(ln, k, 1) = '-' | substr(ln, k, 1) = '+' then k = k + 1
        if isdigitc(substr(ln, k, 1)) = 1 then do
          do while k <= n
            if isdigitc(substr(ln, k, 1)) = 0 then leave
            k = k + 1
          end
          j = k
        end
      end
      call addtok 2, substr(ln, p, j - p), sp
      p = j
      sp = 0
      iterate
    end
    if c = '"' | c = "'" then do
      q = pos(c, ln, p + 1)
      if q = 0 then do
        call addtok 3, substr(ln, p + 1), sp
        p = n + 1
      end
      else do
        call addtok 3, substr(ln, p + 1, q - p - 1), sp
        p = q + 1
      end
      sp = 0
      iterate
    end
    if c = '.' then do
      q = pos('.', ln, p + 1)
      if q > 0 & q - p <= 4 then do
        w = upper(substr(ln, p + 1, q - p - 1))
        if w = 'T' | w = 'Y' then do
          call addtok 7, 'T', sp
          p = q + 1
          sp = 0
          iterate
        end
        if w = 'F' | w = 'N' then do
          call addtok 7, 'F', sp
          p = q + 1
          sp = 0
          iterate
        end
        if w = 'AND' | w = 'OR' | w = 'NOT' then do
          call addtok 4, '.' || w || '.', sp
          p = q + 1
          sp = 0
          iterate
        end
      end
      call addtok 4, '.', sp
      p = p + 1
      sp = 0
      iterate
    end
    if c = '{' & c2 = '^' then do
      q = pos('}', ln, p)
      if q > 0 then do
        d = strip(substr(ln, p + 2, q - p - 2))
        d = changestr('-', d, '')
        d = changestr('/', d, '')
        call addtok 6, d, sp
        p = q + 1
        sp = 0
        iterate
      end
    end
    /* operators */
    c3 = substr(ln, p, 3)
    op = ''
    if c3 == '**=' then op = c3
    else do
      c22 = substr(ln, p, 2)
      if pos(' ' || c22 || ' ', ' := += -= *= /= %= ^= == != <> <= >= -> :: ++ -- ** => ?? ') > 0 & length(c22) = 2 then op = c22
      else op = c
    end
    if op == ';' then call addtok 5, ';', sp
    else call addtok 4, op, sp
    p = p + length(op)
    sp = 0
  end
  return

/* ------------------------------------------------------------ directives */
srcdir = '.'

/* cREXX cannot delete files: ERASE truncates, so an empty file counts as absent */
fileexists: procedure = .int
  arg fname = .string
  fileid = 0
  rc = 0
  mode = "rb"
  chunk = .binary
  clen = 0
  csz = 1
  assembler fopen fileid, fname, mode
  if fileid = 0 then return 0
  assembler freadb chunk, fileid, csz
  assembler blen clen, chunk
  assembler fclose rc, fileid
  if clen > 0 then return 1
  return 0

dirof: procedure = .string
  arg f = .string
  k = lastpos('/', f)
  if k = 0 then return '.'
  if k = 1 then return '/'
  return substr(f, 1, k - 1)

definemacro: procedure = .void
  arg name = .string, par = .string, val = .string
  s = intern(upper(name))
  di = sdef[s]
  if di = 0 then do
    ndef = ndef + 1
    di = ndef
    sdef[s] = di
  end
  dname[di] = upper(name)
  dval[di] = val
  dpar[di] = par
  return

dodirective: procedure = .void
  arg t = .string
  /* t starts with # */
  body = strip(substr(t, 2))
  sp = pos(' ', body)
  if sp = 0 then sp = pos('09'x, body)
  if sp = 0 then do
    cmd = upper(body)
    rest = ''
  end
  else do
    cmd = upper(substr(body, 1, sp - 1))
    rest = strip(substr(body, sp + 1))
  end
  /* conditionals first: they work when skipping */
  if cmd = 'IFDEF' | cmd = 'IFNDEF' then do
    if ifskip = 1 then do
      ifdepth = ifdepth + 1
      ifstate[ifdepth] = 4
    end
    else do
      w = upper(word(rest, 1))
      has = 0
      if sdef[intern(w)] > 0 then has = 1
      if cmd = 'IFNDEF' then has = 1 - has
      ifdepth = ifdepth + 1
      if has = 1 then ifstate[ifdepth] = 1
      else ifstate[ifdepth] = 2
    end
    call setifskip
    return
  end
  if cmd = 'IF' then do
    if ifskip = 1 then do
      ifdepth = ifdepth + 1
      ifstate[ifdepth] = 4
    end
    else do
      ifdepth = ifdepth + 1
      v = strip(rest)
      if v == '0' | v == '.F.' then ifstate[ifdepth] = 2
      else ifstate[ifdepth] = 1
    end
    call setifskip
    return
  end
  if cmd = 'ELSE' then do
    if ifdepth > 0 then do
      st = ifstate[ifdepth]
      if st = 1 then ifstate[ifdepth] = 3
      else if st = 2 then ifstate[ifdepth] = 1
    end
    call setifskip
    return
  end
  if cmd = 'ENDIF' then do
    if ifdepth > 0 then ifdepth = ifdepth - 1
    call setifskip
    return
  end
  if ifskip = 1 then return
  if cmd = 'DEFINE' then do
    /* NAME or NAME(args) value */
    j = 1
    do while j <= length(rest)
      if isidchar(substr(rest, j, 1)) = 0 then leave
      j = j + 1
    end
    name = substr(rest, 1, j - 1)
    par = ''
    fn = 0
    if substr(rest, j, 1) = '(' then do
      q = pos(')', rest, j)
      if q > 0 then do
        par = substr(rest, j + 1, q - j - 1)
        if strip(par) == '' then par = ' '
        fn = 1
        j = q + 1
      end
    end
    val = strip(substr(rest, j))
    if fn = 1 & strip(par) == '' then par = ''
    call definemacro name, par, val
    return
  end
  if cmd = 'UNDEF' then do
    s = intern(upper(word(rest, 1)))
    sdef[s] = 0
    return
  end
  if cmd = 'INCLUDE' then do
    f = strip(rest)
    f = changestr('"', f, '')
    f = changestr('<', f, '')
    f = changestr('>', f, '')
    f = changestr("'", f, '')
    call includefile f
    return
  end
  /* #pragma, #command, #translate, #stdout, #error ... are ignored */
  return

setifskip: procedure = .void
  ifskip = 0
  if ifdepth > 0 then do
    if ifstate[ifdepth] <> 1 then ifskip = 1
  end
  return

includefile: procedure = .void
  arg f = .string
  std = stdinclude(upper(f))
  if std <> '' then do
    call lexstring std, f
    return
  end
  cand = srcdir || '/' || f
  if fileexists(f) = 1 then cand = f
  else if fileexists(cand) = 0 then do
    cand = incpath || '/' || f
    if fileexists(cand) = 0 then do
      if right(upper(f), 3) = '.CH' then return
      call errout 'Error: cannot open include file ' || f
      exit 1
    end
  end
  junk = lexfile(cand)
  return

/* tokenize a block of text with line feeds */
lexstring: procedure = .void
  arg text = .string, nm = .string
  rest = text
  do while rest <> ''
    k = pos('0a'x, rest)
    if k = 0 then do
      ln = rest
      rest = ''
    end
    else do
      ln = substr(rest, 1, k - 1)
      rest = substr(rest, k + 1)
    end
    call lexlogical ln
  end
  return

/* one logical line */
lexlogical: procedure = .void
  arg ln = .string
  t = strip(ln, 'L')
  if inblk = 1 then do
    call lexchunk ln, 0
    if inblk = 0 & ifskip = 0 then call addtok 5, '', 0
    return
  end
  if t == '' then return
  c = substr(t, 1, 1)
  if c = '#' then do
    c2 = substr(t, 2, 1)
    if c2 <> '=' & c2 <> ' ' | length(t) > 1 then do
      call dodirective t
      return
    end
  end
  if ifskip = 1 then return
  if c = '*' then return
  if upper(word(t, 1)) == 'NOTE' then return
  if substr(t, 1, 2) == '&&' then return
  call lexchunk ln, 0
  call addtok 5, '', 0
  return

lexfile: procedure = .int
  arg fname = .string
  fl = readlines(fname, 1, 0, 'noraise')
  if fl.0 >= 1 then do
    if fl[1] == '-8 OPEN ERROR' then return 1
  end
  oldsrc = srcdir
  srcdir = dirof(fname)
  oldname = srcname
  srcname = fname
  i = 1
  nlines = fl.0
  do while i <= nlines
    ln = fl[i]
    curline = i
    do forever
      tt = strip(ln, 'T')
      if right(tt, 1) = ';' & i < nlines & inblk = 0 then do
        ln = substr(tt, 1, length(tt) - 1) || ' ' || fl[i + 1]
        i = i + 1
      end
      else leave
    end
    tl1 = strip(ln)
    if upper(word(tl1, 1)) == 'TEXT' & ifskip = 0 & inblk = 0 then do
      w2 = word(tl1, 2)
      if w2 == '' | upper(w2) == 'TO' | upper(w2) == 'TOFILE' then do
        call addtok 1, 'TEXT', 0
        tv[ntok] = intern('TEXT')
        rest2 = strip(substr(tl1, 5))
        if rest2 <> '' then call lexchunk rest2, 0
        body2 = ''
        i = i + 1
        do while i <= nlines
          tl2 = strip(fl[i])
          if upper(left(tl2, 7)) == 'ENDTEXT' then leave
          if body2 <> '' then body2 = body2 || '0a'x
          body2 = body2 || fl[i]
          i = i + 1
        end
        call addtok 3, body2, 1
        call addtok 5, '', 0
        i = i + 1
        iterate
      end
    end
    call lexlogical ln
    i = i + 1
  end
  srcdir = oldsrc
  srcname = oldname
  return 0

/* standard headers: constants only */
stdinclude: procedure = .string
  arg nm = .string
  nl3 = '0a'x
  base = nm
  k = lastpos('/', base)
  if k > 0 then base = substr(base, k + 1)
  if base == 'INKEY.CH' then do
    return '#define K_ESC 27' || nl3 || '#define K_ENTER 13' || nl3 || '#define 56 13' || nl3 || '#define K_SPACE 32' || nl3 || '#define K_TAB 9' || nl3 || '#define K_BS 8' || nl3 || '#define K_UP 5' || nl3 || '#define K_DOWN 24' || nl3 || '#define K_LEFT 19' || nl3 || '#define K_RIGHT 4' || nl3 || '#define K_HOME 1' || nl3 || '#define K_END 6' || nl3 || '#define K_PGUP 18' || nl3 || '#define K_PGDN 3' || nl3 || '#define K_INS 22' || nl3 || '#define K_DEL 7' || nl3 || '#define K_CTRL_C 3' || nl3 || '#define K_F1 28' || nl3 || '#define K_F2 -1' || nl3 || '#define K_F10 -9'
  end
  if base == 'COMMON.CH' | base == 'STD.CH' | base == 'HBCLASS.CH' | base == 'HBVER.CH' | base == 'SIMPLEIO.CH' | base == 'DBINFO.CH' | base == 'TBROWSE.CH' | base == 'BOX.CH' | base == 'SETCURS.CH' | base == 'ACHOICE.CH' | base == 'DIRECTRY.CH' | base == 'MEMOEDIT.CH' | base == 'DBEDIT.CH' | base == 'RDDSYS.CH' | base == 'HBDYN.CH' | base == 'HBGTINFO.CH' | base == 'HBINKEY.CH' then do
    out = ''
    if base == 'COMMON.CH' then out = '#define HB_COMMON_CH_'
    if base == 'SETCURS.CH' then out = '#define SC_NONE 0' || nl3 || '#define SC_NORMAL 1' || nl3 || '#define SC_INSERT 2' || nl3 || '#define SC_SPECIAL1 3' || nl3 || '#define SC_SPECIAL2 4'
    if base == 'BOX.CH' then out = '#define B_SINGLE "' || d2c(218) || d2c(196) || d2c(191) || d2c(179) || d2c(217) || d2c(196) || d2c(192) || d2c(179) || '"'
    if base == 'DIRECTRY.CH' then out = '#define F_NAME 1' || nl3 || '#define F_SIZE 2' || nl3 || '#define F_DATE 3' || nl3 || '#define F_TIME 4' || nl3 || '#define F_ATT 5'
    if out == '' then out = '#define HB_STD_CH_'
    return out
  end
  if base == 'FILEIO.CH' then do
    return '#define FO_READ 0' || nl3 || '#define FO_WRITE 1' || nl3 || '#define FO_READWRITE 2' || nl3 || '#define FO_COMPAT 0' || nl3 || '#define FO_EXCLUSIVE 16' || nl3 || '#define FO_DENYWRITE 32' || nl3 || '#define FO_DENYREAD 48' || nl3 || '#define FO_DENYNONE 64' || nl3 || '#define FO_SHARED 64' || nl3 || '#define FC_NORMAL 0' || nl3 || '#define FS_SET 0' || nl3 || '#define FS_RELATIVE 1' || nl3 || '#define FS_END 2' || nl3 || '#define F_ERROR -1'
  end
  if base == 'DBSTRUCT.CH' then do
    return '#define DBS_NAME 1' || nl3 || '#define DBS_TYPE 2' || nl3 || '#define DBS_LEN 3' || nl3 || '#define DBS_DEC 4'
  end
  if base == 'ERROR.CH' then do
    return '#define ES_WHOCARES 0' || nl3 || '#define ES_WARNING 1' || nl3 || '#define ES_ERROR 2' || nl3 || '#define ES_CATASTROPHIC 3' || nl3 || '#define EG_ARG 1' || nl3 || '#define EG_BOUND 2' || nl3 || '#define EG_STROVERFLOW 3' || nl3 || '#define EG_NUMOVERFLOW 4' || nl3 || '#define EG_ZERODIV 5' || nl3 || '#define EG_NUMERR 6' || nl3 || '#define EG_SYNTAX 7' || nl3 || '#define EG_COMPLEXITY 8' || nl3 || '#define EG_MEM 11' || nl3 || '#define EG_NOFUNC 12' || nl3 || '#define EG_NOMETHOD 13' || nl3 || '#define EG_NOVAR 14' || nl3 || '#define EG_NOALIAS 15' || nl3 || '#define EG_NOVARMETHOD 16' || nl3 || '#define EG_BADALIAS 17' || nl3 || '#define EG_DUPALIAS 18' || nl3 || '#define EG_CREATE 20' || nl3 || '#define EG_OPEN 21' || nl3 || '#define EG_CLOSE 22' || nl3 || '#define EG_READ 23' || nl3 || '#define EG_WRITE 24' || nl3 || '#define EG_PRINT 25' || nl3 || '#define EG_UNSUPPORTED 30' || nl3 || '#define EG_LIMIT 31' || nl3 || '#define EG_CORRUPTION 32' || nl3 || '#define EG_DATATYPE 33' || nl3 || '#define EG_DATAWIDTH 34' || nl3 || '#define EG_NOTABLE 35' || nl3 || '#define EG_NOORDER 36' || nl3 || '#define EG_SHARED 37' || nl3 || '#define EG_UNLOCKED 38' || nl3 || '#define EG_READONLY 39' || nl3 || '#define EG_APPENDLOCK 40'
  end
  return ''

/* ===================================================================== */
/*                      PARSER: SCOPES AND EXPRESSIONS                   */
/* ===================================================================== */
perrflag = 0
perrmsg = ''
macrodepth = 0

perr: procedure = .void
  arg msg = .string
  if perrflag = 0 then do
    perrflag = 1
    perrmsg = msg
    perrline = tl[tp]
  end
  tp = ntok
  return
perrline = 0

curk: procedure = .int
  return tk[tp]

adv: procedure = .void
  if tp < ntok then tp = tp + 1
  return

isop: procedure = .int
  arg s = .string
  if tk[tp] = 4 then do
    if ts[tp] == s then return 1
  end
  return 0

isword: procedure = .int
  arg s = .string
  if tk[tp] = 1 then do
    if ts[tp] == s then return 1
  end
  return 0

nextisop: procedure = .int
  arg s = .string
  if tp < ntok then do
    if tk[tp + 1] = 4 then do
      if ts[tp + 1] == s then return 1
    end
  end
  return 0

nextisword: procedure = .int
  arg s = .string
  if tp < ntok then do
    if tk[tp + 1] = 1 then do
      if ts[tp + 1] == s then return 1
    end
  end
  return 0

expectop: procedure = .void
  arg s = .string
  if isop(s) = 1 then call adv
  else call perr 'Syntax error: expected ' || s || ' near ' || ts[tp]
  return

skipeol: procedure = .void
  do while tk[tp] = 5
    call adv
  end
  return

atend: procedure = .int
  if tk[tp] = 5 | tk[tp] = 8 then return 1
  return 0

/* ------------------------------------------------------------- contexts */
newctx: procedure = .int
  arg kind = .int, par = .int
  ncx = ncx + 1
  cxkind[ncx] = kind
  cxpar[ncx] = par
  cxnslot[ncx] = 0
  cxncap[ncx] = 0
  return ncx

declvar: procedure = .int
  arg sym = .int, kind = .int, idx = .int
  nvar = nvar + 1
  vname[nvar] = sym
  vctx[nvar] = curcx
  vkind[nvar] = kind
  vidx[nvar] = idx
  vsrck[nvar] = 0
  vsrci[nvar] = 0
  return nvar

newslot: procedure = .int
  cxnslot[curcx] = cxnslot[curcx] + 1
  return cxnslot[curcx]

findvarin: procedure = .int
  arg cx = .int, sym = .int
  i = nvar
  do while i >= 1
    if vname[i] = sym then do
      if vctx[i] = cx then return i
    end
    i = i - 1
  end
  return 0

rk = 0
ri = 0
resolvein: procedure = .int
  arg cx = .int, sym = .int
  v = findvarin(cx, sym)
  if v > 0 then do
    rk = vkind[v]
    ri = vidx[v]
    return 1
  end
  if cxkind[cx] = 1 then do
    par = cxpar[cx]
    if resolvein(par, sym) = 1 then do
      if rk = 2 then return 1
      sk = rk
      si = ri
      if sk = 3 then sk = 2
      idx = cxncap[cx] + 1
      cxncap[cx] = idx
      nvar = nvar + 1
      vname[nvar] = sym
      vctx[nvar] = cx
      vkind[nvar] = 3
      vidx[nvar] = idx
      vsrck[nvar] = sk
      vsrci[nvar] = si
      rk = 3
      ri = idx
      return 1
    end
  end
  return 0

/* a variable reference node, or 0 if the name is not a LOCAL or STATIC */
resolve: procedure = .int
  arg sym = .int
  if curcx > 0 then do
    if resolvein(curcx, sym) = 1 then do
      if rk = 1 then return mknode(2, ri, 0, 0)
      if rk = 2 then return mknode(4, ri, 0, 0)
      return mknode(3, ri, 0, 0)
    end
  end
  do i = nmst to 1 by -1
    if mstname[i] = sym then return mknode(4, mstidx[i], 0, 0)
  end
  return 0

constnode: procedure = .int
  arg v = .int
  return mknode(1, v, 0, 0)

/* ------------------------------------------------------------ expressions */
/* link a list: returns the head; appends via tail */
parseexpr: procedure = .int
  return parseassign()

isassignable: procedure = .int
  arg n = .int
  k = nt[n]
  if k = 2 | k = 3 | k = 4 | k = 5 | k = 36 | k = 37 | k = 38 | k = 30 | k = 41 then return 1
  if k = 34 then do
    if ne[n] = 1 then return 1
  end
  return 0

parseassign: procedure = .int
  lhs = parseor()
  if tk[tp] <> 4 then return lhs
  op = ts[tp]
  if op == ':=' then do
    if isassignable(lhs) = 0 then do
      call perr 'Syntax error: invalid assignment target'
      return lhs
    end
    call adv
    rhs = parseassign()
    return mknode(25, lhs, rhs, 0)
  end
  bk = 0
  if op == '+=' then bk = 7
  else if op == '-=' then bk = 8
  else if op == '*=' then bk = 9
  else if op == '/=' then bk = 10
  else if op == '%=' then bk = 11
  else if op == '^=' | op == '**=' then bk = 12
  if bk = 0 then return lhs
  if isassignable(lhs) = 0 then do
    call perr 'Syntax error: invalid assignment target'
    return lhs
  end
  call adv
  rhs = parseassign()
  return mknode(25, lhs, mknode(bk, lhs, rhs, 0), 0)

parseor: procedure = .int
  l = parseand()
  do while isop('.OR.') = 1
    call adv
    r = parseand()
    l = mknode(24, l, r, 0)
  end
  return l

parseand: procedure = .int
  l = parsenot()
  do while isop('.AND.') = 1
    call adv
    r = parsenot()
    l = mknode(23, l, r, 0)
  end
  return l

parsenot: procedure = .int
  if isop('.NOT.') = 1 | isop('!') = 1 then do
    call adv
    e = parsenot()
    return mknode(14, e, 0, 0)
  end
  return parsecmp()

parsecmp: procedure = .int
  l = parseadd()
  do forever
    if tk[tp] <> 4 then leave
    op = ts[tp]
    k = 0
    if op == '=' then k = 15
    else if op == '==' then k = 16
    else if op == '!=' | op == '<>' | op == '#' then k = 17
    else if op == '<' then k = 18
    else if op == '<=' then k = 19
    else if op == '>' then k = 20
    else if op == '>=' then k = 21
    else if op == '$' then k = 22
    if k = 0 then leave
    call adv
    r = parseadd()
    l = mknode(k, l, r, 0)
  end
  return l

parseadd: procedure = .int
  l = parsemul()
  do forever
    if tk[tp] <> 4 then leave
    op = ts[tp]
    if op == '+' then k = 7
    else if op == '-' then k = 8
    else leave
    call adv
    r = parsemul()
    l = mknode(k, l, r, 0)
  end
  return l

parsemul: procedure = .int
  l = parseunary()
  do forever
    if tk[tp] <> 4 then leave
    op = ts[tp]
    if op == '*' then k = 9
    else if op == '/' then k = 10
    else if op == '%' then k = 11
    else leave
    call adv
    r = parseunary()
    l = mknode(k, l, r, 0)
  end
  return l

parseunary: procedure = .int
  if tk[tp] = 4 then do
    op = ts[tp]
    if op == '-' then do
      call adv
      e = parseunary()
      /* fold literal numbers */
      if nt[e] = 1 then do
        v = na[e]
        if isnum(v) = 1 then do
          if v < 0 then return constnode(mkint(0 - intval(v)))
          nv2 = newcell(1)
          cnum[nv2] = 0.0 - cnum[v]
          cint[nv2] = cint[v]
          return constnode(nv2)
        end
      end
      return mknode(13, e, 0, 0)
    end
    if op == '+' then do
      call adv
      return parseunary()
    end
    if op == '++' then do
      call adv
      e = parseunary()
      return mknode(26, e, 0, 0)
    end
    if op == '--' then do
      call adv
      e = parseunary()
      return mknode(27, e, 0, 0)
    end
  end
  return parsepow()

parsepow: procedure = .int
  l = parsepostfix()
  do while isop('^') = 1 | isop('**') = 1
    call adv
    r = parseunary()
    l = mknode(12, l, r, 0)
  end
  return l

/* argument list inside ( ); the opening ( is consumed. Returns head, sets argcount */
argcount = 0
parseargs: procedure = .int
  head = 0
  tail = 0
  cnt = 0
  if isop(')') = 1 then do
    call adv
    argcount = 0
    return 0
  end
  do forever
    if isop(',') = 1 | isop(')') = 1 then e = constnode(0)
    else e = parseexpr()
    cnt = cnt + 1
    if head = 0 then head = e
    else nx[tail] = e
    tail = e
    if isop(',') = 1 then do
      call adv
      iterate
    end
    leave
  end
  call expectop ')'
  argcount = cnt
  return head

parsepostfix: procedure = .int
  e = parseprimary()
  do forever
    if tk[tp] <> 4 then leave
    op = ts[tp]
    if op == '[' then do
      call adv
      ix = parseexpr()
      e = mknode(30, e, ix, 0)
      do while isop(',') = 1
        call adv
        ix = parseexpr()
        e = mknode(30, e, ix, 0)
      end
      call expectop ']'
      iterate
    end
    if op == ':' then do
      call adv
      if tk[tp] <> 1 then do
        call perr 'Syntax error: message name expected'
        return e
      end
      msg = tv[tp]
      call adv
      if isop('(') = 1 then do
        call adv
        args = parseargs()
        cnt = argcount
        e = mknode(34, e, msg, args)
        nd[e] = cnt
        ne[e] = 0
      end
      else do
        e = mknode(34, e, msg, 0)
        nd[e] = 0
        ne[e] = 1
      end
      iterate
    end
    if op == '++' then do
      call adv
      e = mknode(28, e, 0, 0)
      iterate
    end
    if op == '--' then do
      call adv
      e = mknode(29, e, 0, 0)
      iterate
    end
    leave
  end
  return e

numconst: procedure = .int
  arg t = .string
  d = 0
  p = pos('.', t)
  if p > 0 then d = length(t) - p
  if d = 0 & pos('E', upper(t)) = 0 & length(t) < 18 then do
    n = t as .int
    return mkint(n)
  end
  x = t as .float
  w = length(t)
  if w < 3 then w = 3
  if pos('E', upper(t)) > 0 then do
    d = 0
    w = 10
  end
  c = newcell(1)
  cnum[c] = x
  cint[c] = w * 256 + d
  return c

ymd2jdn: procedure = .int
  arg y = .int, m = .int, d = .int
  a = (14 - m) / 12
  yy = y + 4800 - a
  mm = m + 12 * a - 3
  return d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400 - 32045

datelit: procedure = .int
  arg t = .string
  if length(t) < 8 then return mkdate(0)
  y = substr(t, 1, 4) as .int
  m = substr(t, 5, 2) as .int
  d = substr(t, 7, 2) as .int
  if y = 0 & m = 0 & d = 0 then return mkdate(0)
  return mkdate(ymd2jdn(y, m, d))

parseprimary: procedure = .int
  k = tk[tp]
  if k = 2 then do
    v = numconst(ts[tp])
    call adv
    return constnode(v)
  end
  if k = 3 then do
    v = mkstr(ts[tp])
    call adv
    return constnode(v)
  end
  if k = 7 then do
    v = 1
    if ts[tp] == 'T' then v = 2
    call adv
    return constnode(v)
  end
  if k = 6 then do
    v = datelit(ts[tp])
    call adv
    return constnode(v)
  end
  if k = 1 then return parseident()
  if k = 4 then do
    op = ts[tp]
    if op == '(' then do
      call adv
      e = parseexpr()
      call expectop ')'
      if isop('->') = 1 then do
        call adv
        return parsealiased(e)
      end
      /* a parenthesised expression is never an assignment target */
      return mknode(43, e, 0, 0)
    end
    if op == '{' then return parsebrace()
    if op == '@' then do
      call adv
      if tk[tp] = 1 then do
        sym = tv[tp]
        if nextisop('(') = 0 then do
          e = parsepostfix()
          return mknode(40, e, 0, 0)
        end
        /* @Func() : function pointer */
        call adv
        call adv
        call expectop ')'
        return mknode(44, sym, 0, 0)
      end
      e = parsepostfix()
      return mknode(40, e, 0, 0)
    end
    if op == '&' then do
      call adv
      if isop('(') = 1 then do
        call adv
        e = parseexpr()
        call expectop ')'
        return mknode(41, e, 0, 0)
      end
      if tk[tp] = 1 then do
        sym = tv[tp]
        call adv
        v = resolve(sym)
        if v = 0 then v = mknode(5, sym, 0, 0)
        n = mknode(41, v, 0, 0)
        /* &var.text : trailing dot ends the macro name */
        if isop('.') = 1 & tsp[tp] = 0 then do
          call adv
        end
        return n
      end
      call perr 'Syntax error: macro operator'
      return constnode(0)
    end
    if op == '::' then do
      call adv
      if tk[tp] <> 1 then do
        call perr 'Syntax error: message name expected after ::'
        return constnode(0)
      end
      msg = tv[tp]
      call adv
      selfn = mknode(35, 0, 0, 0)
      if isop(':') = 1 & tp < ntok then do
        if tk[tp + 1] = 1 then do
          /* ::Class:Method( ) calls the method of that class on Self */
          na[selfn] = 2
          nb[selfn] = msg
          call adv
          msg = tv[tp]
          call adv
        end
      end
      if isop('(') = 1 then do
        call adv
        args = parseargs()
        cnt = argcount
        e = mknode(34, selfn, msg, args)
        nd[e] = cnt
        ne[e] = 0
        return e
      end
      e = mknode(34, selfn, msg, 0)
      nd[e] = 0
      ne[e] = 1
      return e
    end
  end
  call perr 'Syntax error near ' || ts[tp]
  return constnode(0)

/* the thing after "alias->" : field name or (expression) */
parsealiased: procedure = .int
  arg al = .int
  if tk[tp] = 1 then do
    sym = tv[tp]
    call adv
    n = mknode(38, al, sym, 0)
    return n
  end
  if isop('(') = 1 then do
    call adv
    e = parseexpr()
    call expectop ')'
    return mknode(39, al, e, 0)
  end
  call perr 'Syntax error after ->'
  return constnode(0)

parseident: procedure = .int
  name = ts[tp]
  sym = tv[tp]
  call adv
  if isop('->') = 1 then do
    call adv
    if name == 'M' | name == 'MEMVAR' then do
      if tk[tp] = 1 then do
        s2 = tv[tp]
        call adv
        return mknode(36, s2, 0, 0)
      end
    end
    if name == 'FIELD' | name == '_FIELD' then do
      if tk[tp] = 1 then do
        s2 = tv[tp]
        call adv
        return mknode(37, s2, 0, 0)
      end
    end
    al = constnode(mkstr(name))
    return parsealiased(al)
  end
  if isop('(') = 1 then do
    call adv
    args = parseargs()
    cnt = argcount
    if (name == 'IIF' | name == 'IF') & cnt = 3 then do
      c1n = args
      c2n = nx[c1n]
      c3n = nx[c2n]
      return mknode(42, c1n, c2n, c3n)
    end
    e = mknode(6, sym, args, cnt)
    return e
  end
  if name == 'NIL' then return constnode(0)
  if name == 'SELF' then return mknode(35, 0, 0, 0)
  if name == 'SUPER' then return mknode(35, 1, 0, 0)
  v = resolve(sym)
  if v > 0 then return v
  return mknode(5, sym, 0, 0)

/* { ... } : array, hash or code block */
parsebrace: procedure = .int
  call adv
  if isop('|') = 1 then return parseblock()
  /* empty hash {=>} */
  if isop('=>') = 1 then do
    call adv
    call expectop '}'
    return mknode(32, 0, 0, 0)
  end
  if isop('}') = 1 then do
    call adv
    return mknode(31, 0, 0, 0)
  end
  head = 0
  tail = 0
  cnt = 0
  ishash = 0
  do forever
    e = parseexpr()
    if cnt = 0 & isop('=>') = 1 then ishash = 1
    if ishash = 1 then do
      call expectop '=>'
      v = parseexpr()
      nx[e] = v
      if head = 0 then head = e
      else nx[tail] = e
      tail = v
    end
    else do
      if head = 0 then head = e
      else nx[tail] = e
      tail = e
    end
    cnt = cnt + 1
    if isop(',') = 1 then do
      call adv
      iterate
    end
    leave
  end
  call expectop '}'
  if ishash = 1 then return mknode(32, head, cnt, 0)
  return mknode(31, head, cnt, 0)

parseblock: procedure = .int
  /* current token is the opening | */
  call adv
  oldcx = curcx
  cx = newctx(1, oldcx)
  curcx = cx
  np = 0
  do while isop('|') = 0
    if tk[tp] <> 1 then do
      call perr 'Syntax error in code block parameters'
      curcx = oldcx
      return constnode(0)
    end
    s = tv[tp]
    call adv
    np = np + 1
    sl = newslot()
    junk = declvar(s, 1, sl)
    if isop(',') = 1 then call adv
  end
  call adv
  head = 0
  tail = 0
  if isop('}') = 0 then do
    do forever
      e = parseexpr()
      if head = 0 then head = e
      else nx[tail] = e
      tail = e
      if isop(',') = 1 then do
        call adv
        iterate
      end
      leave
    end
  end
  else head = constnode(0)
  call expectop '}'
  /* capture list */
  chead = 0
  ctail = 0
  do i = 1 to cxncap[cx]
    do j = nvar to 1 by -1
      if vctx[j] = cx & vkind[j] = 3 & vidx[j] = i then do
        cn = mknode(64, vsrck[j], vsrci[j], 0)
        if chead = 0 then chead = cn
        else nx[ctail] = cn
        ctail = cn
        leave
      end
    end
  end
  curcx = oldcx
  b = mknode(33, head, np, cxnslot[cx])
  nd[b] = chead
  nf[b] = cxncap[cx]
  return b

/* ===================================================================== */
/*                         PARSER: STATEMENTS                            */
/* ===================================================================== */
listcount = 0

/* comma separated expressions; returns head, sets listcount */
parselist: procedure = .int
  head = 0
  tail = 0
  cnt = 0
  do forever
    e = parseexpr()
    cnt = cnt + 1
    if head = 0 then head = e
    else nx[tail] = e
    tail = e
    if isop(',') = 1 then do
      call adv
      iterate
    end
    leave
  end
  listcount = cnt
  return head

/* adjacent tokens joined into one string constant (file names, aliases) */
bareword: procedure = .int
  s = tor[tp]
  call adv
  do while tsp[tp] = 0 & tk[tp] <> 5 & tk[tp] <> 8
    s = s || tor[tp]
    call adv
  end
  return constnode(mkstr(s))

/* a file name: string, expression in parentheses, macro or bare word */
filearg: procedure = .int
  if tk[tp] = 3 | isop('(') = 1 | isop('&') = 1 then return parseexpr()
  if tk[tp] = 1 | tk[tp] = 4 then return bareword()
  return parseexpr()

/* a name that may be a bare word: alias, area */
aliasarg: procedure = .int
  if tk[tp] = 1 then do
    s = ts[tp]
    call adv
    return constnode(mkstr(s))
  end
  return parseexpr()

endkw: procedure = .int
  /* current token is an END-like keyword for a construct; consume END [word] */
  return 0

iscloser: procedure = .int
  if tk[tp] <> 1 then return 0
  w = ts[tp]
  if w == 'ELSE' | w == 'ELSEIF' | w == 'ENDIF' | w == 'ENDDO' | w == 'NEXT' | w == 'ENDCASE' | w == 'CASE' | w == 'OTHERWISE' | w == 'END' | w == 'ENDSWITCH' | w == 'ENDWITH' | w == 'RECOVER' | w == 'ALWAYS' | w == 'CATCH' | w == 'FINALLY' | w == 'ENDTRY' | w == 'ENDCLASS' | w == 'FUNCTION' | w == 'PROCEDURE' | w == 'METHOD' | w == 'ENDTEXT' then return 1
  if w == 'STATIC' | w == 'INIT' | w == 'EXIT' then do
    if nextisword('FUNCTION') = 1 | nextisword('PROCEDURE') = 1 then return 1
  end
  if w == 'CREATE' then do
    if nextisword('CLASS') = 1 then return 1
  end
  if w == 'FUNC' | w == 'PROC' then return 1
  return 0

/* statements until a closer keyword or the end of input */
parsestmts: procedure = .int
  head = 0
  tail = 0
  do forever
    call skipeol
    if tk[tp] = 8 then leave
    if iscloser() = 1 then leave
    if perrflag = 1 then leave
    st = parsestmt()
    if st = 0 then iterate
    if head = 0 then head = st
    else nx[tail] = st
    tail = st
    do while nx[tail] > 0
      tail = nx[tail]
    end
  end
  return mknode(46, head, 0, 0)

/* consume the rest of the line */
skipline: procedure = .void
  do while tk[tp] <> 5 & tk[tp] <> 8
    call adv
  end
  return

/* END / ENDIF etc.: consume, optionally followed by a word like IF */
closewith: procedure = .void
  arg specific = .string
  if isword(specific) = 1 then do
    call adv
    return
  end
  if isword('END') = 1 then do
    call adv
    if tk[tp] = 1 then do
      w = ts[tp]
      if w == 'IF' | w == 'DO' | w == 'CASE' | w == 'SEQUENCE' | w == 'SWITCH' | w == 'WITH' | w == 'TRY' | w == 'CLASS' | w == 'TEXT' then call adv
    end
    return
  end
  call perr 'Syntax error: ' || specific || ' expected near line ' || tl[tp]
  return

isassignop: procedure = .int
  /* is the next token (after the current identifier) an assignment-like operator? */
  if tp >= ntok then return 0
  if tk[tp + 1] <> 4 then return 0
  o = ts[tp + 1]
  if o == ':=' | o == '+=' | o == '-=' | o == '*=' | o == '/=' | o == '%=' | o == '^=' | o == '**=' | o == '=' | o == '++' | o == '--' | o == '->' | o == ':' | o == '[' | o == '.' then return 1
  return 0

parsestmt: procedure = .int
  curline = tl[tp]
  k = tk[tp]
  if k = 4 then do
    o = ts[tp]
    if o == '?' | o == '??' then return parseprint()
    if o == '@' then do
      if tp < ntok then do
        if tk[tp + 1] = 1 then return parseat()
        if tk[tp + 1] = 4 then return parseexprstmt()
      end
      return parseat()
    end
    if o == '!' then do
      call skipline
      return 0
    end
    return parseexprstmt()
  end
  if k <> 1 then do
    call perr 'Syntax error near ' || ts[tp]
    return 0
  end
  w = ts[tp]
  /* names followed by an operator are expressions, not commands */
  if isassignop() = 1 then return parseexprstmt()
  if tp < ntok then do
    if tk[tp + 1] = 4 then do
      if ts[tp + 1] == '(' then do
        if w <> 'USE' & w <> 'GO' & w <> 'GOTO' & w <> 'SKIP' & w <> 'SELECT' & w <> 'SEEK' & w <> 'IF' & w <> 'WHILE' & w <> 'RETURN' & w <> 'DO' & w <> 'FOR' & w <> 'CASE' & w <> 'ELSEIF' & w <> 'DELETE' & w <> 'RECALL' & w <> 'SWITCH' & w <> 'ACCEPT' & w <> 'INPUT' & w <> 'WAIT' & w <> 'STORE' & w <> 'ERASE' & w <> 'RENAME' & w <> 'REPLACE' & w <> 'LOCATE' & w <> 'COUNT' & w <> 'SUM' & w <> 'LIST' & w <> 'DISPLAY' & w <> 'PRIVATE' & w <> 'PUBLIC' & w <> 'LOCAL' & w <> 'STATIC' & w <> 'BREAK' & w <> 'RELEASE' & w <> 'KEYBOARD' then return parseexprstmt()
      end
    end
  end
  if w == 'IF' then return parseif()
  if w == 'DO' then return parsedo()
  if w == 'WHILE' then return parsewhile()
  if w == 'FOR' then return parsefor()
  if w == 'LOCAL' then return parselocal()
  if w == 'RETURN' then do
    call adv
    e = 0
    if atend() = 0 then e = parseexpr()
    return mknode(56, e, 0, 0)
  end
  if w == 'EXIT' then do
    call adv
    return mknode(54, 0, 0, 0)
  end
  if w == 'LOOP' then do
    call adv
    return mknode(55, 0, 0, 0)
  end
  if w == 'BREAK' then do
    call adv
    e = 0
    if atend() = 0 then e = parseexpr()
    return mknode(65, e, 0, 0)
  end
  if w == 'BEGIN' then return parsebegin()
  if w == 'TRY' then return parsetry()
  if w == 'SWITCH' then return parseswitch()
  if w == 'STATIC' then return parsestatic()
  if w == 'PRIVATE' | w == 'PUBLIC' then return parsemem()
  if w == 'PARAMETERS' | w == 'LPARAMETERS' then return parseparameters()
  if w == 'WITH' then do
    call perr 'WITH OBJECT is not supported'
    return 0
  end
  if w == 'TEXT' then return parsetext()
  if w == 'MEMVAR' | w == 'FIELD' | w == 'DECLARE' | w == 'EXTERNAL' | w == 'REQUEST' | w == 'DYNAMIC' | w == 'ANNOUNCE' | w == 'NOTE' then do
    call skipline
    return 0
  end
  if w == 'ENDIF' | w == 'ENDDO' | w == 'NEXT' then do
    call perr 'Syntax error: unexpected ' || w
    return 0
  end
  c = parsecmd(w)
  if c <> 0 then return c
  if perrflag = 1 then return 0
  return parseexprstmt()

/* expression statement: a call, an assignment, x++ ... */
parseexprstmt: procedure = .int
  e = parseexpr()
  if nt[e] = 15 then do
    l = na[e]
    if isassignable(l) = 1 then e = mknode(25, l, nb[e], 0)
  end
  if atend() = 0 & perrflag = 0 then call perr 'Syntax error near ' || ts[tp]
  return mknode(47, e, 0, 0)

parseprint: procedure = .int
  kind = 1
  if ts[tp] == '??' then kind = 2
  call adv
  head = 0
  if atend() = 0 then head = parselist()
  n = mknode(58, head, kind, 0)
  /* ignore trailing PICTURE etc. */
  call skipline
  return n

parseif: procedure = .int
  call adv
  cond = parseexpr()
  call skipline
  thenb = parsestmts()
  elseb = 0
  if isword('ELSEIF') = 1 then do
    elseb = parseif()
    return mknode(48, cond, thenb, elseb)
  end
  if isword('ELSE') = 1 then do
    call adv
    call skipline
    elseb = parsestmts()
  end
  call closewith 'ENDIF'
  return mknode(48, cond, thenb, elseb)

parsewhile: procedure = .int
  call adv
  cond = parseexpr()
  call skipline
  body = parsestmts()
  call closewith 'ENDDO'
  return mknode(49, cond, body, 0)

parsedo: procedure = .int
  call adv
  if isword('WHILE') = 1 then return parsewhile()
  if isword('CASE') = 1 then do
    call adv
    call skipline
    return parsedocase()
  end
  /* DO proc [WITH args] */
  if tk[tp] <> 1 then do
    call perr 'Syntax error after DO'
    return 0
  end
  sym = tv[tp]
  call adv
  args = 0
  cnt = 0
  if isword('WITH') = 1 then do
    call adv
    args = parselist()
    cnt = listcount
  end
  e = mknode(6, sym, args, cnt)
  return mknode(47, e, 0, 0)

parsedocase: procedure = .int
  head = 0
  tail = 0
  do forever
    call skipeol
    if isword('CASE') = 1 then do
      call adv
      cond = parseexpr()
      call skipline
      body = parsestmts()
      cn = mknode(64, cond, body, 0)
      if head = 0 then head = cn
      else nx[tail] = cn
      tail = cn
      iterate
    end
    if isword('OTHERWISE') = 1 | isword('ELSE') = 1 then do
      call adv
      call skipline
      body = parsestmts()
      cn = mknode(64, 0, body, 0)
      if head = 0 then head = cn
      else nx[tail] = cn
      tail = cn
      iterate
    end
    leave
  end
  call closewith 'ENDCASE'
  return mknode(52, head, 0, 0)

parseswitch: procedure = .int
  call adv
  e = parseexpr()
  call skipline
  head = 0
  tail = 0
  other = 0
  do forever
    call skipeol
    if isword('CASE') = 1 then do
      call adv
      vals = parselist()
      call skipline
      body = parsestmts()
      cn = mknode(64, vals, body, 0)
      if head = 0 then head = cn
      else nx[tail] = cn
      tail = cn
      iterate
    end
    if isword('OTHERWISE') = 1 | isword('DEFAULT') = 1 then do
      call adv
      call skipline
      other = parsestmts()
      iterate
    end
    leave
  end
  call closewith 'ENDSWITCH'
  return mknode(53, e, head, other)

parsefor: procedure = .int
  call adv
  if isword('EACH') = 1 then do
    call adv
    v = parsepostfix()
    if isword('IN') = 1 then call adv
    else call perr 'Syntax error: IN expected'
    coll = parseexpr()
    desc = 0
    if isword('DESCEND') = 1 then do
      call adv
      desc = 1
    end
    call skipline
    body = parsestmts()
    call closewith 'NEXT'
    n = mknode(51, v, coll, body)
    nd[n] = desc
    return n
  end
  v = parsepostfix()
  if isop(':=') = 1 | isop('=') = 1 then call adv
  else call perr 'Syntax error: := expected in FOR'
  start = parseexpr()
  if isword('TO') = 1 then call adv
  else call perr 'Syntax error: TO expected in FOR'
  stop = parseexpr()
  step = 0
  if isword('STEP') = 1 then do
    call adv
    step = parseexpr()
  end
  call skipline
  body = parsestmts()
  call closewith 'NEXT'
  n = mknode(50, v, start, stop)
  nd[n] = step
  ne[n] = body
  return n

parsebegin: procedure = .int
  call adv
  if isword('SEQUENCE') = 0 then do
    call perr 'Syntax error: SEQUENCE expected after BEGIN'
    return 0
  end
  call adv
  if isword('WITH') = 1 then do
    call adv
    junk = parseexpr()
  end
  call skipline
  return parseseqbody()

parsetry: procedure = .int
  call adv
  call skipline
  return parseseqbody()

parseseqbody: procedure = .int
  body = parsestmts()
  rec = 0
  var = 0
  has = 0
  always = 0
  if isword('RECOVER') = 1 | isword('CATCH') = 1 then do
    call adv
    has = 1
    if isword('USING') = 1 then call adv
    if tk[tp] = 1 then do
      var = parsepostfix()
    end
    call skipline
    rec = parsestmts()
  end
  if isword('ALWAYS') = 1 | isword('FINALLY') = 1 then do
    call adv
    call skipline
    always = parsestmts()
  end
  call closewith 'ENDTRY'
  n = mknode(57, body, rec, var)
  nd[n] = always
  ne[n] = has
  return n

/* local declarations */
parselocal: procedure = .int
  call adv
  if infunc = 0 | curcx = 0 then do
    call perr 'LOCAL outside of a function'
    return 0
  end
  head = 0
  tail = 0
  do forever
    if tk[tp] <> 1 then do
      call perr 'Syntax error in LOCAL'
      leave
    end
    sym = tv[tp]
    call adv
    sl = newslot()
    junk = declvar(sym, 1, sl)
    init = 0
    if isop(':=') = 1 | isop('=') = 1 then do
      call adv
      init = parseexpr()
    end
    else if isop('[') = 1 then do
      call adv
      args = parselist()
      cnt = listcount
      call expectop ']'
      init = mknode(6, intern('ARRAY'), args, cnt)
    end
    if init > 0 then do
      st = mknode(47, mknode(25, mknode(2, sl, 0, 0), init, 0), 0, 0)
      if head = 0 then head = st
      else nx[tail] = st
      tail = st
    end
    if isop(',') = 1 then do
      call adv
      iterate
    end
    leave
  end
  if head = 0 then return 0
  return head

tail2: procedure = .int
  arg h = .int
  t = h
  do while nx[t] > 0
    t = nx[t]
  end
  return t

parsestatic: procedure = .int
  call adv
  if isword('FUNCTION') = 1 | isword('PROCEDURE') = 1 then do
    call perr 'Syntax error: nested function'
    return 0
  end
  head = 0
  tail = 0
  do forever
    if tk[tp] <> 1 then do
      call perr 'Syntax error in STATIC'
      leave
    end
    sym = tv[tp]
    call adv
    nstatic = nstatic + 1
    idx = nstatic
    sv[idx] = 0
    if infunc = 1 & curcx > 0 then junk = declvar(sym, 2, idx)
    else do
      nmst = nmst + 1
      mstname[nmst] = sym
      mstidx[nmst] = idx
    end
    init = 0
    if isop(':=') = 1 | isop('=') = 1 then do
      call adv
      init = parseexpr()
    end
    else if isop('[') = 1 then do
      call adv
      args = parselist()
      cnt = listcount
      call expectop ']'
      init = mknode(6, intern('ARRAY'), args, cnt)
    end
    if init > 0 then do
      nsvinit = nsvinit + 1
      svinit[nsvinit] = init
      svslot[nsvinit] = idx
    end
    if isop(',') = 1 then do
      call adv
      iterate
    end
    leave
  end
  return 0

parsemem: procedure = .int
  kind = 59
  if ts[tp] == 'PUBLIC' then kind = 60
  call adv
  head = 0
  tail = 0
  st = 0
  mcnt = 0
  do forever
    if isop('&') = 1 then do
      call adv
      e = parseprimary()
      st = mknode(kind, 0, 0, 0)
      nb[st] = e
      nf[st] = 1
    end
    else do
      if tk[tp] <> 1 then do
        call perr 'Syntax error in PRIVATE/PUBLIC'
        leave
      end
      sym = tv[tp]
      call adv
      init = 0
      if isop(':=') = 1 | isop('=') = 1 then do
        call adv
        init = parseexpr()
      end
      else if isop('[') = 1 then do
        call adv
        args = parselist()
        cnt = listcount
        call expectop ']'
        init = mknode(6, intern('ARRAY'), args, cnt)
      end
      st = mknode(kind, sym, init, 0)
    end
    if head = 0 then head = st
    else nx[tail] = st
    tail = st
    mcnt = mcnt + 1
    if isop(',') = 1 then do
      call adv
      iterate
    end
    leave
  end
  if head > 0 then ne[head] = mcnt
  return head

parseparameters: procedure = .int
  call adv
  head = 0
  tail = 0
  cnt = 0
  do forever
    if tk[tp] <> 1 then leave
    cn = mknode(64, tv[tp], 0, 0)
    call adv
    cnt = cnt + 1
    if head = 0 then head = cn
    else nx[tail] = cn
    tail = cn
    if isop(',') = 1 then do
      call adv
      iterate
    end
    leave
  end
  if curfn > 0 then do
    if fnpar[curfn] < cnt then fnpar[curfn] = cnt
    if cxnslot[curcx] < cnt then cxnslot[curcx] = cnt
  end
  return mknode(70, head, cnt, 0)

parsetext: procedure = .int
  call adv
  var = 0
  if isword('TO') = 1 then do
    call adv
    if isword('FILE') = 1 | isword('PRINTER') = 1 then call skipline
    else var = parsepostfix()
  end
  s = ''
  if tk[tp] = 3 then do
    s = ts[tp]
    call adv
  end
  return mknode(66, constnode(mkstr(s)), var, 0)

/* -------------------------------------------------------------- @ SAY GET */
parseat: procedure = .int
  call adv
  r = parseexpr()
  call expectop ','
  c = parseexpr()
  n = mknode(68, r, c, 0)
  hold = mknode(64, 0, 0, 0)
  nf[n] = hold
  do forever
    if atend() = 1 then leave
    if perrflag = 1 then leave
    if isword('SAY') = 1 then do
      call adv
      nc[n] = parseexpr()
      iterate
    end
    if isword('GET') = 1 then do
      call adv
      nd[n] = parsepostfix()
      iterate
    end
    if isword('PICTURE') = 1 then do
      call adv
      p = parseexpr()
      if nd[n] > 0 then nb[hold] = p
      else na[hold] = p
      iterate
    end
    if isword('VALID') = 1 then do
      call adv
      nc[hold] = parseexpr()
      iterate
    end
    if isword('WHEN') = 1 then do
      call adv
      nd[hold] = parseexpr()
      iterate
    end
    if isword('COLOR') = 1 | isword('MESSAGE') = 1 | isword('RANGE') = 1 | isword('FONT') = 1 | isword('SEND') = 1 then do
      call adv
      junk = parseexpr()
      if isop(',') = 1 then do
        call adv
        junk = parseexpr()
      end
      iterate
    end
    if isword('CLEAR') = 1 then do
      call adv
      ne[n] = 1
      if isword('TO') = 1 then do
        call adv
        junk = parseexpr()
        call expectop ','
        junk = parseexpr()
      end
      iterate
    end
    if isword('TO') = 1 then do
      call adv
      junk = parseexpr()
      call expectop ','
      junk = parseexpr()
      ne[n] = 2
      iterate
    end
    if isword('DOUBLE') = 1 | isword('BOX') = 1 then do
      call adv
      if atend() = 0 then junk = parseexpr()
      iterate
    end
    if isop(',') = 1 then do
      /* @ r1,c1,r2,c2 BOX ... */
      call adv
      junk = parseexpr()
      iterate
    end
    call perr 'Syntax error in @ command near ' || ts[tp]
    leave
  end
  return n

/* ===================================================================== */
/*                  PARSER: DATABASE AND CONSOLE COMMANDS                */
/* ===================================================================== */
mkcmd: procedure = .int
  arg cmd = .int
  return mknode(62, cmd, 0, 0)

mkscoped: procedure = .int
  arg cmd = .int
  return mknode(63, cmd, 0, 0)

/* scope, FOR and WHILE clauses; fills nf (kind) nd (n) nb (for) nc (while) */
parsescope: procedure = .void
  arg n = .int
  do forever
    if isword('ALL') = 1 then do
      call adv
      nf[n] = 1
      iterate
    end
    if isword('NEXT') = 1 then do
      call adv
      nf[n] = 2
      nd[n] = parseexpr()
      iterate
    end
    if isword('RECORD') = 1 then do
      call adv
      nf[n] = 3
      nd[n] = parseexpr()
      iterate
    end
    if isword('REST') = 1 then do
      call adv
      nf[n] = 4
      iterate
    end
    if isword('FOR') = 1 then do
      call adv
      nb[n] = parseexpr()
      iterate
    end
    if isword('WHILE') = 1 then do
      call adv
      nc[n] = parseexpr()
      iterate
    end
    leave
  end
  return

parsecmd: procedure = .int
  arg w = .string
  if w == 'USE' then do
    call adv
    n = mkcmd(2)
    if atend() = 1 then return n
    if isword('INDEX') = 0 & isword('ALIAS') = 0 & isword('NEW') = 0 then nb[n] = filearg()
    fl = 0
    do forever
      if isword('INDEX') = 1 then do
        call adv
        h = filearg()
        t = h
        do while isop(',') = 1
          call adv
          x = filearg()
          nx[t] = x
          t = x
        end
        nd[n] = h
        iterate
      end
      if isword('ALIAS') = 1 then do
        call adv
        nc[n] = aliasarg()
        iterate
      end
      if isword('NEW') = 1 then do
        call adv
        fl = fl + 1
        iterate
      end
      if isword('EXCLUSIVE') = 1 then do
        call adv
        iterate
      end
      if isword('SHARED') = 1 then do
        call adv
        iterate
      end
      if isword('READONLY') = 1 then do
        call adv
        fl = fl + 8
        iterate
      end
      if isword('VIA') = 1 then do
        call adv
        junk = parseexpr()
        iterate
      end
      leave
    end
    nf[n] = fl
    return n
  end
  if w == 'SELECT' then do
    call adv
    n = mkcmd(3)
    nb[n] = aliasarg()
    return n
  end
  if w == 'GO' | w == 'GOTO' then do
    call adv
    n = mkcmd(4)
    if isword('TOP') = 1 then do
      call adv
      nf[n] = 1
    end
    else if isword('BOTTOM') = 1 then do
      call adv
      nf[n] = 2
    end
    else do
      if isword('RECORD') = 1 then call adv
      nb[n] = parseexpr()
    end
    if isword('IN') = 1 then do
      call adv
      nc[n] = aliasarg()
    end
    return n
  end
  if w == 'SKIP' then do
    call adv
    n = mkcmd(5)
    if atend() = 0 & isword('ALIAS') = 0 & isword('IN') = 0 then nb[n] = parseexpr()
    if isword('ALIAS') = 1 | isword('IN') = 1 then do
      call adv
      nc[n] = aliasarg()
    end
    return n
  end
  if w == 'SEEK' then do
    call adv
    n = mkcmd(13)
    nb[n] = parseexpr()
    do forever
      if isword('SOFTSEEK') = 1 then do
        call adv
        nf[n] = nf[n] + 1
        iterate
      end
      if isword('LAST') = 1 then do
        call adv
        iterate
      end
      leave
    end
    return n
  end
  if w == 'APPEND' then do
    call adv
    n = mkcmd(6)
    if isword('BLANK') = 1 then do
      call adv
      nf[n] = 1
      return n
    end
    if isword('FROM') = 1 then do
      call adv
      nf[n] = 2
      nb[n] = filearg()
      if isword('FOR') = 1 then do
        call adv
        nd[n] = parseexpr()
      end
      call skipline
      return n
    end
    nf[n] = 1
    return n
  end
  if w == 'DELETE' | w == 'RECALL' | w == 'COUNT' | w == 'SUM' | w == 'AVERAGE' | w == 'LIST' | w == 'DISPLAY' | w == 'LOCATE' | w == 'REPLACE' | w == 'COPY' | w == 'TOTAL' then
    return parsescopedcmd(w)
  if w == 'CONTINUE' then do
    call adv
    return mkcmd(15)
  end
  if w == 'PACK' then do
    call adv
    return mkcmd(9)
  end
  if w == 'ZAP' then do
    call adv
    return mkcmd(10)
  end
  if w == 'COMMIT' then do
    call adv
    return mkcmd(22)
  end
  if w == 'REINDEX' then do
    call adv
    return mkcmd(36)
  end
  if w == 'INDEX' then do
    call adv
    n = mkcmd(12)
    if isword('ON') = 1 then call adv
    else call perr 'Syntax error: ON expected after INDEX'
    t0 = tp
    nb[n] = parseexpr()
    ktxt = toktext(t0, tp)
    ftxt = ''
    if isword('TO') = 1 | isword('TAG') = 1 then do
      call adv
      nc[n] = filearg()
    end
    fl = 0
    do forever
      if isword('FOR') = 1 then do
        call adv
        t0 = tp
        nd[n] = parseexpr()
        ftxt = toktext(t0, tp)
        iterate
      end
      if isword('UNIQUE') = 1 then do
        call adv
        fl = fl + 1
        iterate
      end
      if isword('DESCENDING') = 1 then do
        call adv
        fl = fl + 2
        iterate
      end
      if isword('ASCENDING') = 1 | isword('ADDITIVE') = 1 | isword('COMPACT') = 1 | isword('EVAL') = 1 | isword('EVERY') = 1 then do
        call adv
        iterate
      end
      leave
    end
    nf[n] = fl
    ns[n] = ktxt || '01'x || ftxt
    return n
  end
  if w == 'CLOSE' then do
    call adv
    n = mkcmd(21)
    if atend() = 0 then do
      if isword('ALL') = 1 | isword('DATABASES') = 1 then do
        call adv
        nf[n] = 1
      end
      else if isword('INDEXES') = 1 then do
        call adv
        nf[n] = 2
      end
      else nb[n] = aliasarg()
    end
    call skipline
    return n
  end
  if w == 'CLEAR' | w == 'CLS' then do
    call adv
    n = mkcmd(25)
    if w == 'CLS' then nf[n] = 1
    else if isword('MEMORY') = 1 then nf[n] = 2
    else if isword('ALL') = 1 then nf[n] = 3
    else nf[n] = 1
    call skipline
    return n
  end
  if w == 'ERASE' then do
    call adv
    n = mkcmd(23)
    nb[n] = filearg()
    return n
  end
  if w == 'RENAME' then do
    call adv
    n = mkcmd(24)
    nb[n] = filearg()
    if isword('TO') = 1 then call adv
    nc[n] = filearg()
    return n
  end
  if w == 'ACCEPT' | w == 'INPUT' | w == 'WAIT' then do
    call adv
    cmd = 26
    if w == 'INPUT' then cmd = 27
    if w == 'WAIT' then cmd = 28
    n = mkcmd(cmd)
    if atend() = 0 & isword('TO') = 0 then nb[n] = parseexpr()
    if isword('TO') = 1 then do
      call adv
      nc[n] = parsepostfix()
    end
    return n
  end
  if w == 'READ' then do
    call adv
    call skipline
    return mkcmd(29)
  end
  if w == 'QUIT' | w == 'CANCEL' then do
    call adv
    call skipline
    return mkcmd(30)
  end
  if w == 'RELEASE' then do
    call adv
    n = mkcmd(31)
    if isword('ALL') = 1 then do
      call adv
      nf[n] = 1
      call skipline
      return n
    end
    nb[n] = parselist()
    return n
  end
  if w == 'STORE' then do
    call adv
    n = mkcmd(32)
    nb[n] = parseexpr()
    if isword('TO') = 1 then call adv
    else call perr 'Syntax error: TO expected after STORE'
    nc[n] = parselist()
    return n
  end
  if w == 'KEYBOARD' then do
    call adv
    n = mkcmd(39)
    nb[n] = parseexpr()
    return n
  end
  if w == 'SET' then return parseset()
  if w == 'RUN' then do
    call adv
    call skipline
    return mkcmd(40)
  end
  if w == 'SORT' | w == 'UPDATE' | w == 'JOIN' | w == 'SAVE' | w == 'RESTORE' then do
    call perr 'Command ' || w || ' is not supported'
    return 0
  end
  if w == 'CREATE' then do
    call perr 'Command CREATE is not supported (use dbCreate())'
    return 0
  end
  return 0

parsescopedcmd: procedure = .int
  arg w = .string
  call adv
  cmd = 0
  if w == 'DELETE' then cmd = 7
  if w == 'RECALL' then cmd = 8
  if w == 'COUNT' then cmd = 16
  if w == 'SUM' then cmd = 17
  if w == 'AVERAGE' then cmd = 18
  if w == 'LIST' then cmd = 19
  if w == 'DISPLAY' then cmd = 20
  if w == 'LOCATE' then cmd = 14
  if w == 'REPLACE' then cmd = 11
  if w == 'COPY' then cmd = 34
  if w == 'TOTAL' then cmd = 41
  n = mkscoped(cmd)
  hold = mknode(64, 0, 0, 0)
  ne[n] = hold
  if cmd = 11 then do
    call parsescope(n)
    head = 0
    tail = 0
    do forever
      if tk[tp] <> 1 then do
        call perr 'Syntax error in REPLACE'
        leave
      end
      fld = fieldref()
      if isword('WITH') = 1 then call adv
      else call perr 'Syntax error: WITH expected'
      v = parseexpr()
      nx[fld] = v
      if head = 0 then head = fld
      else nx[tail] = fld
      tail = v
      if isop(',') = 1 then do
        call adv
        iterate
      end
      leave
    end
    na[hold] = head
  end
  else if cmd = 16 then do
    if isword('TO') = 1 then do
      call adv
      na[hold] = parsepostfix()
    end
  end
  else if cmd = 17 | cmd = 18 then do
    if isword('TO') = 0 & isword('FOR') = 0 & isword('WHILE') = 0 & isword('ALL') = 0 & isword('NEXT') = 0 & isword('REST') = 0 then do
      na[hold] = parselist()
      nc[hold] = listcount
    end
    if isword('TO') = 1 then do
      call adv
      nb[hold] = parselist()
    end
  end
  else if cmd = 19 | cmd = 20 then do
    if isword('STRUCTURE') = 1 then do
      call adv
      nf[hold] = 1
    end
    else do
      do forever
        if isword('OFF') = 1 then do
          call adv
          nd[hold] = 1
          iterate
        end
        if isword('FIELDS') = 1 then call adv
        leave
      end
      if atend() = 0 & isword('ALL') = 0 & isword('NEXT') = 0 & isword('REST') = 0 & isword('FOR') = 0 & isword('WHILE') = 0 & isword('TO') = 0 & isword('RECORD') = 0 then do
        na[hold] = parselist()
      end
    end
  end
  else if cmd = 34 then do
    if isword('STRUCTURE') = 1 then do
      call adv
      nf[hold] = 1
      if isword('EXTENDED') = 1 then call adv
    end
    if isword('TO') = 1 then do
      call adv
      nb[hold] = filearg()
    end
    if isword('FIELDS') = 1 then do
      call adv
      na[hold] = parselist()
    end
  end
  else if cmd = 14 then do
  end
  call parsescope(n)
  if cmd = 19 | cmd = 20 then do
    if isword('TO') = 1 then call skipline
  end
  if cmd = 34 then do
    if isword('TO') = 1 then do
      call adv
      nb[hold] = filearg()
    end
  end
  if cmd = 17 | cmd = 18 then do
    if isword('TO') = 1 then do
      call adv
      nb[hold] = parselist()
    end
  end
  if cmd = 16 then do
    if isword('TO') = 1 then do
      call adv
      na[hold] = parsepostfix()
    end
  end
  return n

/* a field reference in a command: name or alias->name */
fieldref: procedure = .int
  sym = tv[tp]
  name = ts[tp]
  call adv
  if isop('->') = 1 then do
    call adv
    if tk[tp] = 1 then do
      s2 = tv[tp]
      call adv
      return mknode(38, constnode(mkstr(name)), s2, 0)
    end
    call perr 'Syntax error after ->'
    return constnode(0)
  end
  return mknode(37, sym, 0, 0)

parseset: procedure = .int
  call adv
  if tk[tp] <> 1 then do
    call perr 'Syntax error after SET'
    return 0
  end
  name = ts[tp]
  call adv
  n = mkcmd(1)
  ns[n] = name
  if name == 'COLOR' | name == 'CURSOR' | name == 'KEY' | name == 'FUNCTION' | name == 'MESSAGE' | name == 'WRAP' | name == 'SCOREBOARD' | name == 'INTENSITY' | name == 'TYPEAHEAD' | name == 'DEVICE' | name == 'PRINTER' | name == 'MARGIN' | name == 'CONFIRM' | name == 'EVENTMASK' | name == 'BELL' | name == 'ESCAPE' | name == 'CANCEL' | name == 'COUNT' | name == 'MULTILOCKS' | name == 'AUTOPEN' | name == 'AUTORDER' then do
    call skipline
    return n
  end
  if name == 'DATE' & isword('FORMAT') = 1 then call adv
  if name == 'ALTERNATE' & isword('TO') = 0 & isword('ON') = 0 & isword('OFF') = 0 then do
    call skipline
    return n
  end
  if isword('TO') = 1 then call adv
  if isword('ON') = 1 then do
    call adv
    nc[n] = 1
    return n
  end
  if isword('OFF') = 1 then do
    call adv
    nc[n] = 2
    return n
  end
  if name == 'INDEX' then do
    if atend() = 0 then do
      h = filearg()
      t = h
      do while isop(',') = 1
        call adv
        x = filearg()
        nx[t] = x
        t = x
      end
      nd[n] = h
    end
    return n
  end
  if name == 'RELATION' then do
    if isword('ADDITIVE') = 1 then call adv
    head = 0
    tail = 0
    do while atend() = 0
      k = parseexpr()
      if isword('INTO') = 1 then call adv
      al = aliasarg()
      nx[k] = al
      if head = 0 then head = k
      else nx[tail] = k
      tail = al
      if isop(',') = 1 then call adv
      else leave
    end
    nd[n] = head
    return n
  end
  if atend() = 1 then return n
  if tk[tp] = 1 then do
    /* a bare word value such as SET DATE ANSI, SET DEFAULT TO c:\data */
    if name == 'DATE' | name == 'DEFAULT' | name == 'PATH' | name == 'ALTERNATE' then do
      nb[n] = bareword()
      return n
    end
  end
  if name == 'DEFAULT' | name == 'PATH' then do
    nb[n] = filearg()
    return n
  end
  nb[n] = parseexpr()
  call skipline
  return n

/* source text of tokens a .. b-1 */
toktext: procedure = .string
  arg a = .int, b = .int
  r = ''
  do i = a to b - 1
    if i > a & tsp[i] = 1 then r = r || ' '
    if tk[i] = 3 then do
      if pos('"', ts[i]) = 0 then r = r || '"' || ts[i] || '"'
      else r = r || "'" || ts[i] || "'"
    end
    else r = r || tor[i]
  end
  return r

/* ===================================================================== */
/*                       PARSER: FUNCTIONS AND CLASSES                   */
/* ===================================================================== */
newfn: procedure = .int
  arg name = .string
  nfn = nfn + 1
  fnname[nfn] = name
  fnpar[nfn] = 0
  fnslots[nfn] = 0
  fnbody[nfn] = 0
  fnclass[nfn] = 0
  return nfn

/* start a function: parses the optional parameter list; leaves the context open */
savenvar = 0
beginfunc: procedure = .int
  arg name = .string
  fid = newfn(name)
  curfn = fid
  infunc = 1
  savenvar = nvar
  curcx = newctx(0, 0)
  np = 0
  if isop('(') = 1 then do
    call adv
    do while isop(')') = 0
      if tk[tp] = 4 then do
        if ts[tp] == '@' then call adv
      end
      if isop('.') = 1 then do
        /* ... */
        call adv
        call adv
        call adv
        iterate
      end
      if tk[tp] <> 1 then do
        call perr 'Syntax error in parameter list'
        leave
      end
      sym = tv[tp]
      call adv
      np = np + 1
      sl = newslot()
      junk = declvar(sym, 1, sl)
      if isword('AS') = 1 then do
        call adv
        call adv
      end
      if isop(',') = 1 then call adv
    end
    call expectop ')'
  end
  fnpar[fid] = np
  return fid

endfunc: procedure = .void
  arg fid = .int, body = .int, oldnvar = .int
  fnbody[fid] = body
  fnslots[fid] = cxnslot[curcx]
  if fnslots[fid] < fnpar[fid] then fnslots[fid] = fnpar[fid]
  nvar = oldnvar
  curcx = 0
  infunc = 0
  curfn = 0
  return

parsefuncdef: procedure = .int
  /* at FUNCTION / PROCEDURE keyword (STATIC / INIT / EXIT already consumed) */
  call adv
  if tk[tp] <> 1 then do
    call perr 'Syntax error: function name expected'
    return 0
  end
  name = ts[tp]
  sym = tv[tp]
  call adv
  fid = beginfunc(name)
  oldnvar = savenvar
  call skipline
  body = parsestmts()
  call endfunc fid, body, oldnvar
  sfn[sym] = fid
  if firstfn = 0 then firstfn = fid
  if name == 'MAIN' then mainfn = fid
  return fid

newclass: procedure = .int
  arg name = .string, par = .int
  ncls = ncls + 1
  clname[ncls] = name
  clpar[ncls] = par
  clnslot[ncls] = 0
  if par > 0 then clnslot[ncls] = clnslot[par]
  scls[intern(name)] = ncls
  return ncls

adddata: procedure = .int
  arg cls = .int, sym = .int
  s = pm_get(2, cls, sym)
  if s > 0 then return s
  clnslot[cls] = clnslot[cls] + 1
  call pm_put 2, cls, sym, clnslot[cls]
  return clnslot[cls]

parseclass: procedure = .int
  /* at CLASS */
  call adv
  if tk[tp] <> 1 then do
    call perr 'Syntax error: class name expected'
    return 0
  end
  name = ts[tp]
  call adv
  par = 0
  if isword('INHERIT') = 1 | isword('FROM') = 1 | isword('INHERITS') = 1 then do
    call adv
    if tk[tp] = 1 then do
      par = scls[tv[tp]]
      if par = 0 then call perr 'Parent class not found: ' || ts[tp]
      call adv
    end
    do while isop(',') = 1
      call adv
      call adv
    end
  end
  call skipline
  cls = newclass(name, par)
  do forever
    call skipeol
    if tk[tp] = 8 | perrflag = 1 then leave
    if tk[tp] <> 1 then do
      call skipline
      iterate
    end
    w = ts[tp]
    if w == 'ENDCLASS' then do
      call adv
      leave
    end
    if w == 'END' then do
      call adv
      if isword('CLASS') = 1 then call adv
      leave
    end
    shared = 0
    if w == 'CLASS' & (nextisword('VAR') = 1 | nextisword('DATA') = 1) then do
      call adv
      w = ts[tp]
      shared = 1
    end
    if w == 'CLASSDATA' | w == 'CLASSVAR' then shared = 1
    if w == 'VAR' | w == 'DATA' | w == 'CLASSDATA' | w == 'CLASSVAR' | w == 'MEMBER' then do
      call adv
      do forever
        if tk[tp] <> 1 then leave
        sym = tv[tp]
        call adv
        init = 0
        do forever
          if isword('AS') = 1 then do
            call adv
            call adv
            iterate
          end
          if isword('INIT') = 1 then do
            call adv
            init = parseexpr()
            iterate
          end
          if isword('READONLY') = 1 | isword('EXPORTED') = 1 | isword('VISIBLE') = 1 | isword('HIDDEN') = 1 | isword('PROTECTED') = 1 | isword('PERSISTENT') = 1 | isword('SHARED') = 1 | isword('EXPORT') = 1 then do
            call adv
            iterate
          end
          leave
        end
        if shared = 1 then do
          nstatic = nstatic + 1
          sv[nstatic] = 0
          call pm_put 3, cls, sym, nstatic
          if init > 0 then do
            nsvinit = nsvinit + 1
            svinit[nsvinit] = init
            svslot[nsvinit] = nstatic
          end
        end
        else do
          slot = adddata(cls, sym)
          if init > 0 then do
            ncinit = ncinit + 1
            cinitcls[ncinit] = cls
            cinitslot[ncinit] = slot
            cinitnode[ncinit] = init
          end
        end
        if isop(',') = 1 then do
          call adv
          iterate
        end
        leave
      end
      call skipline
      iterate
    end
    if w == 'METHOD' | w == 'ACCESS' | w == 'ASSIGN' | w == 'MESSAGE' | w == 'CONSTRUCTOR' | w == 'DESTRUCTOR' then do
      call adv
      if tk[tp] <> 1 then do
        call skipline
        iterate
      end
      mname = ts[tp]
      msym = tv[tp]
      call adv
      /* look ahead for INLINE on this line */
      inl = 0
      j = tp
      do while tk[j] <> 5 & tk[j] <> 8
        if tk[j] = 1 then do
          if ts[j] == 'INLINE' then do
            inl = j
            leave
          end
        end
        j = j + 1
      end
      if inl > 0 then do
        fid = beginfunc(mname)
        oldnvar = savenvar
        if isword('INLINE') = 1 then call adv
        e = parseexpr()
        body = mknode(46, mknode(56, e, 0, 0), 0, 0)
        call endfunc fid, body, oldnvar
        fnclass[fid] = cls
        call pm_put 1, cls, msym, fid
        call skipline
      end
      else do
        call pm_put 4, cls, msym, 1
        call skipline
      end
      iterate
    end
    call skipline
  end
  return 0

/* METHOD name( params ) CLASS cls  -- the definition with a body */
parsemethoddef: procedure = .int
  call adv
  if tk[tp] <> 1 then do
    call perr 'Syntax error: method name expected'
    return 0
  end
  mname = ts[tp]
  msym = tv[tp]
  call adv
  clsname = ''
  if isop(':') = 1 then do
    /* METHOD Class:name(...) */
    clsname = mname
    call adv
    mname = ts[tp]
    msym = tv[tp]
    call adv
  end
  fid = beginfunc(mname)
  oldnvar = savenvar
  if isword('CLASS') = 1 then do
    call adv
    clsname = ts[tp]
    call adv
  end
  if isword('CONSTRUCTOR') = 1 then call adv
  cls = scls[intern(upper(clsname))]
  if cls = 0 then do
    call perr 'Class not found: ' || clsname
    return 0
  end
  call skipline
  body = parsestmts()
  call endfunc fid, body, oldnvar
  fnclass[fid] = cls
  call pm_put 1, cls, msym, fid
  return fid

/* the whole program */
parseprogram: procedure = .int
  curcx = 0
  infunc = 0
  /* implicit main procedure for statements before the first function */
  call skipeol
  if tk[tp] = 1 then do
    w = ts[tp]
    if w <> 'FUNCTION' & w <> 'PROCEDURE' & w <> 'STATIC' & w <> 'INIT' & w <> 'EXIT' & w <> 'CREATE' & w <> 'CLASS' & w <> 'METHOD' & w <> 'REQUEST' & w <> 'EXTERNAL' & w <> 'ANNOUNCE' & w <> 'DYNAMIC' & w <> 'FUNC' & w <> 'PROC' & w <> 'MEMVAR' & w <> 'FIELD' & w <> 'DECLARE' then do
      stem = srcname
      k = lastpos('/', stem)
      if k > 0 then stem = substr(stem, k + 1)
      k = lastpos('.', stem)
      if k > 1 then stem = substr(stem, 1, k - 1)
      fid = beginfunc(upper(stem))
      oldnvar = savenvar
      body = parsestmts()
      call endfunc fid, body, oldnvar
      sfn[intern(upper(stem))] = fid
      if firstfn = 0 then firstfn = fid
    end
  end
  do forever
    call skipeol
    if tk[tp] = 8 | perrflag = 1 then leave
    if tk[tp] <> 1 then do
      call perr 'Syntax error near ' || ts[tp]
      leave
    end
    w = ts[tp]
    if w == 'FUNCTION' | w == 'PROCEDURE' | w == 'FUNC' | w == 'PROC' then do
      junk = parsefuncdef()
      iterate
    end
    if w == 'STATIC' | w == 'INIT' | w == 'EXIT' then do
      if nextisword('FUNCTION') = 1 | nextisword('PROCEDURE') = 1 | nextisword('FUNC') = 1 | nextisword('PROC') = 1 then do
        call adv
        junk = parsefuncdef()
        if w == 'INIT' then do
          ninit = ninit + 1
          initfns[ninit] = junk
        end
        if w == 'EXIT' then do
          nexitp = nexitp + 1
          exitfns[nexitp] = junk
        end
        iterate
      end
      if w == 'STATIC' then do
        junk = parsestatic()
        call skipline
        iterate
      end
    end
    if w == 'CREATE' & nextisword('CLASS') = 1 then do
      call adv
      junk = parseclass()
      iterate
    end
    if w == 'CLASS' then do
      junk = parseclass()
      iterate
    end
    if w == 'METHOD' then do
      junk = parsemethoddef()
      iterate
    end
    if w == 'REQUEST' | w == 'EXTERNAL' | w == 'ANNOUNCE' | w == 'DYNAMIC' | w == 'MEMVAR' | w == 'FIELD' | w == 'DECLARE' | w == 'NOTE' then do
      call skipline
      iterate
    end
    call perr 'Statement outside of a function: ' || w
  end
  return 0

/* ===================================================================== */
/*               ARITHMETIC, COMPARISON, CONVERSION, DATES               */
/* ===================================================================== */
gy = 0
gm = 0
gd = 0

jdn2ymd: procedure = .void
  arg j = .int
  a = j + 32044
  b = (4 * a + 3) / 146097
  c = a - 146097 * b / 4
  d = (4 * c + 3) / 1461
  e = c - 1461 * d / 4
  m = (5 * e + 2) / 153
  gd = e - (153 * m + 2) / 5 + 1
  gm = m + 3 - 12 * (m / 10)
  gy = 100 * b + d - 4800 + m / 10
  return

pad2: procedure = .string
  arg n = .int
  if n < 10 then return '0' || n
  return n || ''

pad4: procedure = .string
  arg n = .int
  s = n || ''
  do while length(s) < 4
    s = '0' || s
  end
  return s

/* format a date using the given format (mm/dd/yy style) */
datefmt: procedure = .string
  arg j = .int, fmt = .string
  if j = 0 then do
    r = ''
    u = upper(fmt)
    i = 1
    do while i <= length(u)
      c = substr(u, i, 1)
      if c = 'Y' | c = 'M' | c = 'D' then r = r || ' '
      else r = r || substr(fmt, i, 1)
      i = i + 1
    end
    return r
  end
  call jdn2ymd j
  u = upper(fmt)
  r = ''
  i = 1
  n = length(u)
  do while i <= n
    if substr(u, i, 4) == 'YYYY' then do
      r = r || pad4(gy)
      i = i + 4
    end
    else if substr(u, i, 2) == 'YY' then do
      if setcentury = 1 then r = r || pad4(gy)
      else r = r || pad2(gy % 100)
      i = i + 2
    end
    else if substr(u, i, 2) == 'MM' then do
      r = r || pad2(gm)
      i = i + 2
    end
    else if substr(u, i, 2) == 'DD' then do
      r = r || pad2(gd)
      i = i + 2
    end
    else do
      r = r || substr(fmt, i, 1)
      i = i + 1
    end
  end
  return r

datestr: procedure = .string
  arg j = .int
  return datefmt(j, setdatefmt)

dtos: procedure = .string
  arg j = .int
  if j = 0 then return '        '
  call jdn2ymd j
  return pad4(gy) || pad2(gm) || pad2(gd)

/* parse a date string according to a format; returns a jdn, 0 if empty/invalid */
parsedate: procedure = .int
  arg s = .string, fmt = .string
  u = upper(fmt)
  /* order of the fields in the format */
  ord = ''
  i = 1
  do while i <= length(u)
    if substr(u, i, 4) == 'YYYY' then do
      ord = ord || 'Y'
      i = i + 4
    end
    else if substr(u, i, 2) == 'YY' then do
      ord = ord || 'y'
      i = i + 2
    end
    else if substr(u, i, 2) == 'MM' then do
      ord = ord || 'M'
      i = i + 2
    end
    else if substr(u, i, 2) == 'DD' then do
      ord = ord || 'D'
      i = i + 2
    end
    else i = i + 1
  end
  nums = .int[]
  lens = .int[]
  cnt = 0
  i = 1
  n = length(s)
  do while i <= n
    c = substr(s, i, 1)
    if isdigitc(c) = 1 then do
      j = i
      do while j <= n
        if isdigitc(substr(s, j, 1)) = 0 then leave
        j = j + 1
      end
      cnt = cnt + 1
      nums[cnt] = substr(s, i, j - i) as .int
      lens[cnt] = j - i
      i = j
    end
    else i = i + 1
  end
  if cnt < 3 then return 0
  y = 0
  m = 0
  d = 0
  do k = 1 to 3
    f = substr(ord, k, 1)
    if f == 'Y' then y = nums[k]
    else if f == 'y' then do
      y = nums[k]
      if lens[k] <= 2 then do
        cen = setepoch - setepoch % 100
        y = cen + y
        if y < setepoch then y = y + 100
      end
    end
    else if f == 'M' then m = nums[k]
    else if f == 'D' then d = nums[k]
  end
  if m < 1 | m > 12 | d < 1 | d > 31 then return 0
  j = ymd2jdn(y, m, d)
  call jdn2ymd j
  if gd <> d | gm <> m then return 0
  return j

/* ------------------------------------------------------------------ errors */
argerr: procedure = .int
  arg op = .string
  junk = rterr('BASE', 1066, 'Argument error', op)
  return 0

/* ---------------------------------------------------------------- numbers */
/* left padding */
padleft: procedure = .string
  arg s = .string, w = .int
  if length(s) >= w then return s
  return copies(' ', w - length(s)) || s

/* digits of a float with d decimals */
fmtfloat: procedure = .string
  arg x = .float, d = .int
  s = format(x, , d)
  /* avoid a negative zero */
  if left(s, 1) = '-' then do
    ok = 0
    do i = 2 to length(s)
      ch = substr(s, i, 1)
      if ch <> '0' & ch <> '.' then do
        ok = 1
        leave
      end
    end
    if ok = 0 then s = substr(s, 2)
  end
  return s

/* the display string of a number: width and decimals taken from the value */
numstr: procedure = .string
  arg v = .int
  if v < 0 then return padleft(intval(v) || '', 10)
  w = cint[v] / 256
  d = cint[v] % 256
  s = fmtfloat(cnum[v], d)
  return padleft(s, w)

/* Str(n, len, dec): -1 means "not given" */
numstrw: procedure = .string
  arg v = .int, w = .int, d = .int
  if w < 0 then do
    w = numwid(v)
    if d < 0 then d = numdec(v)
  end
  if d < 0 then d = 0
  x = numval(v)
  s = fmtfloat(x, d)
  if length(s) > w then do
    /* try dropping decimals */
    return copies('*', w)
  end
  return padleft(s, w)

/* trimmed number, for concatenation, e.g. hb_NtoS */
ntos: procedure = .string
  arg v = .int
  if v < 0 then return intval(v) || ''
  return fmtfloat(cnum[v], cint[v] % 256)

/* value of a number cell with decimals d */
mknumd: procedure = .int
  arg x = .float, d = .int
  return mknum(x, 10, d)

numadd: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then return mkint(intval(a) + intval(b))
  x = numval(a) + numval(b)
  d = numdec(a)
  if numdec(b) > d then d = numdec(b)
  return mknum(x, 10, d)

numsub: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then return mkint(intval(a) - intval(b))
  x = numval(a) - numval(b)
  d = numdec(a)
  if numdec(b) > d then d = numdec(b)
  return mknum(x, 10, d)

nummul: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then do
    ia = intval(a)
    ib = intval(b)
    f = (ia * 1.0) * (ib * 1.0)
    if f < 9.0e18 & f > -9.0e18 then return mkint(ia * ib)
    return mknum(f, 20, 0)
  end
  x = numval(a) * numval(b)
  d = numdec(a) + numdec(b)
  return mknum(x, 10, d)

numdiv: procedure = .int
  arg a = .int, b = .int
  y = numval(b)
  if y = 0.0 then do
    junk = rterr('BASE', 1340, 'Zero divisor', '/')
    return 0
  end
  return mknum(numval(a) / y, 10, setdec)

nummod: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then do
    ib = intval(b)
    if ib = 0 then do
      junk = rterr('BASE', 1341, 'Zero divisor', '%')
      return 0
    end
    return mkint(intval(a) % ib)
  end
  y = numval(b)
  if y = 0.0 then do
    junk = rterr('BASE', 1341, 'Zero divisor', '%')
    return 0
  end
  x = numval(a)
  q = toint(x / y)
  r = x - (q * 1.0) * y
  d = numdec(a)
  if numdec(b) > d then d = numdec(b)
  return mknum(r, 10, d)

fpow: procedure = .float
  arg x = .float, y = .float
  if y = 0.0 then return 1.0
  if x = 0.0 then return 0.0
  yi = trunc(y) as .int
  if yi * 1.0 = y then do
    neg = 0
    e = yi
    if e < 0 then do
      neg = 1
      e = 0 - e
    end
    r = 1.0
    bb = x
    do while e > 0
      if e % 2 = 1 then r = r * bb
      bb = bb * bb
      e = e / 2
    end
    if neg = 1 then r = 1.0 / r
    return r
  end
  if x < 0.0 then return 0.0
  return lexp(y * lln(x))

numpow: procedure = .int
  arg a = .int, b = .int
  x = numval(a)
  y = numval(b)
  return mknum(fpow(x, y), 10, setdec)

numneg: procedure = .int
  arg a = .int
  if a < 0 then return mkint(0 - intval(a))
  c = newcell(1)
  cnum[c] = 0.0 - cnum[a]
  cint[c] = cint[a]
  return c

/* ----------------------------------------------------------- comparison */
/* -1, 0, 1 for two strings, byte-wise; shorter string is lower */
strcmp: procedure = .int
  arg a = .string, b = .string
  p = compare(a, b, '00'x)
  if p = 0 then return 0
  ca = -1
  cb = -1
  if p <= length(a) then ca = c2d(substr(a, p, 1))
  if p <= length(b) then cb = c2d(substr(b, p, 1))
  if ca < cb then return -1
  return 1

/* order of two values; returns 2 if they cannot be compared */
cmpv: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then do
    x = intval(a)
    y = intval(b)
    if x < y then return -1
    if x > y then return 1
    return 0
  end
  if isnum(a) = 1 & isnum(b) = 1 then do
    x = numval(a)
    y = numval(b)
    if x < y then return -1
    if x > y then return 1
    return 0
  end
  if a > 2 & b > 2 then do
    if ctag[a] = 2 & ctag[b] = 2 then return strcmp(cstr[a], cstr[b])
    if ctag[a] = 4 & ctag[b] = 4 then do
      if cint[a] < cint[b] then return -1
      if cint[a] > cint[b] then return 1
      return 0
    end
  end
  if islog(a) = 1 & islog(b) = 1 then do
    if a < b then return -1
    if a > b then return 1
    return 0
  end
  return 2

/* the = operator */
equalv: procedure = .int
  arg a = .int, b = .int
  if a = 0 & b = 0 then return 1
  if a = 0 | b = 0 then return 0
  if isstr(a) = 1 & isstr(b) = 1 then do
    if setexact = 1 then do
      if strip(cstr[a], 'T') == strip(cstr[b], 'T') then return 1
      return 0
    end
    s = cstr[a]
    t = cstr[b]
    if t == '' then return 1
    if left(s, length(t)) == t then return 1
    return 0
  end
  r = cmpv(a, b)
  if r = 2 then do
    if isarr(a) = 1 & isarr(b) = 1 then do
      if a = b then return 1
      return 0
    end
    if (ishash(a) = 1 & ishash(b) = 1) | (isobj(a) = 1 & isobj(b) = 1) | (isblk(a) = 1 & isblk(b) = 1) then do
      if a = b then return 1
      return 0
    end
    junk = argerr('=')
    return 0
  end
  if r = 0 then return 1
  return 0

/* the == operator */
exactv: procedure = .int
  arg a = .int, b = .int
  if a = 0 & b = 0 then return 1
  if a = 0 | b = 0 then return 0
  if isstr(a) = 1 & isstr(b) = 1 then do
    if cstr[a] == cstr[b] then return 1
    return 0
  end
  r = cmpv(a, b)
  if r = 2 then do
    if a = b then return 1
    if isarr(a) = 1 | ishash(a) = 1 | isobj(a) = 1 | isblk(a) = 1 then return 0
    junk = argerr('==')
    return 0
  end
  if r = 0 then return 1
  return 0

/* ----------------------------------------------------------- operators */
binadd: procedure = .int
  arg a = .int, b = .int
  if isnum(a) = 1 & isnum(b) = 1 then return numadd(a, b)
  if isstr(a) = 1 & isstr(b) = 1 then return mkstr(cstr[a] || cstr[b])
  if isdate(a) = 1 & isnum(b) = 1 then return mkdate(cint[a] + toint(numval(b)))
  if isnum(a) = 1 & isdate(b) = 1 then return mkdate(cint[b] + toint(numval(a)))
  junk = argerr('+')
  return 0

binsub: procedure = .int
  arg a = .int, b = .int
  if isnum(a) = 1 & isnum(b) = 1 then return numsub(a, b)
  if isstr(a) = 1 & isstr(b) = 1 then do
    s = cstr[a]
    t = strip(s, 'T')
    return mkstr(t || cstr[b] || copies(' ', length(s) - length(t)))
  end
  if isdate(a) = 1 & isnum(b) = 1 then return mkdate(cint[a] - toint(numval(b)))
  if isdate(a) = 1 & isdate(b) = 1 then return mkint(cint[a] - cint[b])
  junk = argerr('-')
  return 0

binop: procedure = .int
  arg t = .int, a = .int, b = .int
  if t = 7 then return binadd(a, b)
  if t = 8 then return binsub(a, b)
  if t = 9 then do
    if isnum(a) = 1 & isnum(b) = 1 then return nummul(a, b)
    return argerr('*')
  end
  if t = 10 then do
    if isnum(a) = 1 & isnum(b) = 1 then return numdiv(a, b)
    return argerr('/')
  end
  if t = 11 then do
    if isnum(a) = 1 & isnum(b) = 1 then return nummod(a, b)
    return argerr('%')
  end
  if t = 12 then do
    if isnum(a) = 1 & isnum(b) = 1 then return numpow(a, b)
    return argerr('^')
  end
  return 0

/* relational operators */
relop: procedure = .int
  arg t = .int, a = .int, b = .int
  if t = 15 then return mklog(equalv(a, b))
  if t = 16 then return mklog(exactv(a, b))
  if t = 17 then do
    if equalv(a, b) = 1 then return 1
    return 2
  end
  r = cmpv(a, b)
  if r = 2 then do
    if t = 18 then return argerr('<')
    if t = 19 then return argerr('<=')
    if t = 20 then return argerr('>')
    return argerr('>=')
  end
  if t = 18 then do
    if r < 0 then return 2
    return 1
  end
  if t = 19 then do
    if r <= 0 then return 2
    return 1
  end
  if t = 20 then do
    if r > 0 then return 2
    return 1
  end
  if r >= 0 then return 2
  return 1

/* ------------------------------------------------------ value to string */
typech: procedure = .string
  arg v = .int
  if v = 0 then return 'U'
  if v < 0 then return 'N'
  if v = 1 | v = 2 then return 'L'
  t = ctag[v]
  if t = 1 then return 'N'
  if t = 2 then return 'C'
  if t = 4 then return 'D'
  if t = 5 then return 'A'
  if t = 6 then return 'H'
  if t = 7 then return 'B'
  if t = 8 then return 'O'
  return 'U'

/* string for ? and ?? */
valstr: procedure = .string
  arg v = .int
  if v = 0 then return 'NIL'
  if v < 0 then return numstr(v)
  if v = 1 then return '.F.'
  if v = 2 then return '.T.'
  t = ctag[v]
  if t = 2 then return cstr[v]
  if t = 1 then return numstr(v)
  if t = 4 then return datestr(cint[v])
  junk = argerr('?')
  return ''

/* string for hb_ValToStr / conversions in messages (never raises) */
vtostr: procedure = .string
  arg v = .int
  if v = 0 then return 'NIL'
  if v < 0 then return intval(v) || ''
  if v = 1 then return '.F.'
  if v = 2 then return '.T.'
  t = ctag[v]
  if t = 2 then return cstr[v]
  if t = 1 then return ntos(v)
  if t = 4 then return datestr(cint[v])
  if t = 5 then return '{Array of ' || arrlen(v) || ' items}'
  if t = 6 then return '{Hash of ' || hashlen(v) || ' items}'
  if t = 7 then return '{|| ... }'
  if t = 8 then return clname[cint[v]] || ' Object'
  return 'NIL'

/* ---------------------------------------------------- math (from Lisp) */
lsqrt: procedure = .float
  arg x = .float
  if x <= 0.0 then return 0.0
  m = x
  e = 0
  do while m >= 4.0
    m = m / 4.0
    e = e + 1
  end
  do while m < 0.25
    m = m * 4.0
    e = e - 1
  end
  r = (1.0 + m) / 2.0
  do 8
    r = (r + m / r) / 2.0
  end
  do while e > 0
    r = r * 2.0
    e = e - 1
  end
  do while e < 0
    r = r / 2.0
    e = e + 1
  end
  return r

lsin: procedure = .float
  arg x = .float
  pi = 3.14159265358979323846
  twopi = 6.28318530717958647692
  r = x
  if r > twopi | r < 0.0 - twopi then do
    q = trunc(r / twopi) as .int
    r = r - q * twopi
  end
  if r > pi then r = r - twopi
  if r < 0.0 - pi then r = r + twopi
  if r > pi / 2.0 then r = pi - r
  if r < 0.0 - pi / 2.0 then r = 0.0 - pi - r
  r2 = r * r
  term = r
  sum = r
  do k = 1 to 12
    term = 0.0 - term * r2 / ((2 * k) * (2 * k + 1))
    sum = sum + term
  end
  return sum

lcos: procedure = .float
  arg x = .float
  return lsin(x + 1.57079632679489661923)

lln: procedure = .float
  arg x = .float
  if x <= 0.0 then return 0.0
  e = 0
  m = x
  do while m >= 2.0
    m = m / 2.0
    e = e + 1
  end
  do while m < 0.5
    m = m * 2.0
    e = e - 1
  end
  z = (m - 1.0) / (m + 1.0)
  z2 = z * z
  term = z
  sum = z
  do k = 1 to 30
    term = term * z2
    sum = sum + term / (2 * k + 1)
  end
  return 2.0 * sum + e * 0.69314718055994530942

lexp: procedure = .float
  arg x = .float
  k = 0
  r = x
  do while r > 0.5 | r < -0.5
    r = r / 2.0
    k = k + 1
  end
  term = 1.0
  sum = 1.0
  do i = 1 to 20
    term = term * r / i
    sum = sum + term
  end
  do k
    sum = sum * sum
  end
  return sum

/* ===================================================================== */
/*                           EXPRESSION EVALUATION                        */
/* ===================================================================== */
deref: procedure = .int
  arg v = .int
  if v > 2 then do
    if ctag[v] = 9 then return ca1[v]
  end
  return v

/* the reference cell for a variable node, boxing the variable if needed */
mkref: procedure = .int
  arg n = .int
  t = nt[n]
  if t = 2 then do
    idx = fbase + na[n]
    v = fv[idx]
    if v > 2 then do
      if ctag[v] = 9 then return v
    end
    r = newcell(9)
    ca1[r] = v
    fv[idx] = r
    return r
  end
  if t = 3 then return vdat[curcap + na[n] - 1]
  if t = 4 then do
    idx = na[n]
    v = sv[idx]
    if v > 2 then do
      if ctag[v] = 9 then return v
    end
    r = newcell(9)
    ca1[r] = v
    sv[idx] = r
    return r
  end
  if t = 5 | t = 36 then do
    sym = na[n]
    if smvd[sym] = 0 then do
      junk = rterr('BASE', 1003, 'Variable does not exist', snm[sym])
      return 0
    end
    v = smv[sym]
    if v > 2 then do
      if ctag[v] = 9 then return v
    end
    r = newcell(9)
    ca1[r] = v
    smv[sym] = r
    return r
  end
  /* anything else: pass the value */
  return evalnode(n)

/* ------------------------------------------------------------ variables */
getmemvar: procedure = .int
  arg sym = .int
  v = smv[sym]
  if v > 2 then do
    if ctag[v] = 9 then return ca1[v]
  end
  return v

setmemvar: procedure = .void
  arg sym = .int, val = .int
  v = smv[sym]
  if v > 2 then do
    if ctag[v] = 9 then do
      ca1[v] = val
      return
    end
  end
  smv[sym] = val
  smvd[sym] = 1
  return

/* value of an undeclared identifier: memvar, else field */
getident: procedure = .int
  arg sym = .int
  if smvd[sym] = 1 then return getmemvar(sym)
  if curarea > 0 then do
    fi = fieldfind(curarea, sym)
    if fi > 0 then return fieldval(curarea, fi)
  end
  return rterr('BASE', 1003, 'Variable does not exist', snm[sym])

/* resolve an alias node (constant string / number / expression) to a work area */
resolvealias: procedure = .int
  arg an = .int
  if nt[an] = 1 then do
    v = na[an]
    if isstr(v) = 1 then do
      a = aliasarea(upper(strip(cstr[v])))
      if a = 0 then junk = rterr('BASE', 1002, 'Alias does not exist', upper(cstr[v]))
      return a
    end
  end
  v = evalnode(an)
  if ctl <> 0 then return 0
  if isnum(v) = 1 then return toint(numval(v))
  if isstr(v) = 1 then do
    a = aliasarea(upper(strip(cstr[v])))
    if a = 0 then junk = rterr('BASE', 1002, 'Alias does not exist', upper(cstr[v]))
    return a
  end
  junk = rterr('BASE', 1002, 'Alias does not exist', '')
  return 0

/* ----------------------------------------------------------------- eval */
evalnode: procedure = .int
  arg n = .int
  t = nt[n]
  if t = 1 then return na[n]
  if t = 2 then do
    v = fv[fbase + na[n]]
    if v > 2 then do
      if ctag[v] = 9 then return ca1[v]
    end
    return v
  end
  if t = 6 then return evcall(n)
  if t = 7 then do
    a = evalnode(na[n])
    b = evalnode(nb[n])
    if ctl <> 0 then return 0
    if a < 0 & b < 0 then return mkint(intval(a) + intval(b))
    return binadd(a, b)
  end
  if t = 8 then do
    a = evalnode(na[n])
    b = evalnode(nb[n])
    if ctl <> 0 then return 0
    if a < 0 & b < 0 then return mkint(intval(a) - intval(b))
    return binsub(a, b)
  end
  if t = 22 then do
    a = evalnode(na[n])
    b = evalnode(nb[n])
    if ctl <> 0 then return 0
    if isstr(a) = 0 | isstr(b) = 0 then return rterr('BASE', 1109, 'Argument error', '$')
    if pos(cstr[a], cstr[b]) > 0 | cstr[a] == '' then return 2
    return 1
  end
  if t = 15 | t = 16 | t = 17 | t = 18 | t = 19 | t = 20 | t = 21 then do
    a = evalnode(na[n])
    b = evalnode(nb[n])
    if ctl <> 0 then return 0
    if a < 0 & b < 0 then do
      x = intval(a)
      y = intval(b)
      if t = 15 | t = 16 then do
        if x = y then return 2
        return 1
      end
      if t = 17 then do
        if x <> y then return 2
        return 1
      end
      if t = 18 then do
        if x < y then return 2
        return 1
      end
      if t = 19 then do
        if x <= y then return 2
        return 1
      end
      if t = 20 then do
        if x > y then return 2
        return 1
      end
      if x >= y then return 2
      return 1
    end
    return relop(t, a, b)
  end
  if t = 4 then do
    v = sv[na[n]]
    if v > 2 then do
      if ctag[v] = 9 then return ca1[v]
    end
    return v
  end
  if t = 25 then do
    v = evalnode(nb[n])
    if ctl <> 0 then return 0
    call assignto na[n], v
    return v
  end
  if t = 30 then return evindex(n)
  if t = 23 then do
    a = evalnode(na[n])
    if ctl <> 0 then return 0
    if islog(a) = 0 then return argerr('.AND.')
    if a = 1 then return 1
    b = evalnode(nb[n])
    if ctl <> 0 then return 0
    if islog(b) = 0 then return argerr('.AND.')
    return b
  end
  if t = 24 then do
    a = evalnode(na[n])
    if ctl <> 0 then return 0
    if islog(a) = 0 then return argerr('.OR.')
    if a = 2 then return 2
    b = evalnode(nb[n])
    if ctl <> 0 then return 0
    if islog(b) = 0 then return argerr('.OR.')
    return b
  end
  if t = 14 then do
    a = evalnode(na[n])
    if ctl <> 0 then return 0
    if islog(a) = 0 then return argerr('.NOT.')
    if a = 1 then return 2
    return 1
  end
  if t = 9 | t = 10 | t = 11 | t = 12 then do
    a = evalnode(na[n])
    b = evalnode(nb[n])
    if ctl <> 0 then return 0
    return binop(t, a, b)
  end
  if t = 3 then return ca1[vdat[curcap + na[n] - 1]]
  if t = 5 then return getident(na[n])
  if t = 43 then return evalnode(na[n])
  if t = 42 then do
    c = evalnode(na[n])
    if ctl <> 0 then return 0
    if islog(c) = 0 then return argerr('IIF')
    if c = 2 then return evalnode(nb[n])
    return evalnode(nc[n])
  end
  if t = 13 then do
    a = evalnode(na[n])
    if ctl <> 0 then return 0
    if isnum(a) = 0 then return argerr('-')
    return numneg(a)
  end
  if t = 26 | t = 27 | t = 28 | t = 29 then do
    old = evalnode(na[n])
    if ctl <> 0 then return 0
    if isnum(old) = 0 & isdate(old) = 0 then return argerr('++')
    if t = 26 | t = 28 then nv2 = binadd(old, mkint(1))
    else nv2 = binsub(old, mkint(1))
    if ctl <> 0 then return 0
    call assignto na[n], nv2
    if t = 26 | t = 27 then return nv2
    return old
  end
  if t = 34 then return evsend(n)
  if t = 31 then do
    cnt = nb[n]
    arr = mkarray(cnt)
    e = na[n]
    i = 0
    do while e > 0
      i = i + 1
      v = evalnode(e)
      if ctl <> 0 then return 0
      call arrset arr, i, v
      e = nx[e]
    end
    return arr
  end
  if t = 32 then do
    h = mkhash()
    e = na[n]
    do while e > 0
      k = evalnode(e)
      v = evalnode(nx[e])
      if ctl <> 0 then return 0
      call hset h, k, v
      e = nx[nx[e]]
    end
    return h
  end
  if t = 33 then return mkblock(n)
  if t = 35 then return curself
  if t = 36 then do
    sym = na[n]
    if smvd[sym] = 0 then return rterr('BASE', 1003, 'Variable does not exist', 'M->' || snm[sym])
    return getmemvar(sym)
  end
  if t = 37 then do
    sym = na[n]
    if curarea > 0 then do
      fi = fieldfind(curarea, sym)
      if fi > 0 then return fieldval(curarea, fi)
    end
    return rterr('BASE', 1003, 'Variable does not exist', 'FIELD->' || snm[sym])
  end
  if t = 38 then do
    a = resolvealias(na[n])
    if ctl <> 0 then return 0
    sym = nb[n]
    fi = fieldfind(a, sym)
    if fi = 0 then return rterr('BASE', 1003, 'Variable does not exist', snm[sym])
    return fieldval(a, fi)
  end
  if t = 39 then do
    a = resolvealias(na[n])
    if ctl <> 0 then return 0
    old = curarea
    curarea = a
    v = evalnode(nb[n])
    curarea = old
    return v
  end
  if t = 40 then return mkref(na[n])
  if t = 41 then do
    v = evalnode(na[n])
    if ctl <> 0 then return 0
    if isstr(v) = 0 then return v
    return macroeval(cstr[v])
  end
  if t = 44 then do
    c = newcell(7)
    cint[c] = n
    return c
  end
  junk = rterr('BASE', 1066, 'Internal error: unknown expression node', t || '')
  return 0

evindex: procedure = .int
  arg n = .int
  b = evalnode(na[n])
  i = evalnode(nb[n])
  if ctl <> 0 then return 0
  if b > 2 then do
    t = ctag[b]
    if t = 5 then do
      if isnum(i) = 0 then return rterr('BASE', 1068, 'Argument error', 'array access')
      k = toint(numval(i))
      if k < 1 | k > ca1[b] then return rterr('BASE', 1132, 'Bound error', 'array access')
      return vdat[cint[b] + k - 1]
    end
    if t = 6 then do
      p = hfind(b, i)
      if p = 0 then return rterr('BASE', 1132, 'Bound error', 'array access')
      return arrget(ca2[b], p)
    end
  end
  return rterr('BASE', 1068, 'Argument error', 'array access')

mkblock: procedure = .int
  arg n = .int
  c = newcell(7)
  cint[c] = n
  cnt = nf[n]
  ca2[c] = curself
  if cnt = 0 then do
    ca1[c] = 0
    return c
  end
  cs = nv + 1
  nv = nv + cnt
  s = nd[n]
  i = 0
  do while s > 0
    i = i + 1
    k = na[s]
    ix = nb[s]
    if k = 1 then do
      idx = fbase + ix
      v = fv[idx]
      r = 0
      if v > 2 then do
        if ctag[v] = 9 then r = v
      end
      if r = 0 then do
        r = newcell(9)
        ca1[r] = v
        fv[idx] = r
      end
      vdat[cs + i - 1] = r
    end
    else vdat[cs + i - 1] = vdat[curcap + ix - 1]
    s = nx[s]
  end
  ca1[c] = cs
  return c

/* ------------------------------------------------------------ assignment */
assignto: procedure = .void
  arg n = .int, val = .int
  t = nt[n]
  if t = 2 then do
    idx = fbase + na[n]
    v = fv[idx]
    if v > 2 then do
      if ctag[v] = 9 then do
        ca1[v] = val
        return
      end
    end
    fv[idx] = val
    return
  end
  if t = 3 then do
    ca1[vdat[curcap + na[n] - 1]] = val
    return
  end
  if t = 4 then do
    idx = na[n]
    v = sv[idx]
    if v > 2 then do
      if ctag[v] = 9 then do
        ca1[v] = val
        return
      end
    end
    sv[idx] = val
    return
  end
  if t = 5 then do
    sym = na[n]
    if smvd[sym] = 1 then do
      call setmemvar sym, val
      return
    end
    if curarea > 0 then do
      fi = fieldfind(curarea, sym)
      if fi > 0 then do
        call fieldput curarea, fi, val
        return
      end
    end
    junk = rterr('BASE', 1003, 'Variable does not exist', snm[sym])
    return
  end
  if t = 36 then do
    sym = na[n]
    if smvd[sym] = 0 then do
      junk = rterr('BASE', 1003, 'Variable does not exist', 'M->' || snm[sym])
      return
    end
    call setmemvar sym, val
    return
  end
  if t = 37 then do
    sym = na[n]
    if curarea > 0 then do
      fi = fieldfind(curarea, sym)
      if fi > 0 then do
        call fieldput curarea, fi, val
        return
      end
    end
    junk = rterr('BASE', 1003, 'Variable does not exist', 'FIELD->' || snm[sym])
    return
  end
  if t = 38 then do
    a = resolvealias(na[n])
    if ctl <> 0 then return
    fi = fieldfind(a, nb[n])
    if fi = 0 then do
      junk = rterr('BASE', 1003, 'Variable does not exist', snm[nb[n]])
      return
    end
    call fieldput a, fi, val
    return
  end
  if t = 30 then do
    b = evalnode(na[n])
    i = evalnode(nb[n])
    if ctl <> 0 then return
    if b > 2 then do
      tt = ctag[b]
      if tt = 5 then do
        if isnum(i) = 0 then do
          junk = rterr('BASE', 1069, 'Argument error', 'array assign')
          return
        end
        k = toint(numval(i))
        if k < 1 | k > ca1[b] then do
          junk = rterr('BASE', 1133, 'Bound error', 'array assign')
          return
        end
        vdat[cint[b] + k - 1] = val
        return
      end
      if tt = 6 then do
        call hset b, i, val
        return
      end
    end
    junk = rterr('BASE', 1069, 'Argument error', 'array assign')
    return
  end
  if t = 34 then do
    call sendassign n, val
    return
  end
  if t = 41 then do
    v = evalnode(na[n])
    if isstr(v) = 1 then do
      sym = intern(upper(strip(cstr[v])))
      if smvd[sym] = 1 then call setmemvar sym, val
      else if curarea > 0 then do
        fi = fieldfind(curarea, sym)
        if fi > 0 then call fieldput curarea, fi, val
        else junk = rterr('BASE', 1003, 'Variable does not exist', snm[sym])
      end
      else junk = rterr('BASE', 1003, 'Variable does not exist', snm[sym])
    end
    return
  end
  junk = rterr('BASE', 1066, 'Argument error', 'assignment')
  return

/* ------------------------------------------------------------ call sites */
evalargs: procedure = .int
  /* evaluate argument list into fv[base+1..]; max = slots that can be kept */
  arg a = .int, base = .int, mx = .int
  i = 0
  do while a > 0
    i = i + 1
    if i <= mx then do
      if nt[a] = 40 then v = mkref(na[a])
      else v = evalnode(a)
      fv[base + i] = v
    end
    else junk = evalnode(a)
    if ctl <> 0 then return 0
    a = nx[a]
  end
  return 1

evcall: procedure = .int
  arg n = .int
  sym = na[n]
  cnt = nc[n]
  f = sfn[sym]
  if f > 0 then do
    base = ftop
    slots = fnslots[f]
    if cnt > slots then slots = cnt
    ftop = base + slots
    do i = 1 to slots
      fv[base + i] = 0
    end
    ok = evalargs(nb[n], base, fnpar[f])
    if ctl <> 0 then do
      ftop = base
      return 0
    end
    return invoke(f, base, cnt, 0, n)
  end
  bi = sbi[sym]
  if bi > 0 then do
    base = ftop
    ftop = base + cnt + 8
    do i = cnt + 1 to cnt + 8
      fv[base + i] = 0
    end
    ok = evalargs(nb[n], base, cnt)
    if ctl <> 0 then do
      ftop = base
      return 0
    end
    r = callprim(bi, base, cnt)
    ftop = base
    return r
  end
  cl = scls[sym]
  if cl > 0 then do
    junk = evalargs(nb[n], ftop, 0)
    return newobject(cl)
  end
  return rterr('BASE', 1001, 'Undefined function', snm[sym])

/* run user function f whose arguments are already in fv[base+1..] */
invoke: procedure = .int
  arg f = .int, base = .int, cnt = .int, obj = .int, site = .int
  if pctop > 2400 then do
    ftop = base
    return rterr('BASE', 1002, 'Stack overflow', fnname[f])
  end
  ofb = fbase
  opc = fpc
  osf = curself
  ocap = curcap
  omc = curmcls
  opv = pvtop
  fbase = base
  fpc = cnt
  curself = obj
  curmcls = fnclass[f]
  pctop = pctop + 1
  pcname[pctop] = fnname[f]
  pcln[pctop] = nl[fnbody[f]]
  call execstmts fnbody[f]
  r = 0
  if ctl = 1 then do
    r = retv
    ctl = 0
  end
  else if ctl = 2 | ctl = 3 then ctl = 0
  do while pvtop > opv
    s = pvs[pvtop]
    smv[s] = pvv[pvtop]
    smvd[s] = pvd[pvtop]
    pvtop = pvtop - 1
  end
  pctop = pctop - 1
  fbase = ofb
  fpc = opc
  curself = osf
  curcap = ocap
  curmcls = omc
  ftop = base
  return r

/* evaluate a block; arguments in fv[base+1..base+cnt], ftop = base + cnt */
callblock: procedure = .int
  arg blk = .int, base = .int, cnt = .int
  bn = cint[blk]
  if nt[bn] = 44 then do
    sym = na[bn]
    f = sfn[sym]
    if f > 0 then do
      slots = fnslots[f]
      if cnt > slots then slots = cnt
      ftop = base + slots
      do i = cnt + 1 to slots
        fv[base + i] = 0
      end
      return invoke(f, base, cnt, 0, 0)
    end
    bi = sbi[sym]
    if bi > 0 then do
      ftop = base + cnt + 8
      do i = cnt + 1 to cnt + 8
        fv[base + i] = 0
      end
      r = callprim(bi, base, cnt)
      ftop = base
      return r
    end
    ftop = base
    return rterr('BASE', 1001, 'Undefined function', snm[sym])
  end
  np = nb[bn]
  slots = nc[bn]
  if cnt > slots then slots = cnt
  ftop = base + slots
  do i = cnt + 1 to slots
    fv[base + i] = 0
  end
  ofb = fbase
  ocap = curcap
  osf = curself
  fbase = base
  curcap = ca1[blk]
  curself = ca2[blk]
  e = na[bn]
  r = 0
  do while e > 0
    r = evalnode(e)
    if ctl <> 0 then leave
    e = nx[e]
  end
  fbase = ofb
  curcap = ocap
  curself = osf
  ftop = base
  return r

evalblock0: procedure = .int
  arg blk = .int
  base = ftop
  return callblock(blk, base, 0)

evalblock1: procedure = .int
  arg blk = .int, a = .int
  base = ftop
  fv[base + 1] = a
  ftop = base + 1
  return callblock(blk, base, 1)

evalblock2: procedure = .int
  arg blk = .int, a = .int, b = .int
  base = ftop
  fv[base + 1] = a
  fv[base + 2] = b
  ftop = base + 2
  return callblock(blk, base, 2)

evalblock3: procedure = .int
  arg blk = .int, a = .int, b = .int, c = .int
  base = ftop
  fv[base + 1] = a
  fv[base + 2] = b
  fv[base + 3] = c
  ftop = base + 3
  return callblock(blk, base, 3)

/* call a function by symbol with arguments given in an array (used by DO, Eval, etc.) */
callsym: procedure = .int
  arg sym = .int, arr = .int
  cnt = 0
  if arr > 0 then cnt = arrlen(arr)
  base = ftop
  ftop = base + cnt
  do i = 1 to cnt
    fv[base + i] = arrget(arr, i)
  end
  f = sfn[sym]
  if f > 0 then do
    slots = fnslots[f]
    if cnt > slots then slots = cnt
    ftop = base + slots
    do i = cnt + 1 to slots
      fv[base + i] = 0
    end
    return invoke(f, base, cnt, 0, 0)
  end
  bi = sbi[sym]
  if bi > 0 then do
    ftop = base + cnt + 8
    do i = cnt + 1 to cnt + 8
      fv[base + i] = 0
    end
    r = callprim(bi, base, cnt)
    ftop = base
    return r
  end
  ftop = base
  cl = scls[sym]
  if cl > 0 then return newobject(cl)
  return rterr('BASE', 1001, 'Undefined function', snm[sym])

/* ===================================================================== */
/*                      STATEMENTS, ERRORS, OBJECTS, MACROS              */
/* ===================================================================== */
execstmts: procedure = .void
  arg n = .int
  s = na[n]
  do while s > 0
    call exec s
    if ctl <> 0 then return
    s = nx[s]
  end
  return

/* condition value: .T. or .F.; others raise an error */
condval: procedure = .int
  arg n = .int
  c = evalnode(n)
  if ctl <> 0 then return 0
  if c = 2 then return 1
  if c = 1 then return 0
  junk = argerr('IF')
  return 0

exec: procedure = .void
  arg s = .int
  t = nt[s]
  pcln[pctop] = nl[s]
  if t = 47 then do
    junk = evalnode(na[s])
    return
  end
  if t = 48 then do
    if condval(na[s]) = 1 then call execstmts nb[s]
    else if ctl = 0 & nc[s] > 0 then do
      if nt[nc[s]] = 48 then call exec nc[s]
      else call execstmts nc[s]
    end
    return
  end
  if t = 49 then do
    do forever
      if condval(na[s]) = 0 then leave
      if ctl <> 0 then leave
      call execstmts nb[s]
      if ctl <> 0 then do
        if ctl = 2 then do
          ctl = 0
          leave
        end
        if ctl = 3 then ctl = 0
        else leave
      end
    end
    return
  end
  if t = 50 then do
    call execfor s
    return
  end
  if t = 46 then do
    call execstmts s
    return
  end
  if t = 56 then do
    v = 0
    if na[s] > 0 then v = evalnode(na[s])
    if ctl = 0 then do
      retv = v
      ctl = 1
    end
    return
  end
  if t = 58 then do
    call execprint s
    return
  end
  if t = 51 then do
    call execforeach s
    return
  end
  if t = 54 then do
    ctl = 2
    return
  end
  if t = 55 then do
    ctl = 3
    return
  end
  if t = 52 then do
    c = na[s]
    do while c > 0
      if na[c] = 0 then do
        call execstmts nb[c]
        return
      end
      if condval(na[c]) = 1 then do
        call execstmts nb[c]
        return
      end
      if ctl <> 0 then return
      c = nx[c]
    end
    return
  end
  if t = 53 then do
    call execswitch s
    return
  end
  if t = 57 then do
    call execsequence s
    return
  end
  if t = 65 then do
    v = 0
    if na[s] > 0 then v = evalnode(na[s])
    if ctl = 0 then do
      brkval = v
      ctl = 4
    end
    return
  end
  if t = 59 | t = 60 then do
    p = s
    call declmem p
    return
  end
  if t = 70 then do
    c = na[s]
    i = 0
    do while c > 0
      i = i + 1
      sym = na[c]
      call pushprivate sym
      v = 0
      if i <= fpc then v = fv[fbase + i]
      smv[sym] = v
      smvd[sym] = 1
      c = nx[c]
    end
    return
  end
  if t = 62 then do
    call execcmd s
    return
  end
  if t = 63 then do
    call execscoped s
    return
  end
  if t = 68 then do
    call execsayget s
    return
  end
  if t = 66 then do
    call exectext s
    return
  end
  if t = 64 then return
  junk = rterr('BASE', 1066, 'Internal error: unknown statement', t || '')
  return

pushprivate: procedure = .void
  arg sym = .int
  pvtop = pvtop + 1
  pvs[pvtop] = sym
  pvv[pvtop] = smv[sym]
  pvd[pvtop] = smvd[sym]
  return

declmem: procedure = .void
  arg p = .int
  mleft = ne[p]
  do while p > 0 & mleft > 0
    mleft = mleft - 1
    sym = na[p]
    if nf[p] = 1 then do
      v = evalnode(nb[p])
      if isstr(v) = 1 then sym = intern(upper(strip(cstr[v])))
    end
    init = 0
    if nb[p] > 0 & nf[p] = 0 then init = evalnode(nb[p])
    if ctl <> 0 then return
    if nt[p] = 59 then do
      call pushprivate sym
      smv[sym] = init
      smvd[sym] = 1
    end
    else do
      if smvd[sym] = 0 | nb[p] > 0 then do
        if nb[p] = 0 then smv[sym] = 1
        else smv[sym] = init
        smvd[sym] = 1
      end
    end
    p = nx[p]
  end
  return

execfor: procedure = .void
  arg s = .int
  v = na[s]
  start = evalnode(nb[s])
  stop = evalnode(nc[s])
  step = mkint(1)
  if nd[s] > 0 then step = evalnode(nd[s])
  if ctl <> 0 then return
  if (isnum(start) = 0 & isdate(start) = 0) | isnum(stop) = 0 & isdate(stop) = 0 | isnum(step) = 0 then do
    junk = argerr('FOR')
    return
  end
  call assignto v, start
  neg = 0
  if numval(step) < 0.0 then neg = 1
  body = ne[s]
  do forever
    cur = evalnode(v)
    if ctl <> 0 then return
    if cur < 0 & stop < 0 then do
      x = intval(cur)
      y = intval(stop)
      if neg = 0 & x > y then leave
      if neg = 1 & x < y then leave
    end
    else do
      r = cmpv(cur, stop)
      if r = 2 then do
        junk = argerr('FOR')
        return
      end
      if neg = 0 & r > 0 then leave
      if neg = 1 & r < 0 then leave
    end
    call execstmts body
    if ctl <> 0 then do
      if ctl = 2 then do
        ctl = 0
        leave
      end
      if ctl = 3 then ctl = 0
      else leave
    end
    cur = evalnode(v)
    if cur < 0 & step < 0 then nv2 = mkint(intval(cur) + intval(step))
    else nv2 = binadd(cur, step)
    if ctl <> 0 then return
    call assignto v, nv2
  end
  return

execforeach: procedure = .void
  arg s = .int
  v = na[s]
  coll = evalnode(nb[s])
  if ctl <> 0 then return
  desc = nd[s]
  body = nc[s]
  if isarr(coll) = 1 then do
    n = arrlen(coll)
    i = 1
    if desc = 1 then i = n
    do forever
      if desc = 1 then do
        if i < 1 then leave
      end
      else if i > arrlen(coll) then leave
      el = arrget(coll, i)
      call assignto v, el
      call execstmts body
      if ctl = 0 then do
        nw = evalnode(v)
        if nw <> el & i <= arrlen(coll) then call arrset coll, i, nw
      end
      if ctl <> 0 then do
        if ctl = 2 then do
          ctl = 0
          leave
        end
        if ctl = 3 then ctl = 0
        else leave
      end
      if desc = 1 then i = i - 1
      else i = i + 1
    end
    return
  end
  if ishash(coll) = 1 then do
    n = hashlen(coll)
    i = 1
    if desc = 1 then i = n
    do forever
      if desc = 1 then do
        if i < 1 then leave
      end
      else if i > hashlen(coll) then leave
      call assignto v, arrget(ca2[coll], i)
      call execstmts body
      if ctl <> 0 then do
        if ctl = 2 then do
          ctl = 0
          leave
        end
        if ctl = 3 then ctl = 0
        else leave
      end
      if desc = 1 then i = i - 1
      else i = i + 1
    end
    return
  end
  if isstr(coll) = 1 then do
    str = cstr[coll]
    n = length(str)
    do i = 1 to n
      call assignto v, mkstr(substr(str, i, 1))
      call execstmts body
      if ctl <> 0 then do
        if ctl = 2 then do
          ctl = 0
          leave
        end
        if ctl = 3 then ctl = 0
        else leave
      end
    end
    return
  end
  junk = rterr('BASE', 1066, 'Argument error', 'FOR EACH')
  return

execswitch: procedure = .void
  arg s = .int
  v = evalnode(na[s])
  if ctl <> 0 then return
  c = nb[s]
  hit = 0
  do while c > 0
    if hit = 0 then do
      e = na[c]
      do while e > 0
        w = evalnode(e)
        if ctl <> 0 then return
        if exactv(v, w) = 1 then do
          hit = 1
          leave
        end
        e = nx[e]
      end
    end
    if hit = 1 then do
      call execstmts nb[c]
      if ctl <> 0 then do
        if ctl = 2 then ctl = 0
        return
      end
    end
    c = nx[c]
  end
  if hit = 0 & nc[s] > 0 then call execstmts nc[s]
  else if hit = 1 & nc[s] > 0 then call execstmts nc[s]
  if ctl = 2 then ctl = 0
  return

execsequence: procedure = .void
  arg s = .int
  seqdepth = seqdepth + 1
  call execstmts na[s]
  seqdepth = seqdepth - 1
  caught = 0
  if ctl = 4 then do
    caught = 1
    val = brkval
    ctl = 0
    if ne[s] = 1 then do
      if nc[s] > 0 then call assignto nc[s], val
      call execstmts nb[s]
    end
  end
  if nd[s] > 0 then do
    sc = ctl
    ctl = 0
    call execstmts nd[s]
    if ctl = 0 then ctl = sc
  end
  return

execprint: procedure = .void
  arg s = .int
  e = na[s]
  txt = ''
  first = 1
  do while e > 0
    v = evalnode(e)
    if ctl <> 0 then return
    if first = 0 then txt = txt || ' '
    txt = txt || valstr(v)
    if ctl <> 0 then return
    first = 0
    e = nx[e]
  end
  if setconsole = 0 then return
  if nb[s] = 1 then do
    if outstarted = 1 then call emitnl
  end
  call emit txt
  return

exectext: procedure = .void
  arg s = .int
  v = evalnode(na[s])
  txt = cstr[v]
  if nb[s] > 0 then do
    call assignto nb[s], mkstr(txt)
    return
  end
  if outstarted = 1 & outcol > 0 then call emitnl
  call emit txt
  call emitnl
  return

/* ===================================================================== */
/*                                ERRORS                                 */
/* ===================================================================== */
initerrclass: procedure = .void
  errcls = newclass('ERROR', 0)
  names = 'DESCRIPTION OPERATION SUBSYSTEM SUBCODE GENCODE SEVERITY FILENAME OSCODE TRIES ARGS CANRETRY CANDEFAULT CANSUBSTITUTE CARGO'
  do i = 1 to words(names)
    junk = adddata(errcls, intern(word(names, i)))
  end
  return

errset: procedure = .void
  arg obj = .int, nm = .string, v = .int
  sl = pm_get(2, errcls, intern(nm))
  call arrset ca1[obj], sl, v
  return

mkerror: procedure = .int
  arg sub = .string, code = .int, desc = .string, op = .string
  obj = newobject(errcls)
  call errset obj, 'DESCRIPTION', mkstr(desc)
  call errset obj, 'OPERATION', mkstr(op)
  call errset obj, 'SUBSYSTEM', mkstr(sub)
  call errset obj, 'SUBCODE', mkint(code)
  call errset obj, 'GENCODE', mkint(1)
  call errset obj, 'SEVERITY', mkint(2)
  call errset obj, 'FILENAME', mkstr('')
  call errset obj, 'OSCODE', mkint(0)
  call errset obj, 'TRIES', mkint(0)
  call errset obj, 'CANRETRY', 1
  call errset obj, 'CANDEFAULT', 1
  call errset obj, 'CANSUBSTITUTE', 1
  return obj

errmessage: procedure = .string
  arg obj = .int
  d = cstr[arrget(ca1[obj], pm_get(2, errcls, intern('DESCRIPTION')))]
  op = cstr[arrget(ca1[obj], pm_get(2, errcls, intern('OPERATION')))]
  sub = cstr[arrget(ca1[obj], pm_get(2, errcls, intern('SUBSYSTEM')))]
  code = intval(arrget(ca1[obj], pm_get(2, errcls, intern('SUBCODE'))))
  m = 'Error ' || sub || '/' || code || '  ' || d
  if op <> '' then m = m || ': ' || op
  return m

fatalerror: procedure = .void
  arg obj = .int
  call flushout
  if outcol > 0 then do
    call charout 'stdout', '0a'x
    outcol = 0
  end
  call errout errmessage(obj)
  i = pctop
  do while i >= 1
    msg = 'Called from ' || pcname[i] || '(' || pcln[i] || ')'
    call errout msg
    i = i - 1
  end
  call closeallareas
  exit 1

rterr: procedure = .int
  arg sub = .string, code = .int, desc = .string, op = .string
  if ctl = 4 then return 0
  obj = mkerror(sub, code, desc, op)
  if errblk <> 0 & errdepth = 0 then do
    errdepth = errdepth + 1
    junk = evalblock1(errblk, obj)
    errdepth = errdepth - 1
    if ctl <> 0 then return 0
    return 0
  end
  if seqdepth > 0 then do
    brkval = obj
    ctl = 4
    return 0
  end
  call fatalerror obj
  return 0

/* ===================================================================== */
/*                                OBJECTS                                */
/* ===================================================================== */
findmethod: procedure = .int
  arg cls = .int, sym = .int
  c = cls
  do while c > 0
    f = pm_get(1, c, sym)
    if f > 0 then return f
    c = clpar[c]
  end
  return 0

findslot: procedure = .int
  arg cls = .int, sym = .int
  c = cls
  do while c > 0
    s = pm_get(2, c, sym)
    if s > 0 then return s
    c = clpar[c]
  end
  return 0

findcdata: procedure = .int
  arg cls = .int, sym = .int
  c = cls
  do while c > 0
    s = pm_get(3, c, sym)
    if s > 0 then return s
    c = clpar[c]
  end
  return 0

isderived: procedure = .int
  arg cls = .int, anc = .int
  c = cls
  do while c > 0
    if c = anc then return 1
    c = clpar[c]
  end
  return 0

newobject: procedure = .int
  arg cl = .int
  obj = newcell(8)
  cint[obj] = cl
  ca1[obj] = mkarray(clnslot[cl])
  /* initial values, parents first */
  chain = .int[]
  nchain = 0
  c = cl
  do while c > 0
    nchain = nchain + 1
    chain[nchain] = c
    c = clpar[c]
  end
  do k = nchain to 1 by -1
    c = chain[k]
    do i = 1 to ncinit
      if cinitcls[i] = c then do
        v = evalnode(cinitnode[i])
        call arrset ca1[obj], cinitslot[i], v
      end
    end
  end
  return obj

nosuchmethod: procedure = .int
  arg obj = .int, sym = .int
  cn = 'NIL'
  if isobj(obj) = 1 then cn = clname[cint[obj]]
  else cn = typech(obj)
  return rterr('BASE', 1004, 'No exported method', cn || ':' || snm[sym])

evsend: procedure = .int
  arg n = .int
  onode = na[n]
  superm = 0
  obj = 0
  supcls = 0
  if nt[onode] = 35 then do
    obj = curself
    if na[onode] = 1 then superm = 1
    if na[onode] = 2 then do
      superm = 2
      supcls = scls[nb[onode]]
    end
  end
  else obj = evalnode(onode)
  if ctl <> 0 then return 0
  sym = nb[n]
  cnt = nd[n]
  if isobj(obj) = 0 then do
    junk = evalargs(nc[n], ftop, 0)
    return sendother(obj, sym, nc[n])
  end
  cls = cint[obj]
  sc = cls
  if superm = 1 then sc = clpar[curmcls]
  if superm = 2 then sc = supcls
  f = findmethod(sc, sym)
  if f > 0 then do
    base = ftop
    slots = fnslots[f]
    if cnt > slots then slots = cnt
    ftop = base + slots
    do i = 1 to slots
      fv[base + i] = 0
    end
    ok = evalargs(nc[n], base, fnpar[f])
    if ctl <> 0 then do
      ftop = base
      return 0
    end
    return invoke(f, base, cnt, obj, n)
  end
  sl = findslot(cls, sym)
  if sl > 0 then do
    junk = evalargs(nc[n], ftop, 0)
    return arrget(ca1[obj], sl)
  end
  cd = findcdata(cls, sym)
  if cd > 0 then do
    junk = evalargs(nc[n], ftop, 0)
    return deref(sv[cd])
  end
  /* built-in messages every object understands */
  nm = snm[sym]
  base = ftop
  ftop = base + cnt + 8
  do i = 1 to cnt + 8
    fv[base + i] = 0
  end
  ok = evalargs(nc[n], base, cnt)
  r = 0
  if ctl = 0 then r = objbuiltin(obj, sym, base, cnt)
  ftop = base
  return r

/* messages of every object; returns -1 if unknown (error raised) */
objbuiltin: procedure = .int
  arg obj = .int, sym = .int, base = .int, cnt = .int
  nm = snm[sym]
  cls = cint[obj]
  if nm == 'NEW' | nm == 'INIT' then return obj
  if nm == 'CLASSNAME' then return mkstr(clname[cls])
  if nm == 'ISDERIVEDFROM' | nm == 'ISKINDOF' then do
    a = fv[base + 1]
    if isstr(a) = 1 then do
      c2x = scls[intern(upper(cstr[a]))]
      return mklog(isderived(cls, c2x))
    end
    return 1
  end
  if nm == 'CLONE' then do
    o2 = newcell(8)
    cint[o2] = cls
    s1 = ca1[obj]
    s2 = mkarray(arrlen(s1))
    do i = 1 to arrlen(s1)
      call arrset s2, i, arrget(s1, i)
    end
    ca1[o2] = s2
    return o2
  end
  if nm == 'ISOBJECT' then return 2
  return nosuchmethod(obj, sym)

/* messages sent to something that is not an object */
sendother: procedure = .int
  arg obj = .int, sym = .int, args = .int
  return nosuchmethod(obj, sym)

sendassign: procedure = .void
  arg n = .int, val = .int
  onode = na[n]
  if nt[onode] = 35 then obj = curself
  else obj = evalnode(onode)
  if ctl <> 0 then return
  sym = nb[n]
  if isobj(obj) = 0 then do
    junk = rterr('BASE', 1005, 'No exported variable', snm[sym])
    return
  end
  cls = cint[obj]
  sl = findslot(cls, sym)
  if sl > 0 then do
    call arrset ca1[obj], sl, val
    return
  end
  cd = findcdata(cls, sym)
  if cd > 0 then do
    v = sv[cd]
    if v > 2 then do
      if ctag[v] = 9 then do
        ca1[v] = val
        return
      end
    end
    sv[cd] = val
    return
  end
  junk = rterr('BASE', 1005, 'No exported variable', clname[cls] || ':' || snm[sym])
  return

/* ===================================================================== */
/*                                MACROS                                 */
/* ===================================================================== */
compileexpr: procedure = .int
  arg s = .string
  key = intern('M$' || s)
  if smacro[key] > 0 then return smacro[key]
  otp = tp
  ontok = ntok
  ocx = curcx
  oinf = infunc
  onv = nvar
  ocf = curfn
  ofl = curline
  oblk = inblk
  start = ntok + 1
  perrflag = 0
  inblk = 0
  call lexchunk s, 0
  call addtok 5, '', 0
  call addtok 8, '', 0
  tp = start
  curcx = 0
  infunc = 0
  node = parseexpr()
  if tk[tp] <> 5 & perrflag = 0 then call perr 'Syntax error in macro near ' || ts[tp]
  bad = perrflag
  perrflag = 0
  tp = otp
  ntok = ontok
  curcx = ocx
  infunc = oinf
  nvar = onv
  curfn = ocf
  curline = ofl
  inblk = oblk
  if bad = 1 then return 0
  smacro[key] = node
  return node

macroeval: procedure = .int
  arg s = .string
  if strip(s) == '' then return 0
  node = compileexpr(s)
  if node = 0 then return rterr('BASE', 1449, 'Syntax error', 'macro: ' || s)
  return evalnode(node)

/* ===================================================================== */
/*                        HELPERS FOR THE LIBRARY                        */
/* ===================================================================== */
sarg: procedure = .string
  arg v = .int
  if isstr(v) = 1 then return cstr[v]
  return ''

iarg: procedure = .int
  arg v = .int, dflt = .int
  if isnum(v) = 1 then return toint(numval(v))
  return dflt

/* substring with xBase rules: start may be negative */
xsubstr: procedure = .string
  arg s = .string, st = .int, ln = .int
  n = length(s)
  if st < 0 then st = n + st + 1
  if st < 1 then st = 1
  if st > n then return ''
  if ln < 0 then ln = n - st + 1
  if ln = 0 then return ''
  return substr(s, st, ln)

/* the numeric part at the beginning of a string */
valnum: procedure = .int
  arg s = .string
  t = strip(s, 'L')
  n = length(t)
  i = 1
  if i <= n then do
    c = substr(t, i, 1)
    if c = '-' | c = '+' then i = i + 1
  end
  dig = 0
  dot = 0
  decs = 0
  do while i <= n
    c = substr(t, i, 1)
    if isdigitc(c) = 1 then do
      dig = dig + 1
      if dot = 1 then decs = decs + 1
    end
    else if c = '.' & dot = 0 then dot = 1
    else leave
    i = i + 1
  end
  if dig = 0 then return mkint(0)
  txt = substr(t, 1, i - 1)
  if left(txt, 1) = '+' then txt = substr(txt, 2)
  if dot = 0 then do
    if length(txt) < 17 then return mkint(txt as .int)
    return mknum(txt as .float, length(txt), 0)
  end
  if right(txt, 1) = '.' then txt = txt || '0'
  return mknum(txt as .float, length(txt), decs)

xtrimall: procedure = .string
  arg s = .string
  return strip(s)

xaspace: procedure = .string
  arg n = .int
  if n <= 0 then return ''
  return copies(' ', n)

isalphac: procedure = .int
  arg c = .string
  k = c2d(c)
  if k >= 65 & k <= 90 then return 1
  if k >= 97 & k <= 122 then return 1
  return 0

nextrand: procedure = .int
  seed = (seed * 1103515245 + 12345) % 2147483648
  return seed

/* position of a substring, with optional start/end */
xat: procedure = .int
  arg needle = .string, hay = .string, st = .int, en = .int
  if needle == '' then return 0
  if st < 1 then st = 1
  if en <= 0 | en > length(hay) then en = length(hay)
  if st > en then return 0
  seg = substr(hay, st, en - st + 1)
  p = pos(needle, seg)
  if p = 0 then return 0
  return p + st - 1

xrat: procedure = .int
  arg needle = .string, hay = .string
  if needle == '' then return 0
  return lastpos(needle, hay)

mkstrarr: procedure = .int
  arg n = .int
  return mkarray(n)

/* sort comparison: element order (block or default) */
sortless: procedure = .int
  arg a = .int, b = .int, blk = .int
  if blk > 0 then do
    r = evalblock2(blk, a, b)
    if r = 2 then return 1
    return 0
  end
  r = cmpv(a, b)
  if r = 2 then return 0
  if r < 0 then return 1
  return 0

/* merge sort of vdat[s..s+n-1] using tmp area */
msort: procedure = .void
  arg s = .int, n = .int, blk = .int
  if n < 2 then return
  tmp = nv + 1
  nv = nv + n
  w = 1
  do while w < n
    i = 0
    do while i < n
      lo = i
      mid = i + w
      if mid > n then mid = n
      hi = i + 2 * w
      if hi > n then hi = n
      a = lo
      b = mid
      k = lo
      do while a < mid & b < hi
        if sortless(vdat[s + b], vdat[s + a], blk) = 1 then do
          vdat[tmp + k] = vdat[s + b]
          b = b + 1
        end
        else do
          vdat[tmp + k] = vdat[s + a]
          a = a + 1
        end
        k = k + 1
        if ctl <> 0 then return
      end
      do while a < mid
        vdat[tmp + k] = vdat[s + a]
        a = a + 1
        k = k + 1
      end
      do while b < hi
        vdat[tmp + k] = vdat[s + b]
        b = b + 1
        k = k + 1
      end
      i = i + 2 * w
    end
    do j = 0 to n - 1
      vdat[s + j] = vdat[tmp + j]
    end
    w = w * 2
  end
  return

bitop: procedure = .int
  arg op = .int, a = .int, b = .int
  r = 0
  w = 1
  if a < 0 then a = 0 - a
  if b < 0 then b = 0 - b
  do 62
    x = a % 2
    y = b % 2
    z = 0
    if op = 1 then do
      if x = 1 & y = 1 then z = 1
    end
    else if op = 2 then do
      if x = 1 | y = 1 then z = 1
    end
    else do
      if x <> y then z = 1
    end
    r = r + z * w
    w = w * 2
    a = a / 2
    b = b / 2
  end
  return r

/* Array(n1, n2, ...) : nested arrays */
mkmulti: procedure = .int
  arg base = .int, lvl = .int, tot = .int
  k = fv[base + lvl]
  cnt = 0
  if isnum(k) = 1 then cnt = toint(numval(k))
  if cnt < 0 then cnt = 0
  a = mkarray(cnt)
  if lvl < tot then do
    do i = 1 to cnt
      call arrset a, i, mkmulti(base, lvl + 1, tot)
    end
  end
  return a

/* deep copy of arrays and hashes */
cloneval: procedure = .int
  arg v = .int
  if isarr(v) = 1 then do
    n = arrlen(v)
    a = mkarray(n)
    do i = 1 to n
      call arrset a, i, cloneval(arrget(v, i))
    end
    return a
  end
  if ishash(v) = 1 then do
    h = mkhash()
    do i = 1 to hashlen(v)
      call hset h, arrget(ca1[v], i), cloneval(arrget(ca2[v], i))
    end
    return h
  end
  return v

/* value as source text, for hb_ValToExp */
vtoexp: procedure = .string
  arg v = .int
  if isstr(v) = 1 then do
    s = cstr[v]
    if pos('"', s) = 0 then return '"' || s || '"'
    return "'" || s || "'"
  end
  if isdate(v) = 1 then return '0d' || dtos(cint[v])
  if isarr(v) = 1 then do
    r = '{'
    do i = 1 to arrlen(v)
      if i > 1 then r = r || ', '
      r = r || vtoexp(arrget(v, i))
    end
    return r || '}'
  end
  if ishash(v) = 1 then do
    r = '{'
    do i = 1 to hashlen(v)
      if i > 1 then r = r || ', '
      r = r || vtoexp(arrget(ca1[v], i)) || ' => ' || vtoexp(arrget(ca2[v], i))
    end
    if hashlen(v) = 0 then r = r || '=>'
    return r || '}'
  end
  return vtostr(v)

/* hb_StrFormat: %s %d %i %f %% */
strformat: procedure = .string
  arg base = .int, n = .int
  f = cstr[fv[base + 1]]
  r = ''
  k = 1
  i = 1
  do while i <= length(f)
    c = substr(f, i, 1)
    if c = '%' then do
      i = i + 1
      c = substr(f, i, 1)
      if c = '%' then r = r || '%'
      else do
        k = k + 1
        if k <= n then r = r || vtostr(fv[base + k])
      end
    end
    else r = r || c
    i = i + 1
  end
  return r

/* ===================================================================== */
/*                    CONSOLE INPUT, FILES AND TRANSFORM                 */
/* ===================================================================== */
/* read a line from standard input; sets ineof */
readcon: procedure = .string
  call flushout
  if inhave = 1 then do
    inhave = 0
    s = inbuf
    inbuf = ''
    return s
  end
  if lines() = 0 then do
    ineof = 1
    return ''
  end
  return linein()

/* one character from standard input: 13 at the end of a line, 0 at the end of input */
readkey: procedure = .int
  call flushout
  if inhave = 0 then do
    if lines() = 0 then do
      ineof = 1
      return 0
    end
    inbuf = linein()
    inhave = 1
  end
  if inbuf == '' then do
    inhave = 0
    return 13
  end
  c = c2d(left(inbuf, 1))
  inbuf = substr(inbuf, 2)
  return c

/* ------------------------------------------------------------- file table */
fhname = .string[]
fhdata = .string[]
fhpos = .int[]
fhopen = .int[]
fhdirty = .int[]
fhmode = .int[]
nfh = 0

bytesof: procedure = .string
  arg fname = .string
  b = readbinary(fname)
  return x2c(bin2x(b))

putbytes: procedure = .int
  arg fname = .string, s = .string
  hx = c2x(s)
  b = x2bin(hx)
  return writebinary(fname, b)

newhandle: procedure = .int
  arg fname = .string, data = .string, mode = .int
  h = 0
  do i = 1 to nfh
    if fhopen[i] = 0 then do
      h = i
      leave
    end
  end
  if h = 0 then do
    nfh = nfh + 1
    h = nfh
  end
  fhname[h] = fname
  fhdata[h] = data
  fhpos[h] = 0
  fhopen[h] = 1
  fhdirty[h] = 0
  fhmode[h] = mode
  return h + 2

fclosehandle: procedure = .int
  arg h = .int
  i = h - 2
  if i < 1 | i > nfh then return 0
  if fhopen[i] = 0 then return 0
  if fhdirty[i] = 1 then junk = putbytes(fhname[i], fhdata[i])
  fhopen[i] = 0
  fhdata[i] = ''
  return 1

closeallfiles: procedure = .void
  do i = 1 to nfh
    if fhopen[i] = 1 then junk = fclosehandle(i + 2)
  end
  return

/* ------------------------------------------------------------- Transform */
xtransform: procedure = .string
  arg v = .int, pic = .string
  fn = ''
  tmpl = pic
  if left(pic, 1) = '@' then do
    sp = pos(' ', pic)
    if sp = 0 then do
      fn = upper(substr(pic, 2))
      tmpl = ''
    end
    else do
      fn = upper(substr(pic, 2, sp - 2))
      tmpl = substr(pic, sp + 1)
    end
  end
  if isnum(v) = 1 then return transnum(v, fn, tmpl)
  if isstr(v) = 1 then do
    s = cstr[v]
    if pos('!', fn) > 0 then s = upper(s)
    if tmpl == '' then return s
    return transstr(s, fn, tmpl)
  end
  if islog(v) = 1 then do
    if pos('Y', fn) > 0 then do
      if v = 2 then return 'Y'
      return 'N'
    end
    if v = 2 then return 'T'
    return 'F'
  end
  if isdate(v) = 1 then do
    if pos('E', fn) > 0 then return datefmt(cint[v], 'dd/mm/yy')
    return datestr(cint[v])
  end
  return vtostr(v)

transstr: procedure = .string
  arg s = .string, fn = .string, tmpl = .string
  r = ''
  k = 1
  rmode = 0
  if pos('R', fn) > 0 then rmode = 1
  do i = 1 to length(tmpl)
    c = substr(tmpl, i, 1)
    uc = upper(c)
    slot = 0
    if uc = 'A' | uc = 'N' | uc = 'X' | c = '9' | c = '#' | c = '!' | uc = 'L' | uc = 'Y' then slot = 1
    if slot = 1 then do
      ch = ' '
      if k <= length(s) then ch = substr(s, k, 1)
      k = k + 1
      if c = '!' then ch = upper(ch)
      r = r || ch
    end
    else do
      if rmode = 1 then r = r || c
      else do
        ch = ' '
        if k <= length(s) then ch = substr(s, k, 1)
        k = k + 1
        r = r || c
      end
    end
  end
  return r

transnum: procedure = .string
  arg v = .int, fn = .string, tmpl = .string
  x = numval(v)
  if pos('Z', fn) > 0 & x = 0.0 then return copies(' ', max(length(tmpl), 1))
  if tmpl == '' then do
    if pos('B', fn) > 0 then return strip(numstr(v), 'L')
    return numstr(v)
  end
  /* decimals and integer slots */
  dp = pos('.', tmpl)
  nint = 0
  ndec = 0
  do i = 1 to length(tmpl)
    c = substr(tmpl, i, 1)
    if c = '9' | c = '#' | c = '*' | c = '$' then do
      if dp = 0 | i < dp then nint = nint + 1
      else ndec = ndec + 1
    end
  end
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  s = fmtfloat(x, ndec)
  ip = s
  fp = ''
  q = pos('.', s)
  if q > 0 then do
    ip = substr(s, 1, q - 1)
    fp = substr(s, q + 1)
  end
  if length(ip) > nint then do
    if nint > 0 | length(ip) > 1 | ip <> '0' then return copies('*', length(tmpl))
  end
  if ip == '0' & nint > 0 then do
    /* a zero integer part shows as blank unless the slot before the point is 9 */
    ip = '0'
  end
  fillc = ' '
  if pos('*', tmpl) > 0 then fillc = '*'
  ip = copies(fillc, nint - length(ip)) || ip
  out = ''
  ii = 1
  fi = 1
  seen = 0
  do i = 1 to length(tmpl)
    c = substr(tmpl, i, 1)
    if c = '9' | c = '#' | c = '*' | c = '$' then do
      if dp = 0 | i < dp then do
        ch = substr(ip, ii, 1)
        ii = ii + 1
        if ch <> ' ' & ch <> '*' then seen = 1
        else if c = '9' & ii > nint & dp > 0 & 0 = 1 then ch = '0'
        if c = '$' & ch = fillc then ch = '$'
        out = out || ch
      end
      else do
        ch = substr(fp, fi, 1)
        fi = fi + 1
        out = out || ch
      end
    end
    else if c = ',' then do
      if seen = 1 then out = out || ','
      else out = out || fillc
    end
    else out = out || c
  end
  if pos('E', fn) > 0 then do
    t = ''
    do i = 1 to length(out)
      c = substr(out, i, 1)
      if c = '.' then t = t || ','
      else if c = ',' then t = t || '.'
      else t = t || c
    end
    out = t
  end
  if neg = 1 then do
    if pos('(', fn) > 0 then out = '(' || strip(out, 'L') || ')'
    else do
      p = 1
      do while p <= length(out) & substr(out, p, 1) = ' '
        p = p + 1
      end
      if p > 1 then out = substr(out, 1, p - 2) || '-' || substr(out, p)
      else out = '-' || out
    end
  end
  if pos('B', fn) > 0 then do
    t = strip(out, 'L')
    out = t || copies(' ', length(out) - length(t))
  end
  if pos('C', fn) > 0 & neg = 0 then out = out || ' CR'
  if pos('X', fn) > 0 & neg = 1 then out = out || ' DB'
  return out

setdate: procedure = .void
  arg nm = .string
  u = upper(strip(nm))
  if u == 'AMERICAN' then setdatefmt = 'mm/dd/yy'
  else if u == 'ANSI' then setdatefmt = 'yy.mm.dd'
  else if u == 'BRITISH' | u == 'FRENCH' then setdatefmt = 'dd/mm/yy'
  else if u == 'GERMAN' then setdatefmt = 'dd.mm.yy'
  else if u == 'ITALIAN' then setdatefmt = 'dd-mm-yy'
  else if u == 'JAPAN' then setdatefmt = 'yy/mm/dd'
  else if u == 'USA' then setdatefmt = 'mm-dd-yy'
  else if u == 'DUTCH' then setdatefmt = 'dd-mm-yy'
  else if u == 'SPANISH' then setdatefmt = 'dd-mm-yy'
  else setdatefmt = lower(strip(nm))
  return

/* move the cursor: new lines or blanks, as far as a line oriented console can */
gotopos: procedure = .void
  arg r = .int, c = .int
  if r > scrrow then do
    do while scrrow < r
      call emitnl
    end
  end
  else if r < scrrow & outcol > 0 then call emitnl
  if c > outcol then call emit copies(' ', c - outcol)
  return

/* ===================================================================== */
/*                  WORK AREAS, DBF TABLES AND INDEXES                   */
/* ===================================================================== */
initareas: procedure = .void
  curarea = 1
  return

/* byte helpers on strings holding one byte per character */
le: procedure = .int
  arg d = .string, p = .int, nbl = .int
  r = 0
  m = 1
  do i = 0 to nbl - 1
    r = r + c2d(substr(d, p + i, 1)) * m
    m = m * 256
  end
  return r

leb: procedure = .string
  arg v = .int, nbl = .int
  r = ''
  do i = 1 to nbl
    r = r || d2c(v % 256)
    v = v / 256
  end
  return r

latin: procedure = .string
  arg s = .string
  /* characters above 255 cannot be stored in a DBF */
  r = ''
  do i = 1 to length(s)
    c = substr(s, i, 1)
    if c2d(c) > 255 then r = r || '?'
    else r = r || c
  end
  return r

ridx: procedure = .int
  arg a = .int, r = .int
  return (a - 1) * 100000 + r

fidx: procedure = .int
  arg a = .int, f = .int
  return (a - 1) * 256 + f

areaok: procedure = .int
  arg a = .int
  if a < 1 then return 0
  if wa_used[a] = 1 then return 1
  return 0

findfreearea: procedure = .int
  do a = 1 to 40
    if wa_used[a] = 0 then return a
  end
  return 0

aliasarea: procedure = .int
  arg nm = .string
  do a = 1 to 40
    if wa_used[a] = 1 then do
      if wa_alias[a] == nm then return a
    end
  end
  return 0

fieldfind: procedure = .int
  arg a = .int, sym = .int
  if a < 1 then return 0
  if wa_used[a] = 0 then return 0
  b = (a - 1) * 256
  do f = 1 to wa_nfld[a]
    if fsym[b + f] = sym then return f
  end
  return 0

noarea: procedure = .int
  return rterr('DBFNTX', 2001, 'Workarea not in use', '')

/* ---------------------------------------------------------------- fields */
fieldval: procedure = .int
  arg a = .int, f = .int
  r = wa_recno[a]
  if wa_eof[a] = 1 | r < 1 | r > wa_nrec[a] then return blankfield(a, f)
  s = recs[ridx(a, r)]
  i = fidx(a, f)
  raw = substr(s, foff[i] + 1, flen[i])
  t = ftyp[i]
  if t == 'C' then return mkstr(raw)
  if t == 'N' | t == 'F' then do
    v = strip(raw)
    if v == '' | v == '.' | v == '-' then return mknum(0.0, flen[i], fdec[i])
    if fdec[i] = 0 & pos('.', v) = 0 & length(v) < 17 then return mkint(v as .int)
    return mknum(v as .float, flen[i], fdec[i])
  end
  if t == 'L' then do
    c = upper(left(raw, 1))
    if c == 'T' | c == 'Y' then return 2
    return 1
  end
  if t == 'D' then do
    if strip(raw) == '' then return mkdate(0)
    return datelit(raw)
  end
  if t == 'M' then return mkstr(memoread(a, strip(raw)))
  return mkstr(raw)

blankfield: procedure = .int
  arg a = .int, f = .int
  i = fidx(a, f)
  t = ftyp[i]
  if t == 'C' then return mkstr(copies(' ', flen[i]))
  if t == 'N' | t == 'F' then return mknum(0.0, flen[i], fdec[i])
  if t == 'L' then return 1
  if t == 'D' then return mkdate(0)
  return mkstr('')

/* the stored text of a value for field i, or '' + error */
fieldtext: procedure = .string
  arg a = .int, i = .int, v = .int
  t = ftyp[i]
  w = flen[i]
  if t == 'C' then do
    if isstr(v) = 0 then do
      junk = rterr('DBFNTX', 1020, 'Data type error', wa_alias[a])
      return ''
    end
    s = latin(cstr[v])
    if length(s) >= w then return left(s, w)
    return s || copies(' ', w - length(s))
  end
  if t == 'N' | t == 'F' then do
    if isnum(v) = 0 then do
      junk = rterr('DBFNTX', 1020, 'Data type error', wa_alias[a])
      return ''
    end
    s = fmtfloat(numval(v), fdec[i])
    if length(s) > w then return copies('*', w)
    return padleft(s, w)
  end
  if t == 'L' then do
    if islog(v) = 0 then do
      junk = rterr('DBFNTX', 1020, 'Data type error', wa_alias[a])
      return ''
    end
    if v = 2 then return 'T'
    return 'F'
  end
  if t == 'D' then do
    if isdate(v) = 0 then do
      junk = rterr('DBFNTX', 1020, 'Data type error', wa_alias[a])
      return ''
    end
    return dtos(cint[v])
  end
  if t == 'M' then do
    if isstr(v) = 0 then do
      junk = rterr('DBFNTX', 1020, 'Data type error', wa_alias[a])
      return ''
    end
    return memowrite(a, cstr[v])
  end
  return copies(' ', w)

fieldput: procedure = .void
  arg a = .int, f = .int, v = .int
  if wa_used[a] = 0 then do
    junk = noarea()
    return
  end
  r = wa_recno[a]
  if wa_eof[a] = 1 | r < 1 | r > wa_nrec[a] then return
  i = fidx(a, f)
  txt = fieldtext(a, i, v)
  if ctl <> 0 then return
  if wa_nix[a] > 0 then call keysbefore a, r
  k = ridx(a, r)
  s = recs[k]
  recs[k] = substr(s, 1, foff[i]) || txt || substr(s, foff[i] + flen[i] + 1)
  wa_dirty[a] = 1
  if wa_nix[a] > 0 then call keysafter a, r
  return

/* memo fields: .dbt file kept in memory */
memoread: procedure = .string
  arg a = .int, blk = .string
  if blk == '' then return ''
  b = blk as .int
  if b < 1 then return ''
  d = wa_memo[a]
  p = b * 512 + 1
  if p > length(d) then return ''
  q = pos('1a1a'x, d, p)
  if q = 0 then return substr(d, p)
  return substr(d, p, q - p)

memowrite: procedure = .string
  arg a = .int, txt = .string
  if txt == '' then return copies(' ', 10)
  d = wa_memo[a]
  if length(d) < 512 then d = copies('00'x, 512)
  /* pad to a block boundary */
  rem = length(d) % 512
  if rem <> 0 then d = d || copies('00'x, 512 - rem)
  blk = length(d) / 512
  d = d || latin(txt) || '1a1a'x
  wa_memo[a] = d
  wa_hasmemo[a] = 1
  s = blk || ''
  return padleft(s, 10)

/* --------------------------------------------------------------- opening */
dbfstem: procedure = .string
  arg f = .string
  k = lastpos('/', f)
  s = f
  if k > 0 then s = substr(f, k + 1)
  k = lastpos('.', s)
  if k > 1 then s = substr(s, 1, k - 1)
  return upper(s)

dbfname: procedure = .string
  arg f = .string
  k = lastpos('/', f)
  b = f
  if k > 0 then b = substr(f, k + 1)
  if pos('.', b) = 0 then return f || '.dbf'
  return f

openarea: procedure = .int
  arg a = .int, fname = .string, alias = .string, ro = .int
  fn = dbfname(fname)
  if fileexists(fn) = 0 then do
    junk = rterr('DBFNTX', 1001, 'Open error', fn)
    return 0
  end
  d = bytesof(fn)
  if length(d) < 33 then do
    junk = rterr('DBFNTX', 1003, 'Corruption detected', fn)
    return 0
  end
  nrec = le(d, 5, 4)
  hdr = le(d, 9, 2)
  rl = le(d, 11, 2)
  nfl = (hdr - 33) / 32
  if nfl > 255 then nfl = 255
  base = (a - 1) * 256
  off = 1
  do f = 1 to nfl
    p = 33 + (f - 1) * 32
    nm = upper(strip(translate(substr(d, p, 11), ' ', '00'x)))
    fnam[base + f] = nm
    fsym[base + f] = intern(nm)
    ftyp[base + f] = upper(substr(d, p + 11, 1))
    flen[base + f] = c2d(substr(d, p + 16, 1))
    fdec[base + f] = c2d(substr(d, p + 17, 1))
    foff[base + f] = off
    off = off + flen[base + f]
  end
  wa_used[a] = 1
  wa_alias[a] = alias
  wa_file[a] = fn
  wa_nrec[a] = nrec
  wa_nfld[a] = nfl
  wa_hdr[a] = hdr
  wa_reclen[a] = rl
  wa_dirty[a] = 0
  wa_order[a] = 0
  wa_ipos[a] = 0
  wa_nix[a] = 0
  wa_filter[a] = 0
  wa_filtertxt[a] = ''
  wa_ro[a] = ro
  wa_nrel[a] = 0
  wa_hasmemo[a] = 0
  wa_memo[a] = ''
  wa_blank[a] = ' ' || copies(' ', rl - 1)
  do r = 1 to nrec
    recs[ridx(a, r)] = substr(d, hdr + (r - 1) * rl + 1, rl)
  end
  /* memo file */
  do f = 1 to nfl
    if ftyp[base + f] == 'M' then do
      mf = changestr('.dbf', fn, '.dbt')
      if mf == fn then mf = fn || '.dbt'
      wa_hasmemo[a] = 1
      if fileexists(mf) = 1 then wa_memo[a] = bytesof(mf)
      leave
    end
  end
  wa_recno[a] = 1
  wa_eof[a] = 0
  wa_bof[a] = 0
  wa_found[a] = 0
  if nrec = 0 then do
    wa_eof[a] = 1
    wa_bof[a] = 1
  end
  return 1

flushdbf: procedure = .void
  arg a = .int
  if wa_used[a] = 0 then return
  if wa_dirty[a] = 0 | wa_ro[a] = 1 then return
  nrec = wa_nrec[a]
  rl = wa_reclen[a]
  nfl = wa_nfld[a]
  base = (a - 1) * 256
  ver = 3
  if wa_hasmemo[a] = 1 then ver = 131
  ds = date('S')
  tj = ymd2jdn(substr(ds, 1, 4) as .int, substr(ds, 5, 2) as .int, substr(ds, 7, 2) as .int)
  call jdn2ymd tj
  h = d2c(ver) || d2c(gy % 100) || d2c(gm) || d2c(gd) || leb(nrec, 4) || leb(wa_hdr[a], 2) || leb(rl, 2) || copies('00'x, 20)
  do f = 1 to nfl
    nm = fnam[base + f]
    h = h || left(nm, 10, '00'x) || '00'x || ftyp[base + f] || copies('00'x, 4) || d2c(flen[base + f]) || d2c(fdec[base + f]) || copies('00'x, 14)
  end
  h = h || '0d'x
  chunk = ''
  body = ''
  do r = 1 to nrec
    chunk = chunk || recs[ridx(a, r)]
    if r % 200 = 0 then do
      body = body || chunk
      chunk = ''
    end
  end
  body = body || chunk
  junk = putbytes(wa_file[a], h || body || '1a'x)
  if wa_hasmemo[a] = 1 then do
    mf = changestr('.dbf', wa_file[a], '.dbt')
    if mf == wa_file[a] then mf = wa_file[a] || '.dbt'
    d = wa_memo[a]
    if length(d) < 512 then d = copies('00'x, 512)
    nbl = length(d) / 512 + 1
    d = leb(nbl, 4) || substr(d, 5)
    junk = putbytes(mf, d)
  end
  wa_dirty[a] = 0
  return

closearea: procedure = .void
  arg a = .int
  if a < 1 | wa_used[a] = 0 then return
  call flushindexes a
  call flushdbf a
  do r = 1 to wa_nrec[a]
    recs[ridx(a, r)] = ''
  end
  wa_used[a] = 0
  wa_nix[a] = 0
  wa_order[a] = 0
  wa_nrel[a] = 0
  wa_filter[a] = 0
  return

closeallareas: procedure = .void
  do a = 1 to 40
    if wa_used[a] = 1 then call closearea a
  end
  call closeallfiles
  return

/* create a new table; stru is an array of {name, type, len, dec} arrays */
createdbf: procedure = .int
  arg fname = .string, stru = .int
  fn = dbfname(fname)
  nfl = arrlen(stru)
  rl = 1
  hasmemo = 0
  h = ''
  do f = 1 to nfl
    e = arrget(stru, f)
    if isarr(e) = 0 | arrlen(e) < 4 then return argerr('DBCREATE')
    nm = upper(sarg(arrget(e, 1)))
    ty = upper(left(sarg(arrget(e, 2)), 1))
    ln = iarg(arrget(e, 3), 10)
    dc = iarg(arrget(e, 4), 0)
    if ty == 'D' then ln = 8
    if ty == 'L' then ln = 1
    if ty == 'M' then do
      ln = 10
      hasmemo = 1
    end
    h = h || left(nm, 10, '00'x) || '00'x || ty || copies('00'x, 4) || d2c(ln) || d2c(dc) || copies('00'x, 14)
    rl = rl + ln
  end
  hdr = 32 + nfl * 32 + 1
  ver = 3
  if hasmemo = 1 then ver = 131
  head = d2c(ver) || d2c(26) || d2c(1) || d2c(1) || leb(0, 4) || leb(hdr, 2) || leb(rl, 2) || copies('00'x, 20) || h || '0d'x
  junk = putbytes(fn, head || '1a'x)
  if hasmemo = 1 then do
    mf = changestr('.dbf', fn, '.dbt')
    if mf == fn then mf = fn || '.dbt'
    junk = putbytes(mf, leb(1, 4) || copies('00'x, 508))
  end
  return 1

/* ---------------------------------------------------------- navigation */
passes: procedure = .int
  /* does the current record of area a pass SET DELETED and the filter? */
  arg a = .int
  if setdeleted = 1 then do
    if substr(recs[ridx(a, wa_recno[a])], 1, 1) = '*' then return 0
  end
  fnode = wa_filter[a]
  if fnode > 0 then do
    old = curarea
    curarea = a
    c = evalnode(fnode)
    curarea = old
    if c <> 2 then return 0
  end
  return 1

setrec: procedure = .void
  arg a = .int, r = .int
  if r < 1 | r > wa_nrec[a] then do
    wa_eof[a] = 1
    wa_recno[a] = wa_nrec[a] + 1
    return
  end
  wa_eof[a] = 0
  wa_recno[a] = r
  return

/* position on ordered index entry p (or eof if out of range) */
setipos: procedure = .void
  arg a = .int, p = .int
  id = wa_order[a]
  if p < 1 | p > ix_len[id] then do
    wa_eof[a] = 1
    wa_ipos[a] = ix_len[id] + 1
    wa_recno[a] = wa_nrec[a] + 1
    return
  end
  wa_ipos[a] = p
  wa_eof[a] = 0
  wa_recno[a] = ixr[ix_start[id] + p - 1]
  return

movenext: procedure = .void
  /* one step forward in the active order, ignoring filters */
  arg a = .int
  id = wa_order[a]
  if id = 0 then call setrec a, wa_recno[a] + 1
  else call setipos a, wa_ipos[a] + 1
  return

moveprev: procedure = .void
  arg a = .int
  id = wa_order[a]
  if id = 0 then do
    if wa_recno[a] <= 1 then do
      wa_bof[a] = 1
      wa_eof[a] = 0
      wa_recno[a] = 1
      if wa_nrec[a] = 0 then wa_eof[a] = 1
      return
    end
    call setrec a, wa_recno[a] - 1
  end
  else do
    p = wa_ipos[a] - 1
    if wa_eof[a] = 1 then p = ix_len[id]
    if p < 1 then do
      wa_bof[a] = 1
      call setipos a, 1
      if ix_len[id] = 0 then wa_eof[a] = 1
      return
    end
    call setipos a, p
  end
  return

dbgotop: procedure = .void
  arg a = .int
  if wa_used[a] = 0 then do
    junk = noarea()
    return
  end
  wa_bof[a] = 0
  id = wa_order[a]
  if id = 0 then call setrec a, 1
  else call setipos a, 1
  do while wa_eof[a] = 0
    if passes(a) = 1 then leave
    call movenext a
  end
  if wa_nrec[a] = 0 | wa_eof[a] = 1 then wa_bof[a] = 1
  call relsync a
  return

dbgobottom: procedure = .void
  arg a = .int
  if wa_used[a] = 0 then do
    junk = noarea()
    return
  end
  wa_bof[a] = 0
  id = wa_order[a]
  if id = 0 then call setrec a, wa_nrec[a]
  else call setipos a, ix_len[id]
  do while wa_eof[a] = 0
    if passes(a) = 1 then leave
    call moveprev a
    if wa_bof[a] = 1 then do
      wa_eof[a] = 1
      wa_recno[a] = wa_nrec[a] + 1
    end
  end
  if wa_nrec[a] = 0 then wa_bof[a] = 1
  call relsync a
  return

dbgoto: procedure = .void
  arg a = .int, r = .int
  if wa_used[a] = 0 then do
    junk = noarea()
    return
  end
  wa_bof[a] = 0
  if r < 1 | r > wa_nrec[a] then do
    wa_eof[a] = 1
    wa_recno[a] = wa_nrec[a] + 1
    return
  end
  wa_eof[a] = 0
  wa_recno[a] = r
  id = wa_order[a]
  if id > 0 then wa_ipos[a] = ixfind(id, a, r)
  call relsync a
  return

dbskip: procedure = .void
  arg a = .int, n = .int
  if wa_used[a] = 0 then do
    junk = noarea()
    return
  end
  if n = 0 then return
  if n > 0 then do
    wa_bof[a] = 0
    do k = 1 to n
      if wa_eof[a] = 1 then leave
      call movenext a
      do while wa_eof[a] = 0
        if passes(a) = 1 then leave
        call movenext a
      end
    end
  end
  else do
    do k = 1 to 0 - n
      call moveprev a
      if wa_bof[a] = 1 then do
        /* hit the top: stay on the first visible record */
        do while wa_eof[a] = 0
          if passes(a) = 1 then leave
          call movenext a
        end
        leave
      end
      do while passes(a) = 0
        call moveprev a
        if wa_bof[a] = 1 then do
          do while wa_eof[a] = 0
            if passes(a) = 1 then leave
            call movenext a
          end
          leave
        end
      end
    end
  end
  call relsync a
  return

/* append a blank record */
dbappend: procedure = .void
  arg a = .int
  if wa_used[a] = 0 then do
    junk = noarea()
    return
  end
  if wa_ro[a] = 1 then do
    junk = rterr('DBFNTX', 1021, 'Read only', wa_alias[a])
    return
  end
  n = wa_nrec[a] + 1
  recs[ridx(a, n)] = wa_blank[a]
  wa_nrec[a] = n
  wa_recno[a] = n
  wa_eof[a] = 0
  wa_bof[a] = 0
  wa_dirty[a] = 1
  if wa_nix[a] > 0 then call keysappend a, n
  call relsync a
  return

dbdelete: procedure = .void
  arg a = .int, flag = .int
  if wa_used[a] = 0 then do
    junk = noarea()
    return
  end
  r = wa_recno[a]
  if wa_eof[a] = 1 | r < 1 | r > wa_nrec[a] then return
  k = ridx(a, r)
  c = ' '
  if flag = 1 then c = '*'
  recs[k] = c || substr(recs[k], 2)
  wa_dirty[a] = 1
  return

isdeleted: procedure = .int
  arg a = .int
  r = wa_recno[a]
  if wa_eof[a] = 1 | r < 1 | r > wa_nrec[a] then return 0
  if substr(recs[ridx(a, r)], 1, 1) = '*' then return 1
  return 0

dbpack: procedure = .void
  arg a = .int
  n = 0
  do r = 1 to wa_nrec[a]
    s = recs[ridx(a, r)]
    if substr(s, 1, 1) <> '*' then do
      n = n + 1
      recs[ridx(a, n)] = s
    end
  end
  do r = n + 1 to wa_nrec[a]
    recs[ridx(a, r)] = ''
  end
  wa_nrec[a] = n
  wa_dirty[a] = 1
  call reindexall a
  call dbgotop a
  return

dbzap: procedure = .void
  arg a = .int
  do r = 1 to wa_nrec[a]
    recs[ridx(a, r)] = ''
  end
  wa_nrec[a] = 0
  wa_dirty[a] = 1
  call reindexall a
  call dbgotop a
  return

/* ---------------------------------------------------------------- indexes */
evalkey: procedure = .int
  arg a = .int, id = .int, r = .int
  old = curarea
  oldrec = wa_recno[a]
  oldeof = wa_eof[a]
  curarea = a
  wa_recno[a] = r
  wa_eof[a] = 0
  v = evalnode(ix_node[id])
  wa_recno[a] = oldrec
  wa_eof[a] = oldeof
  curarea = old
  return v

/* ordering of two index entries (key, recno) */
ixcmp: procedure = .int
  arg id = .int, k1 = .int, r1 = .int, k2 = .int, r2 = .int
  c = cmpv(k1, k2)
  if c = 2 then c = 0
  if ix_desc[id] = 1 then c = 0 - c
  if c <> 0 then return c
  if r1 < r2 then return -1
  if r1 > r2 then return 1
  return 0

/* position where (key, recno) belongs: first entry that is >= it */
ixlower: procedure = .int
  arg id = .int, k = .int, r = .int
  lo = 1
  hi = ix_len[id] + 1
  s = ix_start[id]
  do while lo < hi
    mid = (lo + hi) / 2
    if ixcmp(id, ixk[s + mid - 1], ixr[s + mid - 1], k, r) < 0 then lo = mid + 1
    else hi = mid
  end
  return lo

ixfind: procedure = .int
  arg id = .int, a = .int, r = .int
  k = evalkey(a, id, r)
  p = ixlower(id, k, r)
  s = ix_start[id]
  if p <= ix_len[id] then do
    if ixr[s + p - 1] = r then return p
  end
  /* fall back to a scan */
  do p = 1 to ix_len[id]
    if ixr[s + p - 1] = r then return p
  end
  return ix_len[id] + 1

ixinsert: procedure = .void
  arg id = .int, k = .int, r = .int
  n = ix_len[id]
  if n >= ix_cap[id] then do
    ncap = n * 2 + 64
    nsta = nixpool + 1
    os = ix_start[id]
    do i = 0 to n - 1
      ixk[nsta + i] = ixk[os + i]
      ixr[nsta + i] = ixr[os + i]
    end
    ix_start[id] = nsta
    ix_cap[id] = ncap
    nixpool = nixpool + ncap
  end
  p = ixlower(id, k, r)
  s = ix_start[id]
  do i = n to p by -1
    ixk[s + i] = ixk[s + i - 1]
    ixr[s + i] = ixr[s + i - 1]
  end
  ixk[s + p - 1] = k
  ixr[s + p - 1] = r
  ix_len[id] = n + 1
  ix_dirty[id] = 1
  return

ixremove: procedure = .void
  arg id = .int, p = .int
  n = ix_len[id]
  s = ix_start[id]
  do i = p to n - 1
    ixk[s + i - 1] = ixk[s + i]
    ixr[s + i - 1] = ixr[s + i]
  end
  ix_len[id] = n - 1
  ix_dirty[id] = 1
  return

okeys = .int[]
keysbefore: procedure = .void
  arg a = .int, r = .int
  do j = 1 to wa_nix[a]
    id = waix[(a - 1) * 8 + j]
    okeys[j] = evalkey(a, id, r)
  end
  return

keysafter: procedure = .void
  arg a = .int, r = .int
  do j = 1 to wa_nix[a]
    id = waix[(a - 1) * 8 + j]
    nk = evalkey(a, id, r)
    ok = okeys[j]
    if ixcmp(id, ok, r, nk, r) <> 0 then do
      p = ixlower(id, ok, r)
      s = ix_start[id]
      if p <= ix_len[id] then do
        if ixr[s + p - 1] = r then call ixremove id, p
      end
      call ixinsert id, nk, r
      if wa_order[a] = id then wa_ipos[a] = ixfind(id, a, r)
    end
  end
  return

keysappend: procedure = .void
  arg a = .int, r = .int
  do j = 1 to wa_nix[a]
    id = waix[(a - 1) * 8 + j]
    k = evalkey(a, id, r)
    call ixinsert id, k, r
    if wa_order[a] = id then wa_ipos[a] = ixfind(id, a, r)
  end
  return

/* build the index id from scratch */
ixbuild: procedure = .void
  arg id = .int
  a = ix_area[id]
  ix_len[id] = 0
  ix_cap[id] = wa_nrec[a] + 64
  ix_start[id] = nixpool + 1
  nixpool = nixpool + ix_cap[id]
  /* collect then sort by merge sort on (key, recno) */
  n = 0
  s = ix_start[id]
  do r = 1 to wa_nrec[a]
    ok = 1
    if ix_for[id] > 0 then do
      old = curarea
      oldrec = wa_recno[a]
      curarea = a
      wa_recno[a] = r
      wa_eof[a] = 0
      c = evalnode(ix_for[id])
      wa_recno[a] = oldrec
      curarea = old
      if c <> 2 then ok = 0
    end
    if ok = 1 then do
      k = evalkey(a, id, r)
      if ctl <> 0 then return
      n = n + 1
      ixk[s + n - 1] = k
      ixr[s + n - 1] = r
    end
  end
  ix_len[id] = n
  call ixsort id
  if ix_uniq[id] = 1 then call ixunique id
  ix_dirty[id] = 1
  return

ixsort: procedure = .void
  arg id = .int
  n = ix_len[id]
  s = ix_start[id]
  if n < 2 then return
  tk2 = nixpool + 1
  nixpool = nixpool + 2 * n
  tr2 = tk2 + n
  w = 1
  do while w < n
    i = 0
    do while i < n
      lo = i
      mid = i + w
      if mid > n then mid = n
      hi = i + 2 * w
      if hi > n then hi = n
      p = lo
      q = mid
      k = lo
      do while p < mid & q < hi
        if ixcmp(id, ixk[s + q], ixr[s + q], ixk[s + p], ixr[s + p]) < 0 then do
          ixk[tk2 + k] = ixk[s + q]
          ixr[tk2 + k] = ixr[s + q]
          q = q + 1
        end
        else do
          ixk[tk2 + k] = ixk[s + p]
          ixr[tk2 + k] = ixr[s + p]
          p = p + 1
        end
        k = k + 1
      end
      do while p < mid
        ixk[tk2 + k] = ixk[s + p]
        ixr[tk2 + k] = ixr[s + p]
        p = p + 1
        k = k + 1
      end
      do while q < hi
        ixk[tk2 + k] = ixk[s + q]
        ixr[tk2 + k] = ixr[s + q]
        q = q + 1
        k = k + 1
      end
      i = i + 2 * w
    end
    do j = 0 to n - 1
      ixk[s + j] = ixk[tk2 + j]
      ixr[s + j] = ixr[tk2 + j]
    end
    w = w * 2
  end
  return

ixunique: procedure = .void
  arg id = .int
  n = ix_len[id]
  s = ix_start[id]
  m = 0
  do i = 0 to n - 1
    if m = 0 then dup = 0
    else if cmpv(ixk[s + m - 1], ixk[s + i]) = 0 then dup = 1
    else dup = 0
    if dup = 0 then do
      ixk[s + m] = ixk[s + i]
      ixr[s + m] = ixr[s + i]
      m = m + 1
    end
  end
  ix_len[id] = m
  return

ixfilename: procedure = .string
  arg f = .string
  k = lastpos('/', f)
  b = f
  if k > 0 then b = substr(f, k + 1)
  if pos('.', b) = 0 then return f || '.xdx'
  return f

/* INDEX ON expr TO file : creates and activates the index in area a */
createindex: procedure = .int
  arg a = .int, keynode = .int, fname = .string, fornode = .int, fl = .int, keytext = .string, fortext = .string
  if wa_nix[a] >= 8 then return rterr('DBFNTX', 1011, 'Too many indexes', wa_alias[a])
  nix = nix + 1
  id = nix
  ix_area[id] = a
  ix_node[id] = keynode
  ix_text[id] = keytext
  ix_fortext[id] = fortext
  ix_for[id] = fornode
  ix_uniq[id] = fl % 2
  ix_desc[id] = (fl / 2) % 2
  ix_file[id] = ''
  if fname <> '' then ix_file[id] = ixfilename(fname)
  ix_name[id] = upper(dbfstem(fname))
  ix_dirty[id] = 1
  ixk[nixpool + 1] = 0
  call ixbuild id
  if ctl <> 0 then return 0
  wa_nix[a] = wa_nix[a] + 1
  waix[(a - 1) * 8 + wa_nix[a]] = id
  wa_order[a] = id
  call ixwrite id
  call dbgotop a
  return id

/* index files hold the key text, the flags and the record order */
ixwrite: procedure = .void
  arg id = .int
  if ix_file[id] == '' then return
  a = ix_area[id]
  t = 'XDX1' || '0a'x || ix_text[id] || '0a'x || ix_fortext[id] || '0a'x || ix_uniq[id] || ' ' || ix_desc[id] || ' ' || wa_nrec[a] || '0a'x
  chunk = ''
  body = ''
  s = ix_start[id]
  do i = 0 to ix_len[id] - 1
    chunk = chunk || ixr[s + i] || ' '
    if i % 200 = 199 then do
      body = body || chunk
      chunk = ''
    end
  end
  junk = putbytes(ix_file[id], t || body || chunk)
  ix_dirty[id] = 0
  return

flushindexes: procedure = .void
  arg a = .int
  do j = 1 to wa_nix[a]
    id = waix[(a - 1) * 8 + j]
    if ix_dirty[id] = 1 then call ixwrite id
  end
  return

reindexall: procedure = .void
  arg a = .int
  do j = 1 to wa_nix[a]
    id = waix[(a - 1) * 8 + j]
    call ixbuild id
    if ix_file[id] <> '' then call ixwrite id
  end
  if wa_order[a] > 0 then wa_ipos[a] = 1
  return

/* attach an existing index file */
openindex: procedure = .int
  arg a = .int, fname = .string
  fn = ixfilename(fname)
  if fileexists(fn) = 0 then return rterr('DBFNTX', 1001, 'Open error', fn)
  t = loadtext(fn, '0a'x, 'noraise')
  p1 = pos('0a'x, t)
  p2 = pos('0a'x, t, p1 + 1)
  p3 = pos('0a'x, t, p2 + 1)
  p4 = pos('0a'x, t, p3 + 1)
  keytext = substr(t, p1 + 1, p2 - p1 - 1)
  fortext = substr(t, p2 + 1, p3 - p2 - 1)
  flags = substr(t, p3 + 1, p4 - p3 - 1)
  node = compileexpr(keytext)
  if node = 0 then return rterr('DBFNTX', 1004, 'Index key error', keytext)
  fnode = 0
  if fortext <> '' then fnode = compileexpr(fortext)
  fl = (word(flags, 1) as .int) + 2 * (word(flags, 2) as .int)
  id = createindex(a, node, fn, fnode, fl, keytext, fortext)
  return id

/* ------------------------------------------------------------------- seek */
cmpseek: procedure = .int
  arg k = .int, v = .int
  if isstr(k) = 1 & isstr(v) = 1 then do
    c = strcmp(left(cstr[k], length(cstr[v])), cstr[v])
    return c
  end
  c = cmpv(k, v)
  if c = 2 then return 0
  return c

dbseek: procedure = .int
  arg a = .int, v = .int, soft = .int
  if wa_used[a] = 0 then return noarea()
  id = wa_order[a]
  if id = 0 then return rterr('DBFNTX', 2001, 'No active order', wa_alias[a])
  s = ix_start[id]
  lo = 1
  hi = ix_len[id] + 1
  do while lo < hi
    mid = (lo + hi) / 2
    c = cmpseek(ixk[s + mid - 1], v)
    if ix_desc[id] = 1 then c = 0 - c
    if c < 0 then lo = mid + 1
    else hi = mid
  end
  wa_bof[a] = 0
  found = 0
  p = lo
  /* skip entries that are filtered out */
  do while p <= ix_len[id]
    call setipos a, p
    c = cmpseek(ixk[s + p - 1], v)
    if c <> 0 then leave
    if passes(a) = 1 then do
      found = 1
      leave
    end
    p = p + 1
  end
  if found = 0 then do
    if soft = 1 | setsoft = 1 then do
      call setipos a, p
      do while wa_eof[a] = 0
        if passes(a) = 1 then leave
        call movenext a
      end
    end
    else do
      wa_eof[a] = 1
      wa_recno[a] = wa_nrec[a] + 1
      wa_ipos[a] = ix_len[id] + 1
    end
  end
  wa_found[a] = found
  call relsync a
  return found

/* ------------------------------------------------------------- relations */
relsync: procedure = .void
  arg a = .int
  do j = 1 to wa_nrel[a]
    ch = wa_relchild[(a - 1) * 8 + j]
    kn = wa_relkey[(a - 1) * 8 + j]
    if wa_used[ch] = 0 then iterate
    old = curarea
    curarea = a
    v = evalnode(kn)
    curarea = old
    if wa_order[ch] > 0 then junk = dbseek(ch, v, 0)
    else if isnum(v) = 1 then call dbgoto ch, toint(numval(v))
  end
  return

/* ===================================================================== */
/*                 EXECUTION OF DATABASE AND CONSOLE COMMANDS            */
/* ===================================================================== */
sc_a = 0
sc_lim = 0
sc_single = 0
sc_done = 0
sc_for = 0
sc_while = 0
atrow = -1

evstr: procedure = .string
  arg n = .int
  if n = 0 then return ''
  v = evalnode(n)
  if ctl <> 0 then return ''
  if isstr(v) = 0 then return valstr(v)
  return cstr[v]

evint: procedure = .int
  arg n = .int, dflt = .int
  if n = 0 then return dflt
  v = evalnode(n)
  if ctl <> 0 then return dflt
  if isnum(v) = 0 then return dflt
  return toint(numval(v))

needarea: procedure = .int
  if curarea < 1 then return rterr('DBFNTX', 2001, 'Workarea not in use', '')
  if wa_used[curarea] = 0 then return rterr('DBFNTX', 2001, 'Workarea not in use', '')
  return curarea

areaof: procedure = .int
  arg an = .int
  if an = 0 then return needarea()
  a = resolvealias(an)
  if ctl <> 0 then return 0
  if a < 1 | a > 40 then return rterr('BASE', 1002, 'Alias does not exist', '')
  return a

/* USE ... : open a table in a work area */
douse: procedure = .void
  arg s = .int
  fl = nf[s]
  if nb[s] = 0 then do
    if curarea > 0 then call closearea curarea
    return
  end
  f = evstr(nb[s])
  if ctl <> 0 then return
  if fl % 2 = 1 | curarea < 1 then a = findfreearea()
  else a = curarea
  if a = 0 then do
    junk = rterr('DBFNTX', 1001, 'No free work area', f)
    return
  end
  if wa_used[a] = 1 then call closearea a
  al = ''
  if nc[s] > 0 then al = upper(strip(evstr(nc[s])))
  if al == '' then al = dbfstem(f)
  if aliasarea(al) > 0 then do
    junk = rterr('DBFNTX', 1001, 'Alias already in use', al)
    return
  end
  ro = 0
  if (fl / 8) % 2 = 1 then ro = 1
  if openarea(a, f, al, ro) = 0 then return
  curarea = a
  x = nd[s]
  do while x > 0
    junk = openindex(a, evstr(x))
    if ctl <> 0 then return
    x = nx[x]
  end
  return

doclose: procedure = .void
  arg s = .int
  if nf[s] = 1 then do
    call closeallareas
    curarea = 0
    return
  end
  if nf[s] = 2 then do
    if curarea > 0 then do
      wa_nix[curarea] = 0
      wa_order[curarea] = 0
    end
    return
  end
  if nb[s] > 0 then do
    a = areaof(nb[s])
    if ctl = 0 then call closearea a
    return
  end
  if curarea > 0 then call closearea curarea
  return

doselect: procedure = .void
  arg s = .int
  an = nb[s]
  if nt[an] = 1 then do
    v = na[an]
    if isnum(v) = 1 then do
      k = toint(numval(v))
      if k = 0 then k = findfreearea()
      curarea = k
      return
    end
    if isstr(v) = 1 then do
      a = aliasarea(upper(strip(cstr[v])))
      if a = 0 then do
        if upper(strip(cstr[v])) == 'NEW' then curarea = findfreearea()
        else junk = rterr('BASE', 1002, 'Alias does not exist', upper(cstr[v]))
        return
      end
      curarea = a
      return
    end
  end
  v = evalnode(an)
  if ctl <> 0 then return
  if isnum(v) = 1 then do
    k = toint(numval(v))
    if k = 0 then k = findfreearea()
    curarea = k
    return
  end
  if isstr(v) = 1 then do
    a = aliasarea(upper(strip(cstr[v])))
    if a = 0 then junk = rterr('BASE', 1002, 'Alias does not exist', upper(cstr[v]))
    else curarea = a
  end
  return

doindex: procedure = .void
  arg s = .int
  a = needarea()
  if ctl <> 0 then return
  ktxt = ns[s]
  p = pos('01'x, ktxt)
  ftxt = ''
  if p > 0 then do
    ftxt = substr(ktxt, p + 1)
    ktxt = substr(ktxt, 1, p - 1)
  end
  fname = ''
  if nc[s] > 0 then fname = evstr(nc[s])
  if ctl <> 0 then return
  fl = nf[s]
  if setunique = 1 then fl = fl % 2 + (fl / 2) * 2 + (1 - fl % 2)
  junk = createindex(a, nb[s], fname, nd[s], fl, ktxt, ftxt)
  return

doset: procedure = .void
  arg s = .int
  nm = ns[s]
  onoff = nc[s]
  if nm == 'DELETED' then do
    if onoff = 1 then setdeleted = 1
    else setdeleted = 0
    return
  end
  if nm == 'SOFTSEEK' then do
    if onoff = 1 then setsoft = 1
    else setsoft = 0
    return
  end
  if nm == 'EXACT' then do
    if onoff = 1 then setexact = 1
    else setexact = 0
    return
  end
  if nm == 'FIXED' then do
    if onoff = 1 then setfixed = 1
    else setfixed = 0
    return
  end
  if nm == 'CENTURY' then do
    if onoff = 1 then setcentury = 1
    else setcentury = 0
    return
  end
  if nm == 'CONSOLE' then do
    if onoff = 1 then setconsole = 1
    else if onoff = 2 then setconsole = 0
    return
  end
  if nm == 'UNIQUE' then do
    if onoff = 1 then setunique = 1
    else setunique = 0
    return
  end
  if nm == 'DECIMALS' then do
    setdec = evint(nb[s], 2)
    return
  end
  if nm == 'EPOCH' then do
    setepoch = evint(nb[s], 1900)
    return
  end
  if nm == 'DATE' then do
    if nb[s] > 0 then call setdate evstr(nb[s])
    return
  end
  if nm == 'DEFAULT' | nm == 'PATH' then do
    if nb[s] > 0 then setdefault = evstr(nb[s])
    return
  end
  if nm == 'FILTER' then do
    a = needarea()
    if ctl <> 0 then return
    wa_filter[a] = nb[s]
    call dbgotop a
    return
  end
  if nm == 'ORDER' then do
    a = needarea()
    if ctl <> 0 then return
    n = evint(nb[s], 0)
    if n < 0 | n > wa_nix[a] then n = 0
    if n = 0 then wa_order[a] = 0
    else wa_order[a] = waix[(a - 1) * 8 + n]
    call dbgotop a
    return
  end
  if nm == 'INDEX' then do
    a = needarea()
    if ctl <> 0 then return
    wa_nix[a] = 0
    wa_order[a] = 0
    x = nd[s]
    do while x > 0
      junk = openindex(a, evstr(x))
      if ctl <> 0 then return
      x = nx[x]
    end
    if wa_nix[a] > 0 then call dbgotop a
    return
  end
  if nm == 'RELATION' then do
    a = needarea()
    if ctl <> 0 then return
    wa_nrel[a] = 0
    k = nd[s]
    do while k > 0
      al = nx[k]
      ch = resolvealias(al)
      if ctl <> 0 then return
      wa_nrel[a] = wa_nrel[a] + 1
      wa_relchild[(a - 1) * 8 + wa_nrel[a]] = ch
      wa_relkey[(a - 1) * 8 + wa_nrel[a]] = k
      k = nx[al]
    end
    call relsync a
    return
  end
  return

doclear: procedure = .void
  arg s = .int
  if nf[s] = 2 | nf[s] = 3 then do
    do i = 1 to nsym
      smvd[i] = 0
      smv[i] = 0
    end
  end
  if nf[s] = 3 then call closeallareas
  return

dorelease: procedure = .void
  arg s = .int
  if nf[s] = 1 then do
    do i = 1 to nsym
      smvd[i] = 0
      smv[i] = 0
    end
    return
  end
  x = nb[s]
  do while x > 0
    if nt[x] = 36 | nt[x] = 5 then do
      sym = na[x]
      smvd[sym] = 0
      smv[sym] = 0
    end
    x = nx[x]
  end
  return

dostore: procedure = .void
  arg s = .int
  v = evalnode(nb[s])
  if ctl <> 0 then return
  x = nc[s]
  do while x > 0
    call assignnew x, cloneval(v)
    if ctl <> 0 then return
    x = nx[x]
  end
  return

doprompt: procedure = .void
  arg s = .int
  if nb[s] > 0 then do
    txt = evstr(nb[s])
    if ctl <> 0 then return
    call emit txt
  end
  return

doaccept: procedure = .void
  arg s = .int
  call doprompt s
  line = readcon()
  call emitnl
  if nc[s] > 0 then call assignnew nc[s], mkstr(line)
  return

doinput: procedure = .void
  arg s = .int
  call doprompt s
  do forever
    line = strip(readcon())
    call emitnl
    if ineof = 1 then return
    if line == '' then do
      return
    end
    nd2 = compileexpr(line)
    if nd2 = 0 then do
      call emit 'Invalid expression, re-enter: '
      iterate
    end
    v = evalnode(nd2)
    if ctl <> 0 then return
    if nc[s] > 0 then call assignnew nc[s], v
    return
  end
  return

dowait: procedure = .void
  arg s = .int
  if nb[s] > 0 then call doprompt s
  else call emit 'Press any key to continue...'
  c = readkey()
  txt = ''
  if c > 0 & c <> 13 then txt = d2c(c)
  if c = 13 then do
    /* a line end counts as the key */
    txt = ''
  end
  if nc[s] > 0 then call assignnew nc[s], mkstr(txt)
  call emitnl
  return

execcmd: procedure = .void
  arg s = .int
  cmd = na[s]
  if cmd = 2 then call douse s
  else if cmd = 3 then call doselect s
  else if cmd = 4 then do
    a = areaof(nc[s])
    if ctl <> 0 then return
    if nf[s] = 1 then call dbgotop a
    else if nf[s] = 2 then call dbgobottom a
    else call dbgoto a, evint(nb[s], 0)
  end
  else if cmd = 5 then do
    a = areaof(nc[s])
    if ctl <> 0 then return
    call dbskip a, evint(nb[s], 1)
  end
  else if cmd = 13 then do
    a = needarea()
    if ctl <> 0 then return
    v = evalnode(nb[s])
    if ctl <> 0 then return
    junk = dbseek(a, v, nf[s])
  end
  else if cmd = 6 then do
    a = needarea()
    if ctl <> 0 then return
    if nf[s] = 2 then call doappendfrom s
    else call dbappend a
  end
  else if cmd = 15 then call docontinue
  else if cmd = 9 then do
    a = needarea()
    if ctl = 0 then call dbpack a
  end
  else if cmd = 10 then do
    a = needarea()
    if ctl = 0 then call dbzap a
  end
  else if cmd = 22 then do
    do a = 1 to 40
      if wa_used[a] = 1 then do
        call flushdbf a
        call flushindexes a
      end
    end
  end
  else if cmd = 36 then do
    a = needarea()
    if ctl = 0 then call reindexall a
  end
  else if cmd = 12 then call doindex s
  else if cmd = 21 then call doclose s
  else if cmd = 1 then call doset s
  else if cmd = 25 then call doclear s
  else if cmd = 23 then do
    f = evstr(nb[s])
    if ctl = 0 & fileexists(f) = 1 then junk = eraseFile(f)
  end
  else if cmd = 24 then do
    f = evstr(nb[s])
    g = evstr(nc[s])
    if ctl = 0 & fileexists(f) = 1 then do
      junk = putbytes(g, bytesof(f))
      junk = eraseFile(f)
    end
  end
  else if cmd = 26 then call doaccept s
  else if cmd = 27 then call doinput s
  else if cmd = 28 then call dowait s
  else if cmd = 29 then call doread
  else if cmd = 30 then call doquit 0
  else if cmd = 31 then call dorelease s
  else if cmd = 32 then call dostore s
  else if cmd = 39 then do
    t = evstr(nb[s])
    if inhave = 1 then inbuf = t || inbuf
    else do
      inbuf = t
      inhave = 1
    end
  end
  return

/* ------------------------------------------------------- scoped commands */
scbegin: procedure = .void
  arg s = .int, defall = .int
  a = needarea()
  sc_a = a
  sc_lim = -1
  sc_single = 0
  sc_done = 0
  sc_for = nb[s]
  sc_while = nc[s]
  if ctl <> 0 then do
    sc_done = 1
    return
  end
  k = nf[s]
  if k = 0 & sc_for > 0 then k = 1
  if k = 0 & defall = 1 then k = 1
  if k = 0 then sc_single = 1
  else if k = 1 then call dbgotop a
  else if k = 2 then sc_lim = evint(nd[s], 0)
  else if k = 3 then do
    call dbgoto a, evint(nd[s], 0)
    sc_single = 1
  end
  return

scskip: procedure = .void
  if sc_single = 1 then do
    sc_done = 1
    return
  end
  if sc_lim > 0 then sc_lim = sc_lim - 1
  call dbskip sc_a, 1
  return

scnext: procedure = .int
  do forever
    if sc_done = 1 then return 0
    if wa_eof[sc_a] = 1 then return 0
    if sc_lim = 0 then return 0
    if sc_while > 0 then do
      if condval(sc_while) = 0 then return 0
      if ctl <> 0 then return 0
    end
    if sc_for > 0 then do
      if condval(sc_for) = 0 then do
        if ctl <> 0 then return 0
        call scskip
        iterate
      end
    end
    return 1
  end
  return 0

execscoped: procedure = .void
  arg s = .int
  cmd = na[s]
  hold = ne[s]
  if cmd = 19 | cmd = 20 then do
    if nf[hold] = 1 then do
      call dostructure
      return
    end
    call dolist s, hold
    return
  end
  if cmd = 14 then do
    call scbegin s, 1
    a = sc_a
    if ctl <> 0 then return
    wa_locfor[a] = nb[s]
    wa_locwhile[a] = nc[s]
    wa_found[a] = 0
    do while scnext() = 1
      wa_found[a] = 1
      return
    end
    wa_found[a] = 0
    return
  end
  if cmd = 34 then do
    call docopy s, hold
    return
  end
  if cmd = 41 then do
    junk = rterr('BASE', 1001, 'Command TOTAL is not supported', '')
    return
  end
  if cmd = 7 | cmd = 8 | cmd = 11 | cmd = 16 | cmd = 17 | cmd = 18 then do
    defall = 0
    if cmd = 16 | cmd = 17 | cmd = 18 then defall = 1
    call scbegin s, defall
    if ctl <> 0 then return
    a = sc_a
    cnt = 0
    nsum = 0
    sums = .float[]
    decs = .int[]
    if cmd = 17 | cmd = 18 then do
      nsum = nc[hold]
      do i = 1 to nsum + 1
        sums[i] = 0.0
        decs[i] = 0
      end
    end
    do while scnext() = 1
      cnt = cnt + 1
      if cmd = 7 then call dbdelete a, 1
      else if cmd = 8 then call dbdelete a, 0
      else if cmd = 11 then do
        f = na[hold]
        do while f > 0
          v = nx[f]
          nxt = nx[v]
          val = evalnode(v)
          if ctl <> 0 then return
          call assignto f, val
          if ctl <> 0 then return
          f = nxt
        end
      end
      else if cmd = 17 | cmd = 18 then do
        e = na[hold]
        i = 0
        do while e > 0
          i = i + 1
          val = evalnode(e)
          if ctl <> 0 then return
          if isnum(val) = 1 then do
            sums[i] = sums[i] + numval(val)
            if val > 2 then do
              dd = cint[val] % 256
              if dd > decs[i] then decs[i] = dd
            end
          end
          e = nx[e]
        end
      end
      call scskip
    end
    if cmd = 16 then do
      if na[hold] > 0 then call assignnew na[hold], mkint(cnt)
    end
    if cmd = 17 | cmd = 18 then do
      t = nb[hold]
      i = 0
      do while t > 0
        i = i + 1
        x = sums[i]
        if cmd = 18 & cnt > 0 then x = x / cnt
        d = decs[i]
        if cmd = 18 & d < setdec then d = setdec
        call assignnew t, mknum(x, 15 + d, d)
        t = nx[t]
      end
    end
    return
  end
  return

docontinue: procedure = .void
  a = needarea()
  if ctl <> 0 then return
  fnode = wa_locfor[a]
  if fnode = 0 & wa_locwhile[a] = 0 then do
    junk = rterr('DBFNTX', 1004, 'CONTINUE without LOCATE', '')
    return
  end
  sc_a = a
  sc_lim = -1
  sc_single = 0
  sc_done = 0
  sc_for = fnode
  sc_while = wa_locwhile[a]
  call dbskip a, 1
  if scnext() = 1 then wa_found[a] = 1
  else wa_found[a] = 0
  return

dolist: procedure = .void
  arg s = .int, hold = .int
  call scbegin s, 1
  if ctl <> 0 then return
  if nf[s] = 0 & nb[s] = 0 & na[s] = 20 then sc_single = 1
  a = sc_a
  if na[s] = 20 & nf[s] = 0 & nb[s] = 0 then sc_single = 1
  off = nd[hold]
  do while scnext() = 1
    line = ''
    if off = 0 then line = padleft(wa_recno[a] || '', 7) || ' '
    if isdeleted(a) = 1 then line = line || '*'
    e = na[hold]
    if e = 0 then do
      do f = 1 to wa_nfld[a]
        if f > 1 then line = line || ' '
        line = line || valstr(fieldval(a, f))
      end
    end
    else do
      first = 1
      do while e > 0
        v = evalnode(e)
        if ctl <> 0 then return
        if first = 0 then line = line || ' '
        line = line || valstr(v)
        first = 0
        e = nx[e]
      end
    end
    if outstarted = 1 then call emitnl
    call emit line
    call scskip
  end
  return

dostructure: procedure = .void
  a = needarea()
  if ctl <> 0 then return
  if outstarted = 1 then call emitnl
  call emit 'Structure for database: ' || wa_file[a]
  call emitnl
  call emit 'Number of data records: ' || padleft(wa_nrec[a] || '', 7)
  call emitnl
  call emit 'Field  Field Name  Type       Width    Dec'
  total = 1
  base = (a - 1) * 256
  do f = 1 to wa_nfld[a]
    tn = 'Character'
    t = ftyp[base + f]
    if t == 'N' then tn = 'Numeric'
    if t == 'F' then tn = 'Float'
    if t == 'D' then tn = 'Date'
    if t == 'L' then tn = 'Logical'
    if t == 'M' then tn = 'Memo'
    dd = ''
    if t == 'N' | t == 'F' then dd = padleft(fdec[base + f] || '', 3)
    call emitnl
    call emit padleft(f || '', 5) || '  ' || left(fnam[base + f], 10) || '  ' || left(tn, 9) || padleft(flen[base + f] || '', 7) || '    ' || dd
    total = total + flen[base + f]
  end
  call emitnl
  call emit '** Total **' || padleft(total || '', 21)
  return

docopy: procedure = .void
  arg s = .int, hold = .int
  a = needarea()
  if ctl <> 0 then return
  f = evstr(nb[hold])
  if ctl <> 0 then return
  base = (a - 1) * 256
  stru = mkarray(0)
  do i = 1 to wa_nfld[a]
    e = mkarray(0)
    call arrpush e, mkstr(fnam[base + i])
    call arrpush e, mkstr(ftyp[base + i])
    call arrpush e, mkint(flen[base + i])
    call arrpush e, mkint(fdec[base + i])
    call arrpush stru, e
  end
  junk = createdbf(f, stru)
  if nf[hold] = 1 then return
  t = findfreearea()
  if t = 0 then return
  al = '$COPY' || t
  if openarea(t, f, al, 0) = 0 then return
  call scbegin s, 1
  do while scnext() = 1
    n = wa_nrec[t] + 1
    recs[ridx(t, n)] = recs[ridx(a, wa_recno[a])]
    wa_nrec[t] = n
    call scskip
  end
  wa_dirty[t] = 1
  call closearea t
  return

doappendfrom: procedure = .void
  arg s = .int
  a = needarea()
  f = evstr(nb[s])
  if ctl <> 0 then return
  t = findfreearea()
  if t = 0 then return
  if openarea(t, f, '$APPEND' || t, 1) = 0 then return
  basea = (a - 1) * 256
  baset = (t - 1) * 256
  do r = 1 to wa_nrec[t]
    wa_recno[t] = r
    wa_eof[t] = 0
    ok = 1
    if nd[s] > 0 then do
      old = curarea
      curarea = t
      ok = condval(nd[s])
      curarea = old
    end
    if ok = 1 then do
      call dbappend a
      do i = 1 to wa_nfld[a]
        j = fieldfind(t, fsym[basea + i])
        if j > 0 then do
          if ftyp[baset + j] == ftyp[basea + i] then call fieldput a, i, fieldval(t, j)
        end
      end
    end
  end
  call closearea t
  return

/* ---------------------------------------------------------- @ SAY / GET */
atpos: procedure = .void
  arg r = .int, c = .int
  if outstarted = 1 then do
    if r <> atrow | c < outcol then do
      if outcol > 0 then call emitnl
    end
  end
  if c > outcol then call emit copies(' ', c - outcol)
  atrow = r
  return

execsayget: procedure = .void
  arg s = .int
  hold = nf[s]
  r = evint(na[s], 0)
  c = evint(nb[s], 0)
  if ctl <> 0 then return
  call atpos r, c
  if nc[s] > 0 then do
    v = evalnode(nc[s])
    if ctl <> 0 then return
    txt = valstr(v)
    if na[hold] > 0 then txt = xtransform(v, evstr(na[hold]))
    call emit txt
  end
  if nd[s] > 0 then do
    ngets = ngets + 1
    gt_node[ngets] = nd[s]
    gt_pic[ngets] = nb[hold]
    gt_valid[ngets] = nc[hold]
    gt_when[ngets] = nd[hold]
    v = evalnode(nd[s])
    if ctl <> 0 then return
    txt = valstr(v)
    if nb[hold] > 0 then txt = xtransform(v, evstr(nb[hold]))
    call emit '[' || txt || ']'
  end
  return

/* READ: one input line per pending GET; an empty line keeps the value */
doread: procedure = .void
  do g = 1 to ngets
    nd2 = gt_node[g]
    if gt_when[g] > 0 then do
      if condval(gt_when[g]) = 0 then iterate
    end
    old = evalnode(nd2)
    if ctl <> 0 then return
    do forever
      line = readcon()
      if ineof = 1 then leave
      if gt_pic[g] > 0 then do
        if pos('!', evstr(gt_pic[g])) > 0 then line = upper(line)
      end
      nv = old
      if line <> '' | isstr(old) = 1 then do
        if isstr(old) = 1 then do
          if line == '' then nv = old
          else do
            w = length(cstr[old])
            if length(line) >= w then nv = mkstr(left(line, w))
            else nv = mkstr(line || copies(' ', w - length(line)))
          end
        end
        else if isnum(old) = 1 then nv = valnum(line)
        else if isdate(old) = 1 then nv = mkdate(parsedate(strip(line), setdatefmt))
        else if islog(old) = 1 then do
          u = upper(left(strip(line), 1))
          if u == 'Y' | u == 'T' then nv = 2
          else nv = 1
        end
      end
      if isnum(old) = 1 & isnum(nv) = 1 & old > 2 then do
        /* keep the width and decimals of the original */
        nv = mknum(numval(nv), cint[old] / 256, cint[old] % 256)
      end
      call assignto nd2, nv
      if ctl <> 0 then return
      if gt_valid[g] > 0 then do
        if condval(gt_valid[g]) = 0 then do
          call emitnl
          call emit 'Invalid entry, re-enter: '
          iterate
        end
      end
      leave
    end
    call emitnl
  end
  ngets = 0
  return

/* a work area given as number or alias value */
areaarg: procedure = .int
  arg v = .int
  if isnum(v) = 1 then return toint(numval(v))
  if isstr(v) = 1 then return aliasarea(upper(strip(cstr[v])))
  return 0

/* assignment target of STORE, COUNT TO, ACCEPT TO ...: a new variable becomes PRIVATE */
assignnew: procedure = .void
  arg n = .int, val = .int
  if nt[n] = 5 | nt[n] = 36 then do
    sym = na[n]
    if smvd[sym] = 0 then do
      isfld = 0
      if curarea > 0 then do
        if fieldfind(curarea, sym) > 0 then isfld = 1
      end
      if isfld = 0 then do
        call pushprivate sym
        smv[sym] = val
        smvd[sym] = 1
        return
      end
    end
  end
  call assignto n, val
  return

/* ===================================================================== */
/*                         START UP AND SHUT DOWN                        */
/* ===================================================================== */
initall: procedure = .void
  do i = 1 to 2048
    sbk[i] = 0
  end
  do i = 1 to 4100
    pmb[i] = 0
  end
  junk = intern('NIL')
  call initerrclass
  call initprims
  call initareas
  call definemacro '__HARBOUR__', '', '1'
  call definemacro '__XBASE__', '', '1'
  call definemacro '__PLATFORM__', '', '"LINUX"'
  call definemacro 'HB_VERSION', '', '"3.2.0"'
  return

runprogram: procedure = .void
  /* static initialisers */
  do i = 1 to nsvinit
    v = evalnode(svinit[i])
    sv[svslot[i]] = v
    if ctl <> 0 then leave
  end
  ctl = 0
  fn = mainfn
  if fn = 0 then fn = firstfn
  if fn = 0 then do
    call errout 'Error: no entry point'
    exitcode = 1
    return
  end
  do i = 1 to ninit
    call runfn initfns[i], 0
  end
  call runfn fn, 1
  if ctl = 4 then ctl = 0
  do i = 1 to nexitp
    call runfn exitfns[i], 0
  end
  return

runfn: procedure = .void
  arg f = .int, withargs = .int
  base = ftop
  cnt = 0
  if withargs = 1 then cnt = nargvs
  slots = fnslots[f]
  if cnt > slots then slots = cnt
  ftop = base + slots
  do i = 1 to slots
    fv[base + i] = 0
  end
  if withargs = 1 then do
    do i = 1 to nargvs
      fv[base + i] = mkstr(argvs[i])
    end
  end
  junk = invoke(f, base, cnt, 0, 0)
  return

doquit: procedure = .void
  arg code = .int
  exitcode = code
  do i = 1 to nexitp
    call runfn exitfns[i], 0
  end
  call shutdown
  exit code

shutdown: procedure = .void
  call closeallareas
  call flushout
  if outcol > 0 then do
    call charout 'stdout', '0a'x
    outcol = 0
  end
  return

/* ===================================================================== */
/*                       BUILTIN FUNCTIONS                               */
/* ===================================================================== */
/* LEN */
pf1: procedure = .int
  arg base = .int, n = .int
  v = fv[base + 1]
  if isstr(v) = 1 then return mkint(length(cstr[v]))
  if isarr(v) = 1 then return mkint(arrlen(v))
  if ishash(v) = 1 then return mkint(hashlen(v))
  return argerr('LEN')
  return 0

/* EMPTY */
pf2: procedure = .int
  arg base = .int, n = .int
  v = fv[base + 1]
  if v = 0 then return 2
  if v < 0 then do
    if v = mkint(0) then return 2
    return 1
  end
  if v = 1 then return 2
  if v = 2 then return 1
  t = ctag[v]
  if t = 2 then do
    if strip(cstr[v]) == '' then return 2
    return 1
  end
  if t = 1 then do
    if cnum[v] = 0.0 then return 2
    return 1
  end
  if t = 4 then do
    if cint[v] = 0 then return 2
    return 1
  end
  if t = 5 then do
    if arrlen(v) = 0 then return 2
    return 1
  end
  if t = 6 then do
    if hashlen(v) = 0 then return 2
    return 1
  end
  return 1
  return 0

/* VALTYPE */
pf3: procedure = .int
  arg base = .int, n = .int
  return mkstr(typech(fv[base + 1]))
  return 0

/* STR */
pf4: procedure = .int
  arg base = .int, n = .int
  v = fv[base + 1]
  if isnum(v) = 0 then return argerr('STR')
  w = -1
  d = -1
  if n >= 2 then do
    if isnum(fv[base + 2]) = 1 then w = toint(numval(fv[base + 2]))
  end
  if n >= 3 then do
    if isnum(fv[base + 3]) = 1 then d = toint(numval(fv[base + 3]))
  end
  if w >= 0 & d < 0 then d = 0
  return mkstr(numstrw(v, w, d))
  return 0

/* STRZERO */
pf5: procedure = .int
  arg base = .int, n = .int
  v = fv[base + 1]
  if isnum(v) = 0 then return argerr('STRZERO')
  w = 10
  d = 0
  if n >= 2 then w = iarg(fv[base + 2], 10)
  if n >= 3 then d = iarg(fv[base + 3], 0)
  s = numstrw(v, w, d)
  neg = 0
  if left(strip(s), 1) = '-' then do
    neg = 1
    s = substr(strip(s), 2)
  end
  s = strip(s)
  do while length(s) < w - neg
    s = '0' || s
  end
  if neg = 1 then s = '-' || s
  return mkstr(s)
  return 0

/* VAL */
pf6: procedure = .int
  arg base = .int, n = .int
  v = fv[base + 1]
  if isstr(v) = 0 then return argerr('VAL')
  return valnum(cstr[v])
  return 0

/* ALLTRIM */
pf7: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('ALLTRIM')
  return mkstr(strip(cstr[fv[base + 1]]))
  return 0

/* RTRIM TRIM */
pf8: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('RTRIM')
  return mkstr(strip(cstr[fv[base + 1]], 'T'))
  return 0

/* LTRIM */
pf9: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('LTRIM')
  return mkstr(strip(cstr[fv[base + 1]], 'L'))
  return 0

/* LEFT */
pf10: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('LEFT')
  k = toint(numval(fv[base + 2]))
  if k <= 0 then return mkstr('')
  return mkstr(left(cstr[fv[base + 1]], k))
  return 0

/* RIGHT */
pf11: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('RIGHT')
  k = toint(numval(fv[base + 2]))
  if k <= 0 then return mkstr('')
  s = cstr[fv[base + 1]]
  if k >= length(s) then return fv[base + 1]
  return mkstr(right(s, k))
  return 0

/* SUBSTR */
pf12: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('SUBSTR')
  ln = -1
  if n >= 3 then do
    if isnum(fv[base + 3]) = 0 then return argerr('SUBSTR')
    ln = toint(numval(fv[base + 3]))
  end
  return mkstr(xsubstr(cstr[fv[base + 1]], toint(numval(fv[base + 2])), ln))
  return 0

/* UPPER */
pf13: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('UPPER')
  return mkstr(upper(cstr[fv[base + 1]]))
  return 0

/* LOWER */
pf14: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('LOWER')
  return mkstr(lower(cstr[fv[base + 1]]))
  return 0

/* SPACE */
pf15: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('SPACE')
  return mkstr(xaspace(toint(numval(fv[base + 1]))))
  return 0

/* REPLICATE REPL */
pf16: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('REPLICATE')
  k = toint(numval(fv[base + 2]))
  if k <= 0 then return mkstr('')
  return mkstr(copies(cstr[fv[base + 1]], k))
  return 0

/* PADR */
pf17: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 2]) = 0 then return argerr('PADR')
  s = ''
  if isstr(fv[base + 1]) = 1 then s = cstr[fv[base + 1]]
  else if isnum(fv[base + 1]) = 1 then s = strip(numstr(fv[base + 1]))
  else if isdate(fv[base + 1]) = 1 then s = datestr(cint[fv[base + 1]])
  else return argerr('PADR')
  k = toint(numval(fv[base + 2]))
  f = ' '
  if n >= 3 then do
    if isstr(fv[base + 3]) = 1 then f = left(cstr[fv[base + 3]] || ' ', 1)
  end
  if k <= 0 then return mkstr('')
  if length(s) >= k then return mkstr(left(s, k))
  return mkstr(s || copies(f, k - length(s)))
  return 0

/* PADL */
pf18: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 2]) = 0 then return argerr('PADL')
  s = ''
  if isstr(fv[base + 1]) = 1 then s = cstr[fv[base + 1]]
  else if isnum(fv[base + 1]) = 1 then s = strip(numstr(fv[base + 1]))
  else if isdate(fv[base + 1]) = 1 then s = datestr(cint[fv[base + 1]])
  else return argerr('PADL')
  k = toint(numval(fv[base + 2]))
  f = ' '
  if n >= 3 then do
    if isstr(fv[base + 3]) = 1 then f = left(cstr[fv[base + 3]] || ' ', 1)
  end
  if k <= 0 then return mkstr('')
  if length(s) >= k then return mkstr(left(s, k))
  return mkstr(copies(f, k - length(s)) || s)
  return 0

/* PADC */
pf19: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 2]) = 0 then return argerr('PADC')
  s = ''
  if isstr(fv[base + 1]) = 1 then s = cstr[fv[base + 1]]
  else if isnum(fv[base + 1]) = 1 then s = strip(numstr(fv[base + 1]))
  else if isdate(fv[base + 1]) = 1 then s = datestr(cint[fv[base + 1]])
  else return argerr('PADC')
  k = toint(numval(fv[base + 2]))
  f = ' '
  if n >= 3 then do
    if isstr(fv[base + 3]) = 1 then f = left(cstr[fv[base + 3]] || ' ', 1)
  end
  if k <= 0 then return mkstr('')
  if length(s) >= k then return mkstr(left(s, k))
  tot = k - length(s)
  lft = tot / 2
  return mkstr(copies(f, lft) || s || copies(f, tot - lft))
  return 0

/* AT HB_AT */
pf20: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isstr(fv[base + 2]) = 0 then return argerr('AT')
  st = 1
  en = 0
  if n >= 3 then st = iarg(fv[base + 3], 1)
  if n >= 4 then en = iarg(fv[base + 4], 0)
  return mkint(xat(cstr[fv[base + 1]], cstr[fv[base + 2]], st, en))
  return 0

/* RAT */
pf21: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isstr(fv[base + 2]) = 0 then return argerr('RAT')
  return mkint(xrat(cstr[fv[base + 1]], cstr[fv[base + 2]]))
  return 0

/* STRTRAN */
pf22: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isstr(fv[base + 2]) = 0 then return argerr('STRTRAN')
  s = cstr[fv[base + 1]]
  f = cstr[fv[base + 2]]
  r = ''
  if n >= 3 then do
    if isstr(fv[base + 3]) = 1 then r = cstr[fv[base + 3]]
  end
  st = 1
  mx = 0
  if n >= 4 then st = iarg(fv[base + 4], 1)
  if n >= 5 then mx = iarg(fv[base + 5], 0)
  if f == '' then return fv[base + 1]
  out = ''
  rest = s
  cnt = 0
  occ = 0
  do forever
    p = pos(f, rest)
    if p = 0 then leave
    occ = occ + 1
    if occ < st then do
      out = out || substr(rest, 1, p + length(f) - 1)
      rest = substr(rest, p + length(f))
      iterate
    end
    if mx > 0 & cnt >= mx then leave
    out = out || substr(rest, 1, p - 1) || r
    rest = substr(rest, p + length(f))
    cnt = cnt + 1
  end
  return mkstr(out || rest)
  return 0

/* STUFF */
pf23: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 | isnum(fv[base + 3]) = 0 | isstr(fv[base + 4]) = 0 then return argerr('STUFF')
  s = cstr[fv[base + 1]]
  st = toint(numval(fv[base + 2]))
  dl = toint(numval(fv[base + 3]))
  if st < 1 then st = 1
  if st > length(s) + 1 then st = length(s) + 1
  return mkstr(substr(s, 1, st - 1) || cstr[fv[base + 4]] || substr(s, st + dl))
  return 0

/* CHR */
pf24: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('CHR')
  k = toint(numval(fv[base + 1]))
  if k < 0 then k = k + 256
  return mkstr(d2c(k % 256))
  return 0

/* ASC */
pf25: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return argerr('ASC')
  if cstr[fv[base + 1]] == '' then return mkint(0)
  return mkint(c2d(left(cstr[fv[base + 1]], 1)))
  return 0

/* ABS */
pf26: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('ABS')
  if fv[base + 1] < 0 then return mkint(abs(intval(fv[base + 1])))
  c = newcell(1)
  x = cnum[fv[base + 1]]
  if x < 0.0 then x = 0.0 - x
  cnum[c] = x
  cint[c] = cint[fv[base + 1]]
  return c
  return 0

/* INT */
pf27: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('INT')
  if fv[base + 1] < 0 then return fv[base + 1]
  x = cnum[fv[base + 1]]
  if x < 9.0e15 & x > -9.0e15 then return mkint(toint(x))
  return mknum(x, 20, 0)
  return 0

/* ROUND */
pf28: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('ROUND')
  d = toint(numval(fv[base + 2]))
  if d < 0 then do
    f = fpow(10.0, 0.0 - d)
    x = numval(fv[base + 1]) / f
    s = fmtfloat(x, 0)
    return mknum((s as .float) * f, 10, 0)
  end
  if fv[base + 1] < 0 then return fv[base + 1]
  s = fmtfloat(cnum[fv[base + 1]], d)
  return mknum(s as .float, numwid(fv[base + 1]), d)
  return 0

/* SQRT */
pf29: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('SQRT')
  return mknum(lsqrt(numval(fv[base + 1])), 10, setdec)
  return 0

/* EXP */
pf30: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('EXP')
  return mknum(lexp(numval(fv[base + 1])), 10, setdec)
  return 0

/* LOG */
pf31: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('LOG')
  if numval(fv[base + 1]) <= 0.0 then return mknum(0.0, 10, setdec)
  return mknum(lln(numval(fv[base + 1])), 10, setdec)
  return 0

/* SIN */
pf32: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('SIN')
  return mknum(lsin(numval(fv[base + 1])), 10, setdec)
  return 0

/* COS */
pf33: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 then return argerr('COS')
  return mknum(lcos(numval(fv[base + 1])), 10, setdec)
  return 0

/* MAX */
pf34: procedure = .int
  arg base = .int, n = .int
  a = fv[base + 1]
  b = fv[base + 2]
  r = cmpv(a, b)
  if r = 2 then return argerr('MAX')
  if r >= 0 then return a
  return b
  return 0

/* MIN */
pf35: procedure = .int
  arg base = .int, n = .int
  a = fv[base + 1]
  b = fv[base + 2]
  r = cmpv(a, b)
  if r = 2 then return argerr('MIN')
  if r <= 0 then return a
  return b
  return 0

/* MOD */
pf36: procedure = .int
  arg base = .int, n = .int
  if isnum(fv[base + 1]) = 0 | isnum(fv[base + 2]) = 0 then return argerr('MOD')
  y = numval(fv[base + 2])
  if y = 0.0 then return rterr('BASE', 1341, 'Zero divisor', 'MOD')
  x = numval(fv[base + 1])
  q = toint(x / y)
  if (x / y) < 0.0 & q * 1.0 <> x / y then q = q - 1
  r = x - (q * 1.0) * y
  d = numdec(fv[base + 1])
  if numdec(fv[base + 2]) > d then d = numdec(fv[base + 2])
  return mknum(r, 10, d)
  return 0

/* PCOUNT */
pf37: procedure = .int
  arg base = .int, n = .int
  return mkint(fpc)
  return 0

