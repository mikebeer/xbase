/* SELECT */
pf172: procedure = .int
  arg base = .int, n = .int
  if n = 0 then return mkint(curarea)
  if isstr(fv[base + 1]) = 1 then do
    u = upper(strip(cstr[fv[base + 1]]))
    if u == '' then return mkint(curarea)
    return mkint(aliasarea(u))
  end
  return mkint(iarg(fv[base + 1], 0))
  return 0

/* DBSELECTAREA */
pf173: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 1 then do
    a = aliasarea(upper(strip(cstr[fv[base + 1]])))
    if a = 0 then return rterr('BASE', 1002, 'Alias does not exist', cstr[fv[base + 1]])
    curarea = a
  end
  else do
    k = iarg(fv[base + 1], 0)
    if k = 0 then k = findfreearea()
    curarea = k
  end
  return 0
  return 0

