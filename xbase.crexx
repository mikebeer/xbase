/* FERASE */
pf151: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return mkint(-1)
  if fileexists(cstr[fv[base + 1]]) = 0 then return mkint(-1)
  junk = eraseFile(cstr[fv[base + 1]])
  return mkint(0)
  return 0

/* FRENAME */
pf152: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isstr(fv[base + 2]) = 0 then return mkint(-1)
  if fileexists(cstr[fv[base + 1]]) = 0 then return mkint(-1)
  junk = putbytes(cstr[fv[base + 2]], bytesof(cstr[fv[base + 1]]))
  junk = eraseFile(cstr[fv[base + 1]])
  return mkint(0)
  return 0

/* FILE HB_FILEEXISTS */
pf153: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return 1
  return mklog(fileexists(strip(cstr[fv[base + 1]])))
  return 0

/* MEMOREAD HB_MEMOREAD */
pf154: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 then return mkstr('')
  if fileexists(cstr[fv[base + 1]]) = 0 then return mkstr('')
  t = loadtext(cstr[fv[base + 1]], '0a'x, 'noraise')
  if right(t, 1) = '0a'x then t = substr(t, 1, length(t) - 1)
  return mkstr(t)
  return 0

/* MEMOWRIT HB_MEMOWRIT */
pf155: procedure = .int
  arg base = .int, n = .int
  if isstr(fv[base + 1]) = 0 | isstr(fv[base + 2]) = 0 then return 1
  junk = eraseFile(cstr[fv[base + 1]])
  junk = charout(cstr[fv[base + 1]], cstr[fv[base + 2]])
  junk = charout(cstr[fv[base + 1]])
  return 2
  return 0

/* HB_FREADLINE */
pf156: procedure = .int
  arg base = .int, n = .int
  i = iarg(fv[base + 1], 0) - 2
  if i < 1 | i > nfh then return mkstr('')
  d = fhdata[i]
  p = fhpos[i]
  if p >= length(d) then return mkstr('')
  s = ''
  q = pos('0a'x, d, p + 1)
  if q = 0 then do
    s = substr(d, p + 1)
    fhpos[i] = length(d)
  end
  else do
    s = substr(d, p + 1, q - p - 1)
    fhpos[i] = q
  end
  if right(s, 1) = '0d'x then s = substr(s, 1, length(s) - 1)
  return mkstr(s)
  return 0

