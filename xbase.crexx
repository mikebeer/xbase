pf61: procedure = .int
  arg base = .int, n = .int
  return mkstr(time())
  return 0

/* SECONDS */
pf62: procedure = .int
  arg base = .int, n = .int
  t = time()
  secs = (substr(t, 1, 2) as .int) * 3600 + (substr(t, 4, 2) as .int) * 60 + (substr(t, 7, 2) as .int)
  return mknum(secs * 1.0, 10, 2)
  return 0

/* HB_MILLISECONDS */
pf63: procedure = .int
  arg base = .int, n = .int
  return mkint(time('US') as .int / 1000)
