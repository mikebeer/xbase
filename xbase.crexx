/* HB_DEFAULT */
pf53: procedure = .int
  arg base = .int, n = .int
  r = fv[base + 1]
  if r > 2 then do
    if ctag[r] = 9 then do
      if ca1[r] = 0 then ca1[r] = fv[base + 2]
      return 0
    end
  end
  return 0
  return 0

/* RANDOM HB_RANDOM */
pf54: procedure = .int
  arg base = .int, n = .int
  x = nextrand() / 2147483648.0
  if n >= 1 then do
    if isnum(fv[base + 1]) = 1 then x = x * numval(fv[base + 1])
  end
  return mknum(x, 10, 8)
  return 0

/* HB_RANDOMINT */
pf55: procedure = .int
  arg base = .int, n = .int
  r = nextrand()
  if n = 0 then return mkint(r)
  if n = 1 then do
    m = iarg(fv[base + 1], 1)
    if m < 1 then m = 1
    return mkint(r % m)
  end
  lo = iarg(fv[base + 1], 0)
  hi = iarg(fv[base + 2], 1)
  if hi < lo then hi = lo
  return mkint(lo + r % (hi - lo + 1))
  return 0

/* HB_BITAND */
pf56: procedure = .int
  arg base = .int, n = .int
  return mkint(bitop(1, iarg(fv[base + 1], 0), iarg(fv[base + 2], 0)))
  return 0

/* HB_BITOR */
pf57: procedure = .int
  arg base = .int, n = .int
  return mkint(bitop(2, iarg(fv[base + 1], 0), iarg(fv[base + 2], 0)))
  return 0

/* HB_BITXOR */
pf58: procedure = .int
  arg base = .int, n = .int
  return mkint(bitop(3, iarg(fv[base + 1], 0), iarg(fv[base + 2], 0)))
  return 0

/* HB_BITSHIFT */
pf59: procedure = .int
  arg base = .int, n = .int
  k = iarg(fv[base + 2], 0)
  v = iarg(fv[base + 1], 0)
  if k >= 0 then do
    do k
      v = v * 2
    end
  end
  else do
    do 0 - k
      v = v / 2
    end
  end
  return mkint(v)
  return 0

/* DATE */
pf60: procedure = .int
  arg base = .int, n = .int
  d = date('S')
  return mkdate(ymd2jdn(substr(d, 1, 4) as .int, substr(d, 5, 2) as .int, substr(d, 7, 2) as .int))
  return 0

